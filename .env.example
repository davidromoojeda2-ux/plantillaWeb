# ==============================================================================
# Variables de Configuración para Despliegue en VPS (Producción)
# Copia este archivo a .env en el servidor: cp .env.example .env
# ==============================================================================

# Imagen Docker generada por GitHub Actions
DOCKER_IMAGE=ghcr.io/davidromoojeda2-ux/plantillaweb:latest

# Puerto en el host donde escuchará la app (para reenviar con Nginx del VPS)
HOST_PORT=5000

# Credenciales de MongoDB
MONGO_USER=admin_portal
MONGO_PASS=GeneraUnaContraseñaSegura123!
MONGO_DB=portal_noticias

# Proveedor de Almacenamiento ("Local" o "CloudflareR2")
STORAGE_PROVIDER=Local

# Opcional: Configuración Cloudflare R2 (si se activa STORAGE_PROVIDER=CloudflareR2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=portal-noticias
R2_PUBLIC_DOMAIN=https://pub-tu-dominio.r2.dev
