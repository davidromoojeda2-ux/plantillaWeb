# ==============================================================================
# Variables de Configuración para Despliegue en VPS (Producción)
# Copia este archivo a .env en el servidor: cp .env.example .env
# ==============================================================================

# Imagen Docker generada por GitHub Actions
DOCKER_IMAGE=ghcr.io/davidromoojeda2-ux/plantillaweb:latest

# Puerto en el host donde escuchará la app (para reenviar con Nginx del VPS)
HOST_PORT=5000

# MongoDB Atlas - Cadena de conexión
# Obtener de: MongoDB Atlas → Database → Connect → Drivers → Copiar URI
# Formato: mongodb+srv://<usuario>:<contraseña>@<cluster>.mongodb.net/<base_de_datos>?retryWrites=true&w=majority
MONGO_CONNECTION_STRING=mongodb+srv://usuario:contraseña@tu-cluster.mongodb.net/portal_noticias?retryWrites=true&w=majority
MONGO_DB=portal_noticias

# Proveedor de Almacenamiento: S3 es prioritario si está disponible; fallback automático a almacenamiento local
STORAGE_PROVIDER=S3

# Opción A: Configuración AWS S3 / MinIO
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_BUCKET_NAME=portal-noticias
S3_SERVICE_URL=
S3_PUBLIC_DOMAIN=

# Opción B: Configuración Cloudflare R2 (API compatible S3)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=portal-noticias
R2_PUBLIC_DOMAIN=https://pub-tu-dominio.r2.dev

