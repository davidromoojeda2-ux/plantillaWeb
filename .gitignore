# ==============================================================================
# .gitignore para Proyecto ASP.NET Core (.NET 10) + Frontend Node/pnpm + Docker
# ==============================================================================

# ─── .NET & Visual Studio ─────────────────────────────────────────────────────
[Bb]in/
[Oo]bj/
**/[Bb]in/
**/[Oo]bj/
[Dd]ebug/
[Rr]elease/
**/[Dd]ebug/
**/[Rr]elease/
[Tt]est[Rr]esults/
**/[Tt]est[Rr]esults/
[Pp]ublish/
**/[Pp]ublish/

# Archivos de usuario y cache de Visual Studio
.vs/
**/.vs/
*.user
*.userosscache
*.suo
*.userprefs
*.pidb
*.sln.docstates
*.pubxml
*.pubxml.user
*.PublishProfiles
*.dmp
*.mdmp

# ─── Node.js & Gestores de Paquetes ───────────────────────────────────────────
node_modules/
**/node_modules/
.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ─── Entorno, Secretos y Credenciales (Seguridad Crítica) ──────────────────────
.env
.env.*
!.env.example

# Configuraciones locales con contraseñas de desarrollo
appsettings.Local.json
appsettings.*.local.json

# Certificados y llaves criptográficas privadas
*.pfx
*.p12
*.pem
*.key
*.crt

# ─── Docker ───────────────────────────────────────────────────────────────────
# Sobrescrituras locales de Docker Compose (no compartir en repo)
docker-compose.override.yml
*.override.yml

# ─── Almacenamiento de Archivos y Subidas de Usuarios ─────────────────────────
**/wwwroot/uploads/*
!**/wwwroot/uploads/.gitkeep

# ─── Editores e IDEs ──────────────────────────────────────────────────────────
# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains (Rider, IntelliJ, etc.)
.idea/
*.sln.iml
_ReSharper*/
*.DotSettings.user

# ─── Sistema Operativo y Temporales ───────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
*.log
*.bak
*.swp
*~
