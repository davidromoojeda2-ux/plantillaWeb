@inherits RealtimeComponentBase
@inject ICommentService CommentService

@{
    var totalPages = Math.Max(1, (int)Math.Ceiling(_items.Count / (double)PageSize));
    var currentPage = Math.Clamp(_page, 1, totalPages);
    var pagedItems = _items.Skip((currentPage - 1) * PageSize).Take(PageSize).ToList();
}

<div class="space-y-6">
    <div class="flex items-center gap-2 border-b border-slate-200 pb-3 overflow-x-auto">
        <button type="button" class="@TabClass("pendiente")" @onclick='() => ChangeStatusAsync("pendiente")'>Pendientes</button>
        <button type="button" class="@TabClass("aprobado")" @onclick='() => ChangeStatusAsync("aprobado")'>Aprobados</button>
        <button type="button" class="@TabClass("rechazado")" @onclick='() => ChangeStatusAsync("rechazado")'>Rechazados</button>
        <button type="button" class="@TabClass("todos")" @onclick='() => ChangeStatusAsync("todos")'>Todos</button>
        <RealtimeStatusBadge Text="En vivo" />
    </div>

    <div class="bg-white rounded-2xl border border-slate-200/80 overflow-hidden">
        @if (!_items.Any())
        {
            <div class="p-12 text-center text-slate-400">
                <p class="font-medium text-slate-600">No hay comentarios en este filtro.</p>
            </div>
        }
        else
        {
            <div class="divide-y divide-slate-100">
                @foreach (var c in pagedItems)
                {
                    <div @key="c.Id" class="p-6 hover:bg-slate-50/50 transition flex flex-col md:flex-row md:items-start justify-between gap-4">
                        <div class="space-y-2 flex-1">
                            <div class="flex items-center gap-3 flex-wrap">
                                <span class="font-bold text-slate-900 text-sm">@c.Name</span>
                                <span class="text-xs text-slate-400 font-mono">@c.CreatedAt.ToString("g")</span>
                                @if (c.Status == "Pendiente")
                                {
                                    <span class="px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-amber-50 text-amber-700 border border-amber-200">Pendiente</span>
                                }
                                else if (c.Status == "Aprobado")
                                {
                                    <span class="px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">Aprobado</span>
                                }
                                else
                                {
                                    <span class="px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-rose-50 text-rose-700 border border-rose-200">Rechazado</span>
                                }
                            </div>

                            <p class="text-sm text-slate-700 bg-slate-50 p-3.5 rounded-xl border border-slate-100 leading-relaxed font-sans">
                                @c.Content
                            </p>
                        </div>

                        <div class="flex items-center gap-2 flex-shrink-0 pt-2 md:pt-0">
                            @if (c.Status != "Aprobado")
                            {
                                <button type="button" @onclick="() => ApproveAsync(c)" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-semibold shadow-xs transition"><Icon Name="check" Class="w-3.5 h-3.5" /> Aprobar</button>
                            }

                            @if (c.Status != "Rechazado")
                            {
                                <button type="button" @onclick="() => RejectAsync(c)" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-rose-600 hover:bg-rose-700 text-white text-xs font-semibold shadow-xs transition"><Icon Name="x" Class="w-3.5 h-3.5" /> Rechazar</button>
                            }

                            <button type="button" @onclick="() => DeleteAsync(c)" class="p-1.5 text-slate-400 hover:text-rose-600 rounded-lg transition" title="Eliminar"><Icon Name="trash" Class="w-4 h-4" /></button>
                        </div>
                    </div>
                }
            </div>

            <AdminPagination CurrentPage="currentPage"
                             TotalPages="totalPages"
                             TotalCount="_items.Count"
                             PageSize="PageSize"
                             ItemLabel="comentarios"
                             AriaLabel="Paginación de comentarios"
                             OnPageChanged="GoToPageAsync" />
        }
    </div>
</div>

@code {
    private const int PageSize = 10;

    [Parameter] public List<CommentResponseDto> InitialItems { get; set; } = [];
    [Parameter] public string InitialStatus { get; set; } = "pendiente";

    private List<CommentResponseDto> _items = [];
    private string _status = "pendiente";
    private int _page = 1;
    private bool _busy;

    protected override void OnInitialized()
    {
        _items = InitialItems;
        _status = InitialStatus;
    }

    protected override bool Accepts(CmsChangeEvent change) =>
        change.Module == CmsModule.Comments;

    protected override async Task OnChangeAsync(CmsChangeEvent change)
    {
        await ReloadAsync();
    }

    private async Task ChangeStatusAsync(string status)
    {
        _status = status;
        _page = 1;
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _items = await CommentService.GetByStatusAsync(_status);
        ClampPage();
        StateHasChanged();
    }

    private async Task ApproveAsync(CommentResponseDto comment)
    {
        if (_busy) return;
        _busy = true;
        try
        {
            await CommentService.ApproveAsync(comment.Id);
            await ReloadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RejectAsync(CommentResponseDto comment)
    {
        if (_busy) return;
        _busy = true;
        try
        {
            await CommentService.RejectAsync(comment.Id);
            await ReloadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DeleteAsync(CommentResponseDto comment)
    {
        if (_busy) return;
        if (!await JS.InvokeAsync<bool>("confirm", "¿Eliminar definitivamente este comentario?")) return;

        _busy = true;
        try
        {
            await CommentService.DeleteAsync(comment.Id);
            await ReloadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private void ClampPage()
    {
        var totalPages = Math.Max(1, (int)Math.Ceiling(_items.Count / (double)PageSize));
        _page = Math.Clamp(_page, 1, totalPages);
    }

    private Task GoToPageAsync(int page)
    {
        _page = page;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private string TabClass(string status) =>
        _status == status
            ? "px-4 py-2 rounded-xl text-xs font-semibold transition bg-[#00296B] text-white shadow-xs whitespace-nowrap"
            : "px-4 py-2 rounded-xl text-xs font-semibold transition bg-white text-slate-600 hover:bg-slate-100 whitespace-nowrap";
}
