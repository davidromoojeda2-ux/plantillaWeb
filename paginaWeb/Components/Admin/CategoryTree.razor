@inherits RealtimeComponentBase
@inject ICategoryService CategoryService
@inject IMenuService MenuService

@{
    var parentIds = _parents.Select(p => p.Id).ToHashSet();
    var orphanSubs = _subs.Where(s => !string.IsNullOrEmpty(s.ParentId) && !parentIds.Contains(s.ParentId)).ToList();
}

<div class="bg-white rounded-2xl border border-slate-200/80 overflow-hidden">
    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="px-6 py-3 text-sm font-semibold bg-amber-50 text-amber-900 border-b border-amber-200">@_message</div>
    }
    <div class="p-6 border-b border-slate-100 flex flex-wrap items-center justify-between gap-4">
        <div>
            <h3 class="font-bold text-slate-800 text-base">Estructura Jerárquica del Portal y Menú</h3>
            <p class="text-xs text-slate-500 mt-0.5">Gestiona las categorías principales y sus respectivas subcategorías. Los cambios se sincronizan en vivo en la barra de navegación.</p>
        </div>
        <div class="flex items-center gap-2">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-blue-50 text-[#003F88]">
                @_parents.Count Categorías Principales
            </span>
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-amber-50 text-amber-800">
                @_subs.Count Subcategorías
            </span>
            <RealtimeStatusBadge Text="En vivo" />
        </div>
    </div>

    @if (!_parents.Any() && !_subs.Any())
    {
        <div class="p-12 text-center text-slate-400">
            <p class="font-semibold text-slate-700">No hay categorías configuradas.</p>
            <p class="text-xs text-slate-400 mt-1 mb-4">Comienza creando tu primera categoría principal para estructurar tus noticias.</p>
            <a href="/admin/categorias/nueva" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-[#FDC500] hover:bg-[#FFD500] text-[#00296B] font-bold text-xs shadow-sm transition">
                Crear primera categoría <Icon Name="arrow-right" Class="w-3.5 h-3.5" />
            </a>
        </div>
    }
    else
    {
        <div class="divide-y divide-slate-100">
            @foreach (var parent in _parents)
            {
                var children = _subs.Where(s => s.ParentId == parent.Id).OrderBy(s => s.Order).ToList();

                <div @key="parent.Id" class="p-5 hover:bg-slate-50/50 transition">
                    <div class="flex flex-wrap items-center justify-between gap-4">
                        <div class="flex items-center gap-3">
                            <span class="w-9 h-9 rounded-xl bg-[#00296B]/10 text-[#00296B] font-bold text-xs flex items-center justify-center shrink-0">
                                #@parent.Order
                            </span>
                            <div>
                                <div class="flex items-center gap-2 flex-wrap">
                                    <h4 class="font-bold text-slate-800 text-base">@parent.Name</h4>
                                    <span class="text-xs text-slate-400 font-mono bg-slate-100 px-2 py-0.5 rounded-md">/@parent.Slug</span>
                                    <span class="text-[10px] uppercase font-bold tracking-wider px-2 py-0.5 rounded-full bg-[#00509D]/10 text-[#00509D]">
                                        Categoría Principal
                                    </span>
                                </div>
                                <div class="flex items-center gap-3 text-xs text-slate-500 mt-1 flex-wrap">
                                    <span class="flex items-center gap-1">
                                        <span class="w-1.5 h-1.5 rounded-full @(parent.ShowInMenu ? "bg-emerald-500" : "bg-slate-300")"></span>
                                        @(parent.ShowInMenu ? "Visible en barra de menú" : "Oculto de barra de menú")
                                    </span>
                                    <span>•</span>
                                    <span class="@(parent.IsActive ? "text-emerald-600 font-semibold" : "text-slate-400")">
                                        @(parent.IsActive ? "Activa" : "Inactiva")
                                    </span>
                                    <span>•</span>
                                    <span class="text-slate-500 font-medium">@children.Count subcategoría(s)</span>
                                </div>
                            </div>
                        </div>

                        <div class="flex items-center gap-2">
                            <a href="@($"/admin/categorias/nueva?parentId={parent.Id}")"
                               class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg bg-blue-50 hover:bg-blue-100 text-[#003F88] font-bold text-xs transition"
                               title="Añadir una subcategoría directamente bajo @parent.Name"><Icon Name="plus" Class="w-3 h-3" /> Subcategoría</a>
                            <a href="@($"/admin/categorias/editar/{parent.Id}")"
                               class="p-2 text-slate-500 hover:text-[#00509D] hover:bg-blue-50 rounded-xl transition" title="Editar categoría principal"><Icon Name="edit" Class="w-4 h-4" /></a>
                            <button type="button" @onclick="() => DeleteCategoryAsync(parent, true)" class="p-2 text-slate-400 hover:text-rose-600 hover:bg-rose-50 rounded-xl transition" title="Eliminar categoría"><Icon Name="trash" Class="w-4 h-4" /></button>
                        </div>
                    </div>

                    @if (children.Any())
                    {
                        <div class="mt-4 ml-12 space-y-2">
                            @foreach (var child in children)
                            {
                                <div @key="child.Id" class="flex flex-wrap items-center justify-between gap-3 p-3 rounded-xl border border-slate-200/80 bg-white">
                                    <div class="flex items-center gap-3 min-w-0">
                                        <span class="w-7 h-7 rounded-lg bg-slate-100 text-slate-500 font-bold text-[10px] flex items-center justify-center shrink-0">#@child.Order</span>
                                        <div class="min-w-0">
                                            <div class="flex items-center gap-2 flex-wrap">
                                                <span class="font-semibold text-slate-800 text-sm">@child.Name</span>
                                                <span class="text-[10px] text-slate-400 font-mono">/@child.Slug</span>
                                                <span class="text-[10px] uppercase font-bold tracking-wider px-2 py-0.5 rounded-full bg-slate-100 text-slate-600">Subcategoría</span>
                                            </div>
                                            <div class="flex items-center gap-2 text-[11px] text-slate-500 mt-0.5">
                                                <span class="@(child.IsActive ? "text-emerald-600 font-semibold" : "text-slate-400")">@(child.IsActive ? "Activa" : "Inactiva")</span>
                                                <span>•</span>
                                                <span>@(child.ShowInMenu ? "Visible en menú" : "Oculta del menú")</span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="flex items-center gap-1">
                                        <a href="@($"/admin/categorias/editar/{child.Id}")" class="p-2 text-slate-500 hover:text-[#00509D] hover:bg-blue-50 rounded-xl transition" title="Editar subcategoría"><Icon Name="edit" Class="w-4 h-4" /></a>
                                        <button type="button" @onclick="() => DeleteCategoryAsync(child, false)" class="p-2 text-slate-400 hover:text-rose-600 hover:bg-rose-50 rounded-xl transition" title="Eliminar subcategoría"><Icon Name="trash" Class="w-4 h-4" /></button>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            }

            @if (orphanSubs.Any())
            {
                <div class="p-5">
                    <p class="text-xs font-semibold text-amber-700 mb-2">Subcategorías sin categoría principal visible</p>
                    <div class="space-y-2">
                        @foreach (var orphan in orphanSubs)
                        {
                            <div @key="orphan.Id" class="flex items-center justify-between gap-3 p-3 rounded-xl border border-amber-200 bg-amber-50/50">
                                <span class="text-sm text-slate-700">@orphan.Name <span class="text-xs text-slate-400 font-mono">/@orphan.Slug</span></span>
                                <a href="@($"/admin/categorias/editar/{orphan.Id}")" class="text-xs font-semibold text-[#00509D] hover:underline">Editar</a>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public List<CategoryResponseDto> InitialParents { get; set; } = [];
    [Parameter] public List<CategoryResponseDto> InitialSubs { get; set; } = [];

    private List<CategoryResponseDto> _parents = [];
    private List<CategoryResponseDto> _subs = [];
    private bool _busy;
    private string? _message;

    protected override void OnInitialized()
    {
        _parents = InitialParents;
        _subs = InitialSubs;
    }

    protected override bool Accepts(CmsChangeEvent change) =>
        change.Module == CmsModule.Categories;

    protected override async Task OnChangeAsync(CmsChangeEvent change)
    {
        var all = await CategoryService.GetAllAsync();
        _parents = all.Where(c => c.ParentId is null).OrderBy(c => c.Order).ToList();
        _subs = all.Where(c => c.ParentId is not null).ToList();
    }

    private async Task DeleteCategoryAsync(CategoryResponseDto category, bool deleteChildren)
    {
        if (_busy) return;

        var message = deleteChildren
            ? $"¿Eliminar '{category.Name}' y sus subcategorías asociadas?"
            : $"¿Eliminar la subcategoría '{category.Name}'?";

        if (!await JS.InvokeAsync<bool>("confirm", message)) return;

        _busy = true;
        try
        {
            if (deleteChildren)
            {
                foreach (var child in _subs.Where(s => s.ParentId == category.Id))
                    await CategoryService.DeleteAsync(child.Id);
            }

            await CategoryService.DeleteAsync(category.Id);
            MenuService.InvalidateMenu();

            var all = await CategoryService.GetAllAsync();
            _parents = all.Where(c => c.ParentId is null).OrderBy(c => c.Order).ToList();
            _subs = all.Where(c => c.ParentId is not null).ToList();
        }
        catch (Exception ex)
        {
            _message = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
