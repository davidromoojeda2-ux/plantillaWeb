@if (TotalPages > 1)
{
    <div class="flex flex-col sm:flex-row items-center justify-between gap-3 px-5 py-4 border-t border-slate-100 bg-slate-50/60">
        <p class="text-xs text-slate-500">
            Mostrando
            <span class="font-semibold text-slate-700">@FirstItem</span>–<span class="font-semibold text-slate-700">@LastItem</span>
            de <span class="font-semibold text-slate-700">@TotalCount</span> @ItemLabel
        </p>

        <nav class="flex items-center gap-1" aria-label="@AriaLabel">
            <button type="button"
                    class="inline-flex items-center gap-1 px-2.5 py-1.5 rounded-lg border border-slate-300 bg-white text-xs font-semibold text-slate-700 hover:bg-slate-50 transition disabled:opacity-40 disabled:cursor-not-allowed"
                    disabled="@(!HasPrevious)"
                    @onclick="() => GoToAsync(CurrentPage - 1)"
                    aria-label="Página anterior">
                <Icon Name="arrow-left" Class="w-3.5 h-3.5" />
                <span class="hidden sm:inline">Anterior</span>
            </button>

            @foreach (var item in GetPages())
            {
                if (item.IsEllipsis)
                {
                    <span class="px-1.5 text-xs text-slate-400" aria-hidden="true">…</span>
                }
                else
                {
                    var pageNumber = item.PageNumber!.Value;
                    <button type="button"
                            class="min-w-8 h-8 px-2 rounded-lg text-xs font-semibold transition @(item.IsCurrent ? "bg-[#00296B] text-white shadow-xs" : "border border-slate-300 bg-white text-slate-700 hover:bg-slate-50")"
                            aria-current="@(item.IsCurrent ? "page" : null)"
                            aria-label="Página @pageNumber"
                            @onclick="() => GoToAsync(pageNumber)">
                        @pageNumber
                    </button>
                }
            }

            <button type="button"
                    class="inline-flex items-center gap-1 px-2.5 py-1.5 rounded-lg border border-slate-300 bg-white text-xs font-semibold text-slate-700 hover:bg-slate-50 transition disabled:opacity-40 disabled:cursor-not-allowed"
                    disabled="@(!HasNext)"
                    @onclick="() => GoToAsync(CurrentPage + 1)"
                    aria-label="Página siguiente">
                <span class="hidden sm:inline">Siguiente</span>
                <Icon Name="arrow-right" Class="w-3.5 h-3.5" />
            </button>
        </nav>
    </div>
}

@code {
    [Parameter] public int CurrentPage { get; set; } = 1;
    [Parameter] public int TotalPages { get; set; } = 1;
    [Parameter] public int TotalCount { get; set; }
    [Parameter] public int PageSize { get; set; } = 10;
    [Parameter] public string ItemLabel { get; set; } = "registros";
    [Parameter] public string AriaLabel { get; set; } = "Navegación de páginas";
    [Parameter] public EventCallback<int> OnPageChanged { get; set; }

    private bool HasPrevious => CurrentPage > 1;
    private bool HasNext => CurrentPage < TotalPages;

    private int FirstItem => TotalCount == 0 ? 0 : ((CurrentPage - 1) * PageSize) + 1;
    private int LastItem => Math.Min(CurrentPage * PageSize, TotalCount);

    private Task GoToAsync(int page)
    {
        if (page < 1 || page > TotalPages || page == CurrentPage) return Task.CompletedTask;
        return OnPageChanged.InvokeAsync(page);
    }

    private IEnumerable<PageItem> GetPages()
    {
        if (TotalPages <= 7)
        {
            for (var i = 1; i <= TotalPages; i++)
                yield return new PageItem(i, i == CurrentPage);
            yield break;
        }

        yield return new PageItem(1, CurrentPage == 1);

        var start = Math.Max(2, CurrentPage - 1);
        var end = Math.Min(TotalPages - 1, CurrentPage + 1);

        if (start > 2)
            yield return PageItem.Ellipsis;

        for (var i = start; i <= end; i++)
            yield return new PageItem(i, i == CurrentPage);

        if (end < TotalPages - 1)
            yield return PageItem.Ellipsis;

        yield return new PageItem(TotalPages, CurrentPage == TotalPages);
    }

    private readonly record struct PageItem(int? PageNumber, bool IsCurrent)
    {
        public bool IsEllipsis => !PageNumber.HasValue;
        public static PageItem Ellipsis => new(null, false);
    }
}
