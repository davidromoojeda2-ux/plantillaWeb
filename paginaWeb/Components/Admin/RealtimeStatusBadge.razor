<span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-semibold @(Connected ? "bg-emerald-50 text-emerald-700 border border-emerald-200" : "bg-amber-50 text-amber-800 border border-amber-200")">
    <span class="w-1.5 h-1.5 rounded-full @(Connected ? "bg-emerald-500" : "bg-amber-500")"></span>
    @(Connected ? Text : "Reconectando")
</span>

@code {
    [Parameter] public bool Connected { get; set; } = true;
    [Parameter] public string Text { get; set; } = "Tiempo real";
}
