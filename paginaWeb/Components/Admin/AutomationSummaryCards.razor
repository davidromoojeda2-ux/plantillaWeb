@inherits RealtimeComponentBase
@inject IAutomationService Automation

<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
    <div class="bg-white p-6 rounded-2xl border border-slate-200/80 flex items-center justify-between">
        <div>
            <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Estado</p>
            <h3 class="text-3xl font-bold mt-1 @(_status.Paused ? "text-red-600" : "text-green-700")">
                @(_status.Paused ? "Pausada" : "Activa")
            </h3>
        </div>
        <div class="text-slate-300">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
        </div>
    </div>

    <div class="bg-white p-6 rounded-2xl border border-slate-200/80 flex items-center justify-between">
        <div>
            <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Publicación</p>
            <h3 class="text-3xl font-bold mt-1 text-slate-800">@(_status.AutoPublish ? "Automática" : "Borrador")</h3>
        </div>
        <div class="text-slate-300">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
        </div>
    </div>

    <div class="bg-white p-6 rounded-2xl border border-slate-200/80 flex items-center justify-between">
        <div>
            <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Decisiones pendientes</p>
            <h3 class="text-3xl font-bold mt-1 text-slate-800">@_status.PendingDecisionsCount</h3>
        </div>
        <div class="text-slate-300">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" />
            </svg>
        </div>
    </div>

    <div class="bg-white p-6 rounded-2xl border border-slate-200/80 flex items-center justify-between">
        <div>
            <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Frecuencia</p>
            <h3 class="text-3xl font-bold mt-1 text-slate-800">@FreqLabel</h3>
        </div>
        <div class="text-slate-300">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
        </div>
    </div>
</div>

@code {
    [Parameter] public AutomationStatusDto InitialStatus { get; set; } = new();

    private AutomationStatusDto _status = new();

    private string FreqLabel
    {
        get
        {
            var fm = _status.FrequencyMinutes;
            return fm >= 60 ? $"{fm / 60} h" + (fm % 60 > 0 ? $" {fm % 60} min" : "") : $"{fm} min";
        }
    }

    protected override void OnInitialized() => _status = InitialStatus;

    protected override bool Accepts(CmsChangeEvent change) =>
        change.Module == CmsModule.Automation;

    protected override async Task OnChangeAsync(CmsChangeEvent change)
    {
        if (change.Operation is CmsChangeOperation.Started
            or CmsChangeOperation.Completed
            or CmsChangeOperation.Failed
            or CmsChangeOperation.Stopped
            or CmsChangeOperation.DecisionCreated
            or CmsChangeOperation.DecisionResolved
            or CmsChangeOperation.SettingsChanged)
        {
            _status = await Automation.GetStatusAsync();
        }
    }
}
