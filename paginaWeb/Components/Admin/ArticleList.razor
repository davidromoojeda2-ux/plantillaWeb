@inherits RealtimeComponentBase
@inject IArticleService ArticleService
@inject ICategoryService CategoryService
@inject Infrastructure.Storage.ImageService ImageService
@inject IMenuService MenuService

@{
    var filtered = FilteredItems().ToList();
    var featuredCount = _items.Count(a => a.Featured);
    var publishedCount = _items.Count(IsPublished);
    var draftCount = _items.Count - publishedCount;
    var totalPages = Math.Max(1, (int)Math.Ceiling(filtered.Count / (double)PageSize));
    var currentPage = Math.Clamp(_page, 1, totalPages);
    var pagedItems = filtered.Skip((currentPage - 1) * PageSize).Take(PageSize).ToList();
    var hasActiveFilters = _filter != "all" || !string.IsNullOrWhiteSpace(_categoryId) ||
!string.IsNullOrWhiteSpace(_search);
}

<div class="space-y-6">
    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="rounded-xl px-4 py-3 text-sm font-semibold bg-amber-50 text-amber-900 border border-amber-200">
            @_message
        </div>
    }

    <div
        class="bg-white rounded-2xl border border-slate-200/80 shadow-xs p-4 flex flex-col lg:flex-row lg:items-center justify-between gap-3">
        <div class="flex items-center gap-1.5 overflow-x-auto pb-1 lg:pb-0">
            <button type="button" class="@TabClass("all")" @onclick='() => SetFilter("all")'>Todas
                (@_items.Count)</button>
                <button type="button" class="@TabClass("hero")" @onclick='() => SetFilter("hero")'>
                    Hero Principal (@featuredCount)
                </button>
                <button type="button" class="@TabClass("publicado")" @onclick='() => SetFilter("publicado")'>Publicadas
                    (@publishedCount)</button>
                    <button type="button" class="@TabClass("borrador")" @onclick='() => SetFilter("borrador")'>Borradores
                        (@draftCount)</button>
                    </div>

                    <div class="flex flex-col sm:flex-row sm:items-center gap-2 w-full lg:w-auto">
                        <select value="@_categoryId" @onchange="OnCategoryChanged" aria-label="Filtrar publicaciones por categoría"
                                class="w-full sm:w-52 text-xs rounded-xl border border-slate-300 bg-white px-3 py-2 text-slate-700 focus:outline-none focus:ring-2 focus:ring-[#00509D] transition">
                            <option value="">Todas las categorías</option>
                            @foreach (var category in CategoryOptions())
                            {
                                <option value="@category.Id">@category.Label</option>
                            }
                        </select>

                        <div class="relative w-full sm:w-72 flex-shrink-0">
                            <input type="text" value="@_search" @oninput="OnSearchChanged"
                                   placeholder="Buscar por título, categoría o slug..." aria-label="Buscar publicaciones"
                                   class="w-full pl-9 pr-4 py-2 text-xs border-b transition" />
                            <svg class="w-4 h-4 text-slate-400 absolute left-3 top-2.5 pointer-events-none" fill="none"
                                 stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                      d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                            </svg>
                        </div>

                        @if (hasActiveFilters)
                        {
                            <button type="button" @onclick="ClearFilters"
                                    class="shrink-0 px-3 py-2 rounded-xl border border-slate-300 text-xs font-semibold text-slate-600 hover:bg-slate-50 transition">
                                Limpiar
                            </button>
                        }
                    </div>
                </div>

                <div class="bg-white rounded-2xl border border-slate-200/80 shadow-xs overflow-hidden">
                    <div class="p-5 border-b border-slate-100 flex items-center justify-between gap-3">
                        <div class="flex items-center gap-2">
                            <h3 class="font-bold text-slate-800 text-base">Publicaciones del Portal</h3>
                            <span class="text-xs text-slate-400">
                                Total: @filtered.Count@(filtered.Count != _items.Count ? $" de {_items.Count}" : "")
                            </span>
                        </div>
                        <RealtimeStatusBadge Text="Actualización automática" />
                    </div>

                    @if (!filtered.Any())
                    {
                        <div class="p-12 text-center text-slate-400">
                            <p class="font-medium text-slate-600">No hay artículos con el filtro seleccionado.</p>
                            @if (hasActiveFilters)
                            {
                                <button type="button" @onclick="ClearFilters"
                                        class="mt-3 text-xs font-semibold text-[#00509D] hover:underline">
                                    Limpiar filtros
                                </button>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="overflow-x-auto">
                            <table class="w-full text-left text-sm">
                                <thead
                                    class="bg-slate-50 border-b border-slate-100 text-xs font-semibold uppercase text-slate-500 tracking-wider">
                                    <tr>
                                        <th class="px-5 py-3.5">Artículo</th>
                                        <th class="px-4 py-3.5 text-center">Hero Portada</th>
                                        <th class="px-5 py-3.5">Categoría</th>
                                        <th class="px-5 py-3.5">Estado</th>
                                        <th class="px-5 py-3.5">Fecha</th>
                                        <th class="px-5 py-3.5">Vistas</th>
                                        <th class="px-5 py-3.5 text-right">Acciones</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-slate-100">
                                    @foreach (var art in pagedItems)
                                    {
                                        var coverUrl = ResolveCoverUrl(art);
                                        var categoryName = CategoryLabel(art.CategoryId, art.SubcategoryId);
                                        var isPublished = IsPublished(art);

                                        <tr @key="art.Id"
                                            class="transition-all @(art.Featured ? "bg-amber-50/40 hover:bg-amber-50/70 border-l-4 border-l-amber-400" : "hover:bg-slate-50/60 border-l-4 border-l-transparent")">
                                            <td class="px-5 py-4">
                                                <div class="flex items-start gap-3.5">
                                                    <div
                                                        class="relative flex-shrink-0 w-12 h-12 rounded-xl overflow-hidden bg-slate-100 border border-slate-200 shadow-2xs">
                                                        @if (!string.IsNullOrEmpty(coverUrl))
                                                        {
                                                            <img src="@coverUrl" alt="" referrerpolicy="no-referrer"
                                                                 class="w-full h-full object-cover" />
                                                        }
                                                        else
                                                        {
                                                            <div
                                                                class="w-full h-full flex items-center justify-center text-slate-300 bg-slate-50">
                                                                —</div>
                                                            }
                                                            @if (art.Featured)
                                                            {
                                                                <span
                                                                    class="absolute -top-1 -right-1 w-5 h-5 rounded-full bg-[#FDC500] text-[#00296B] flex items-center justify-center text-[10px] font-black shadow-xs ring-2 ring-white">
                                                                    
                                                                </span>
                                                            }
                                                        </div>
                                                        <div class="min-w-0 flex-1">
                                                            <div class="flex items-center flex-wrap gap-2">
                                                                <a href="@($"/admin/articulos/editar/{art.Id}")"
                                                                   class="font-semibold text-slate-800 hover:text-[#00509D] line-clamp-1 text-sm transition-colors"
                                                                   title="@art.Title">@art.Title</a>
                                                                @if (art.Featured)
                                                                {
                                                                    <span
                                                                        class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md text-[11px] font-bold bg-[#FDC500] text-[#00296B] shadow-2xs">
                                                                        HERO PRINCIPAL
                                                                    </span>
                                                                }
                                                            </div>
                                                            <span class="text-xs text-slate-400 font-mono">/@art.Slug</span>
                                                        </div>
                                                    </div>
                                                </td>

                                                <td class="px-4 py-4 text-center">
                                                    <button type="button" @onclick="() => ToggleFeaturedAsync(art)"
                                                            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-bold transition-all shadow-2xs @(art.Featured ? "bg-amber-100 text-amber-900 border border-amber-300 hover:bg-amber-200" : "bg-slate-100 text-slate-500 border border-slate-200 hover:bg-amber-50 hover:text-amber-700 hover:border-amber-300")"
                                                            title="@(art.Featured ? "Quitar del Hero principal" : "Fijar en Hero principal")">
                                                        @(art.Featured ? "Destacado" : "Normal")
                                                    </button>
                                                </td>

                                                <td class="px-5 py-4 text-xs text-slate-600">
                                                    <span
                                                    class="inline-flex items-center px-2 py-0.5 rounded-md bg-slate-100 text-slate-700 font-medium">@categoryName</span>
                                                </td>

                                                <td class="px-5 py-4">
                                                    @if (isPublished)
                                                    {
                                                        <span
                                                            class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">
                                                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Publicado
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span
                                                            class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-amber-50 text-amber-700 border border-amber-200">
                                                            <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span> @art.Status
                                                        </span>
                                                    }
                                                </td>

                                                <td class="px-5 py-4 text-xs text-slate-500 font-medium">@art.CreatedAt.ToString("dd/MM/yyyy")
                                                </td>
                                                <td class="px-5 py-4 text-xs font-mono text-slate-600">@art.ViewCount</td>

                                                <td class="px-5 py-4 text-right">
                                                    <div class="inline-flex items-center gap-1">
                                                        <a href="@($"/articulos/{art.Slug}")" target="_blank"
                                                           class="p-2 text-slate-400 hover:text-[#00509D] hover:bg-blue-50 rounded-xl transition"
                                                           title="Ver en portal público">
                                                            <Icon Name="external" Class="w-4 h-4" />
                                                        </a>
                                                        <a href="@($"/admin/articulos/editar/{art.Id}")"
                                                           class="p-2 text-slate-400 hover:text-slate-700 hover:bg-slate-100 rounded-xl transition"
                                                           title="Editar artículo">
                                                            <Icon Name="edit" Class="w-4 h-4" />
                                                        </a>
                                                        <button type="button" @onclick="() => DeleteAsync(art)"
                                                                class="p-2 text-slate-400 hover:text-rose-600 hover:bg-rose-50 rounded-xl transition"
                                                                title="Eliminar artículo">
                                                            <Icon Name="trash" Class="w-4 h-4" />
                                                        </button>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>

                            <AdminPagination CurrentPage="currentPage" TotalPages="totalPages" TotalCount="filtered.Count"
                                             PageSize="PageSize" ItemLabel="artículos" AriaLabel="Paginación de artículos"
                                             OnPageChanged="GoToPageAsync" />
                        }
                    </div>
                </div>

@code {
    private const int PageSize = 10;

    private List<ArticleResponseDto> _items = [];
    private List<CategoryResponseDto> _categoryList = [];
    private Dictionary<string, string> _categories = [];
    private Dictionary<string, string> _coverImages = [];
    private string _filter = "all";
    private string _search = string.Empty;
    private string _categoryId = string.Empty;
    private int _page = 1;
    private string? _message;
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync();
    }

    protected override bool Accepts(CmsChangeEvent change) =>
        change.Module is CmsModule.Articles or CmsModule.Categories;

    protected override async Task OnChangeAsync(CmsChangeEvent change)
    {
        if (change.Module == CmsModule.Articles)
        {
            await LoadArticlesAsync();
            await LoadCoversAsync();
        }

        if (change.Module == CmsModule.Categories)
            await LoadCategoriesAsync();

        ClampPage();
    }

    private async Task RefreshAsync()
    {
        await LoadArticlesAsync();
        await LoadCategoriesAsync();
        await LoadCoversAsync();
        ClampPage();
    }

    private async Task LoadArticlesAsync()
    {
        const int batchSize = 200;
        var items = new List<ArticleResponseDto>();
        var page = 1;

        while (true)
        {
            var batch = await ArticleService.GetAllAdminAsync(page, batchSize);
            items.AddRange(batch);

            if (batch.Count < batchSize)
                break;

            page++;
        }

        _items = items;
    }

    private async Task LoadCategoriesAsync()
    {
        _categoryList = (await CategoryService.GetAllAsync())
            .OrderBy(c => c.Order)
            .ThenBy(c => c.Name)
            .ToList();

        _categories = _categoryList.ToDictionary(c => c.Id, c => c.Name);
    }

    private async Task ToggleFeaturedAsync(ArticleResponseDto article)
    {
        if (_busy) return;
        _busy = true;

        try
        {
            var result = await ArticleService.ToggleFeaturedAsync(article.Id);
            _message = result.Success
                ? (result.Featured ? "Artículo fijado en el Hero principal." : "Artículo removido del Hero.")
                : result.Error;

            if (result.Success)
                MenuService.InvalidateMenu();

            await RefreshAsync();
        }
        catch (Exception ex)
        {
            _message = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DeleteAsync(ArticleResponseDto article)
    {
        if (_busy) return;

        var confirmed = await JS.InvokeAsync<bool>("confirm", "¿Seguro que deseas eliminar este artículo? Esta acción no se puede deshacer.");
        if (!confirmed) return;

        _busy = true;
        try
        {
            await ArticleService.DeleteAsync(article.Id);
            MenuService.InvalidateMenu();
            _message = "Artículo eliminado.";
            await RefreshAsync();
        }
        catch (Exception ex)
        {
            _message = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task LoadCoversAsync()
    {
        var coverIds = _items
            .Select(a => !string.IsNullOrEmpty(a.CoverImageId)
                ? a.CoverImageId
                : Aplication.Content.ContentImageResolver.FindFirstImage(a.Blocks)?.ImageId)
            .Where(id => !string.IsNullOrWhiteSpace(id))
            .Select(id => id!)
            .Distinct()
            .ToList();

        var images = await ImageService.GetVariantsDictAsync(coverIds);
        _coverImages = Aplication.Mappers.ImageMapper.ToThumbnailDictionary(images);
    }

    private string? ResolveCoverUrl(ArticleResponseDto article)
    {
        if (!string.IsNullOrEmpty(article.CoverImageId)
            && _coverImages.TryGetValue(article.CoverImageId, out var cover)
            && !string.IsNullOrWhiteSpace(cover))
            return cover;

        if (!string.IsNullOrWhiteSpace(article.CoverImageUrl))
            return article.CoverImageUrl;

        var bodyImage = Aplication.Content.ContentImageResolver.FindFirstImage(article.Blocks);
        if (!string.IsNullOrWhiteSpace(bodyImage?.ImageId)
            && _coverImages.TryGetValue(bodyImage.ImageId, out var bodyCover)
            && !string.IsNullOrWhiteSpace(bodyCover))
            return bodyCover;

        return bodyImage?.Url;
    }

    private IEnumerable<ArticleResponseDto> FilteredItems()
    {
        IEnumerable<ArticleResponseDto> query = _items;

        query = _filter switch
        {
            "hero" => query.Where(a => a.Featured),
            "publicado" => query.Where(IsPublished),
            "borrador" => query.Where(a => !IsPublished(a)),
            _ => query
        };

        if (!string.IsNullOrWhiteSpace(_categoryId))
        {
            var childIds = _categoryList
                .Where(c => c.ParentId == _categoryId)
                .Select(c => c.Id)
                .ToHashSet();

            query = query.Where(a =>
                a.CategoryId == _categoryId
                || a.SubcategoryId == _categoryId
                || (a.SubcategoryId is not null && childIds.Contains(a.SubcategoryId)));
        }

        var search = _search.Trim();
        if (search.Length == 0)
            return query;

        return query.Where(a =>
            a.Title.Contains(search, StringComparison.OrdinalIgnoreCase)
            || a.Slug.Contains(search, StringComparison.OrdinalIgnoreCase)
            || a.Summary.Contains(search, StringComparison.OrdinalIgnoreCase)
            || CategoryLabel(a.CategoryId, a.SubcategoryId).Contains(search, StringComparison.OrdinalIgnoreCase));
    }

    private IEnumerable<(string Id, string Label)> CategoryOptions()
    {
        var parents = _categoryList
            .Where(c => c.ParentId is null)
            .OrderBy(c => c.Order)
            .ThenBy(c => c.Name);

        foreach (var parent in parents)
        {
            yield return (parent.Id, parent.Name);

            var children = _categoryList
                .Where(c => c.ParentId == parent.Id)
                .OrderBy(c => c.Order)
                .ThenBy(c => c.Name);

            foreach (var child in children)
                yield return (child.Id, $"— {child.Name}");
        }
    }

    private string CategoryLabel(string? categoryId, string? subcategoryId)
    {
        var names = new List<string>();

        if (!string.IsNullOrEmpty(categoryId) && _categories.TryGetValue(categoryId, out var categoryName))
            names.Add(categoryName);

        if (!string.IsNullOrEmpty(subcategoryId)
            && _categories.TryGetValue(subcategoryId, out var subcategoryName)
            && !names.Contains(subcategoryName))
            names.Add(subcategoryName);

        return names.Count > 0 ? string.Join(" / ", names) : "-";
    }

    private void ClampPage()
    {
        var total = FilteredItems().Count();
        var totalPages = Math.Max(1, (int)Math.Ceiling(total / (double)PageSize));
        _page = Math.Clamp(_page, 1, totalPages);
    }

    private void SetFilter(string filter)
    {
        _filter = filter;
        _page = 1;
    }

    private void OnCategoryChanged(ChangeEventArgs args)
    {
        _categoryId = args.Value?.ToString() ?? string.Empty;
        _page = 1;
    }

    private void OnSearchChanged(ChangeEventArgs args)
    {
        _search = args.Value?.ToString() ?? string.Empty;
        _page = 1;
    }

    private void ClearFilters()
    {
        _filter = "all";
        _categoryId = string.Empty;
        _search = string.Empty;
        _page = 1;
    }

    private Task GoToPageAsync(int page)
    {
        _page = page;
        return Task.CompletedTask;
    }

    private static bool IsPublished(ArticleResponseDto article) =>
        string.Equals(article.Status, "Publicado", StringComparison.OrdinalIgnoreCase);

    private string TabClass(string filter) =>
        _filter == filter
            ? "inline-flex items-center gap-1 px-3.5 py-1.5 rounded-xl text-xs font-semibold bg-[#00296B] text-white shadow-xs transition whitespace-nowrap"
            : "inline-flex items-center gap-1 px-3.5 py-1.5 rounded-xl text-xs font-semibold bg-slate-100 text-slate-700 hover:bg-slate-200 transition whitespace-nowrap";
}
