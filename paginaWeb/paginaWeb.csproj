<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>c033c88f-6e47-4795-9266-a80c4cacc51a</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Aplication\Aplication.csproj" />
    <ProjectReference Include="..\Infrastructure\Infrastructure.csproj" />
  </ItemGroup>

  <Target Name="BuildTailwind" BeforeTargets="Build">
    <Exec Command="pnpm.cmd run build:css" Condition="$(OS) == 'Windows_NT'" />
    <Exec Command="pnpm run build:css" Condition="$(OS) != 'Windows_NT'" />
  </Target>

</Project>
