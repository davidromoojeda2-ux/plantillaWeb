{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "MongoDB": {
    "ConnectionString": "",
    "DatabaseName": "portal_noticias"
  },
  "Storage": {
    "Provider": "S3"
  },
  "LocalStorage": {
    "BasePath": "",
    "BaseUrl": "/uploads"
  },
  "S3": {
    "ServiceUrl": "",
    "Region": "us-east-1",
    "BucketName": "portal-noticias",
    "AccessKeyId": "",
    "SecretAccessKey": "",
    "PublicDomain": ""
  },
  "CloudflareR2": {
    "AccountId": "",
    "AccessKeyId": "",
    "SecretAccessKey": "",
    "BucketName": "portal-noticias",
    "PublicDomain": "https://pub-example.r2.dev"
  },
  "ContentSecurity": {
    "MaxBlocks": 100,
    "MaxJsonBytes": 524288,
    "MaxRichTextHtmlLength": 40000,
    "MaxTextLength": 20000,
    "MaxListItems": 50,
    "MaxTableRows": 50,
    "MaxTableColumns": 10,
    "MaxUrlLength": 2048,
    "AllowedImageHosts": [
      "images.unsplash.com",
      "plus.unsplash.com"
    ]
  }
}

