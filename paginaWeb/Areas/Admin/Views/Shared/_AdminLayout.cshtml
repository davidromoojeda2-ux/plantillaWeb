<!DOCTYPE html>
<html lang="es" class="h-full bg-slate-50">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Panel de Administración</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Merriweather:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/tailwind.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="h-full font-sans text-slate-800 antialiased flex flex-col md:flex-row">

    <!-- ─── Sidebar de Administración ────────────────────────────────────────── -->
    <aside class="w-full md:w-64 bg-[#00296B] text-white flex-shrink-0 flex flex-col min-h-screen">
        <div class="p-6 border-b border-white/10 flex items-center justify-between">
            <div class="flex items-center space-x-3">
                <div class="w-9 h-9 rounded-lg bg-[#FDC500] text-[#00296B] font-bold text-xl flex items-center justify-center shadow-md">
                    N
                </div>
                <div>
                    <h1 class="font-bold text-lg tracking-tight leading-tight">AdminPanel</h1>
                    <p class="text-xs text-blue-200">Portal Informativo</p>
                </div>
            </div>
        </div>

        <!-- Navegación -->
        <nav class="flex-1 px-4 py-6 space-y-1.5 overflow-y-auto">
            <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors hover:bg-white/10 text-white">
                <svg class="w-5 h-5 text-[#FDC500]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
                Dashboard
            </a>

            <a asp-area="Admin" asp-controller="Articulos" asp-action="Index" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors hover:bg-white/10 text-white">
                <svg class="w-5 h-5 text-[#FDC500]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9.5a2 2 0 00-.586-1.414l-4.5-4.5A2 2 0 0015.5 3H5"/></svg>
                Artículos
            </a>

            <a asp-area="Admin" asp-controller="Categorias" asp-action="Index" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors hover:bg-white/10 text-white">
                <svg class="w-5 h-5 text-[#FDC500]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/></svg>
                Categorías
            </a>

            <a asp-area="Admin" asp-controller="Imagenes" asp-action="Index" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors hover:bg-white/10 text-white">
                <svg class="w-5 h-5 text-[#FDC500]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                Biblioteca de Imágenes
            </a>

            <a asp-area="Admin" asp-controller="Comentarios" asp-action="Index" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors hover:bg-white/10 text-white">
                <svg class="w-5 h-5 text-[#FDC500]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"/></svg>
                Comentarios
            </a>

            <a asp-area="Admin" asp-controller="Secciones" asp-action="Index" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors hover:bg-white/10 text-white">
                <svg class="w-5 h-5 text-[#FDC500]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                Páginas Informativas
            </a>

            <a asp-area="Admin" asp-controller="Automation" asp-action="Index" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors hover:bg-white/10 text-white">
                <svg class="w-5 h-5 text-[#FDC500]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                Automatización
            </a>

            <div class="pt-4 border-t border-white/10 mt-4">
                <a asp-area="" asp-controller="Home" asp-action="Index" target="_blank" class="flex items-center gap-3 px-3 py-2 rounded-lg text-xs font-semibold uppercase tracking-wider text-blue-200 hover:text-white transition-colors">
                    <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
                    Ver Portal Público
                </a>
            </div>
        </nav>

        <!-- Perfil y Salida -->
        <div class="p-4 border-t border-white/10 flex items-center justify-between bg-black/20">
            <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-full bg-[#00509D] flex items-center justify-center text-xs font-bold text-white uppercase">
                    @(User.Identity?.Name?.Substring(0, 1) ?? "A")
                </div>
                <div class="truncate max-w-[110px]">
                    <div class="text-xs font-semibold truncate">@(User.Identity?.Name ?? "Admin")</div>
                    <div class="text-[10px] text-blue-300">Editor en jefe</div>
                </div>
            </div>
            <form method="post" asp-area="Admin" asp-controller="Auth" asp-action="Logout">
                @Html.AntiForgeryToken()
                <button type="submit" class="p-2 rounded-lg text-blue-300 hover:text-rose-400 hover:bg-white/10 transition-colors" title="Cerrar sesión">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
                </button>
            </form>
        </div>
    </aside>

    <!-- ─── Contenedor Principal ─────────────────────────────────────────────── -->
    <main class="flex-1 flex flex-col min-w-0 overflow-y-auto">
        <!-- Top bar -->
        <header class="bg-white border-b border-slate-200 px-6 py-4 flex items-center justify-between sticky top-0 z-30 shadow-xs">
            <div class="flex items-center gap-4">
                <h2 class="text-xl font-bold text-slate-800">@ViewData["Title"]</h2>
            </div>
            <div class="flex items-center gap-3">
                @await RenderSectionAsync("HeaderActions", required: false)
            </div>
        </header>

        <!-- Los mensajes de TempData se muestran como toasts globales (ver script al final). -->

        <!-- Contenido principal -->
        <div class="p-6 flex-1">
            @RenderBody()
        </div>
    </main>

    <!-- ─── Toasts globales ─────────────────────────────────────────────────── -->
    <div id="toastContainer" class="fixed top-4 right-4 z-[60] flex flex-col gap-2 w-full max-w-sm pointer-events-none"></div>

    <!-- ─── Diálogo global (confirmar / avisar / pedir valor) ──────────────── -->
    <div id="appDialog" class="fixed inset-0 z-[80] hidden" role="dialog" aria-modal="true"
         aria-labelledby="appDialogTitle" aria-describedby="appDialogMessage">
        <div class="absolute inset-0 bg-slate-900/60" data-dialog-backdrop></div>
        <div class="relative flex min-h-full items-center justify-center p-4">
            <div class="w-full max-w-md overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-2xl">
                <div class="flex items-start gap-4 p-6">
                    <div id="appDialogIcon" class="flex h-11 w-11 flex-shrink-0 items-center justify-center rounded-xl bg-[#00296B] text-white">
                        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                    </div>
                    <div class="min-w-0 flex-1">
                        <h3 id="appDialogTitle" class="text-lg font-bold text-slate-800">Confirmar</h3>
                        <p id="appDialogMessage" class="mt-1 whitespace-pre-line text-sm leading-relaxed text-slate-600"></p>
                    </div>
                </div>

                <div id="appDialogInputWrap" class="hidden px-6 pb-5">
                    <label for="appDialogInput" class="mb-1 block text-xs font-semibold uppercase tracking-wider text-slate-500">Valor</label>
                    <input id="appDialogInput" type="text" autocomplete="off"
                           class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-[#00509D] focus:outline-none focus:ring-2 focus:ring-[#00509D]/20" />
                    <p id="appDialogInputError" class="mt-1 hidden text-xs font-semibold text-red-600"></p>
                </div>

                <div class="flex flex-col-reverse gap-2 border-t border-slate-100 bg-slate-50 px-6 py-4 sm:flex-row sm:justify-end">
                    <button type="button" id="appDialogCancel"
                            class="inline-flex items-center justify-center rounded-xl border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 transition-colors hover:bg-slate-100 focus:outline-none focus:ring-2 focus:ring-slate-300">
                        Cancelar
                    </button>
                    <button type="button" id="appDialogAccept"
                            class="inline-flex items-center justify-center rounded-xl bg-[#00296B] px-4 py-2 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-[#003F88] focus:outline-none focus:ring-2 focus:ring-[#00509D] focus:ring-offset-2">
                        Aceptar
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script>
        (function () {
            var container = document.getElementById('toastContainer');

            window.showToast = function (message, type) {
                if (!container || !message) return;
                type = type || 'info';

                var colors = {
                    success: 'bg-green-600 text-white border-green-700',
                    error: 'bg-red-600 text-white border-red-700',
                    info: 'bg-[#00509D] text-white border-[#003F88]'
                };
                var icons = { success: '✓', error: '✕', info: 'ℹ' };

                var toast = document.createElement('div');
                toast.className = 'pointer-events-auto flex items-start gap-3 px-4 py-3 rounded-xl border shadow-lg text-sm font-medium transition-all duration-300 ' + (colors[type] || colors.info);

                var icon = document.createElement('span');
                icon.className = 'font-bold';
                icon.textContent = icons[type] || icons.info;

                var text = document.createElement('span');
                text.className = 'flex-1';
                text.textContent = message;

                var close = document.createElement('button');
                close.type = 'button';
                close.className = 'opacity-60 hover:opacity-100';
                close.setAttribute('aria-label', 'Cerrar');
                close.textContent = '✕';

                var timer;
                function remove() {
                    clearTimeout(timer);
                    toast.style.opacity = '0';
                    toast.style.transform = 'translateX(12px)';
                    setTimeout(function () { toast.remove(); }, 200);
                }
                close.addEventListener('click', remove);

                toast.append(icon, text, close);
                container.appendChild(toast);
                timer = setTimeout(remove, 6000);
            };

            @if (TempData["Success"] != null)
            {
                <text>window.showToast(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["Success"]?.ToString())), 'success');</text>
            }
            @if (TempData["Error"] != null)
            {
                <text>window.showToast(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["Error"]?.ToString())), 'error');</text>
            }
        })();
    </script>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/js/app-dialogs.js" asp-append-version="true"></script>
    <script src="~/js/admin-tooltips.js" asp-append-version="true" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

