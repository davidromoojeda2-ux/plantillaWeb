<!-- ─── Modal reutilizable: Gestión de Categorías y Subcategorías ─────────────── -->
<div id="categoryManagerModal"
     class="fixed inset-0 z-[70] hidden bg-slate-900/60 backdrop-blur-xs items-center justify-center p-4"
     role="dialog" aria-modal="true" aria-labelledby="categoryManagerTitle">

    <div class="bg-white rounded-2xl shadow-2xl border border-slate-200 max-w-4xl w-full flex flex-col max-h-[92vh] overflow-hidden">

        <!-- Header -->
        <div class="p-5 border-b border-slate-100 flex items-start justify-between gap-4 bg-slate-50/70">
            <div>
                <h3 id="categoryManagerTitle" class="text-base font-bold text-slate-800 flex items-center gap-2">
                    <svg class="w-5 h-5 text-[#00509D]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/>
                    </svg>
                    Gestión de Categorías y Subcategorías
                </h3>
                <p class="text-xs text-slate-500 mt-0.5">
                    Crea, renombra, reorganiza o elimina categorías principales y sus subcategorías. Los cambios se reflejan en el portal y en los formularios.
                </p>
            </div>
            <button type="button" id="categoryManagerClose"
                    class="text-slate-400 hover:text-slate-600 p-1.5 rounded-lg hover:bg-slate-200/60 transition"
                    aria-label="Cerrar gestor de categorías">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
            </button>
        </div>

        <!-- Barra de acciones -->
        <div class="p-4 border-b border-slate-100 bg-white flex flex-wrap items-center justify-between gap-3">
            <div class="relative w-full sm:w-80">
                <input type="text" id="categoryManagerSearch" placeholder="Buscar categoría o subcategoría..."
                       class="w-full pl-9 pr-3 py-1.5 text-xs rounded-xl border border-slate-300 focus:ring-2 focus:ring-[#00509D] focus:outline-none" />
                <svg class="w-4 h-4 text-slate-400 absolute left-2.5 top-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
            </div>
            <button type="button" id="categoryManagerNew"
                    class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-[#FDC500] hover:bg-[#FFD500] text-[#00296B] font-bold text-xs shadow-2xs transition">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
                Nueva categoría
            </button>
        </div>

        <!-- Contenido -->
        <div class="flex-1 overflow-y-auto p-4 bg-slate-50/50 min-h-[300px]">

            <div id="categoryManagerAlert" class="hidden mb-4 rounded-xl border px-4 py-3 text-xs font-semibold"></div>

            <!-- Editor inline -->
            <div id="categoryManagerEditor" class="hidden mb-4 rounded-2xl border border-[#00509D]/25 bg-blue-50/50 p-4">
                <div class="flex items-center justify-between gap-3 mb-3">
                    <h4 id="categoryManagerEditorTitle" class="text-sm font-bold text-slate-800">Nueva categoría</h4>
                    <button type="button" id="categoryManagerEditorCancel"
                            class="text-xs font-semibold text-slate-500 hover:text-slate-800 transition">
                        Cancelar edición
                    </button>
                </div>

                <form id="categoryManagerForm" class="grid grid-cols-1 md:grid-cols-12 gap-3 items-end">
                    <input type="hidden" id="categoryManagerId" />

                    <div class="md:col-span-4">
                        <label class="block text-[11px] font-semibold uppercase tracking-wider text-slate-600 mb-1">Nombre</label>
                        <input type="text" id="categoryManagerName" required maxlength="100"
                               class="w-full text-sm rounded-xl border border-slate-300 px-3 py-2 bg-white focus:ring-2 focus:ring-[#00509D] focus:outline-none" />
                    </div>

                    <div class="md:col-span-4">
                        <label class="block text-[11px] font-semibold uppercase tracking-wider text-slate-600 mb-1">Categoría padre</label>
                        <select id="categoryManagerParent"
                                class="w-full text-sm rounded-xl border border-slate-300 px-3 py-2 bg-white focus:ring-2 focus:ring-[#00509D] focus:outline-none">
                            <option value="">— Sin padre (categoría raíz) —</option>
                        </select>
                        <p id="categoryManagerParentHint" class="hidden mt-1 text-[10px] text-amber-700 font-semibold"></p>
                    </div>

                    <div class="md:col-span-2">
                        <label class="block text-[11px] font-semibold uppercase tracking-wider text-slate-600 mb-1">Orden</label>
                        <input type="number" id="categoryManagerOrder" min="0" value="0"
                               class="w-full text-sm rounded-xl border border-slate-300 px-3 py-2 bg-white focus:ring-2 focus:ring-[#00509D] focus:outline-none" />
                    </div>

                    <div class="md:col-span-2 flex flex-col gap-1.5 pb-1">
                        <label class="flex items-center gap-2 text-xs font-medium text-slate-700 cursor-pointer">
                            <input type="checkbox" id="categoryManagerShowInMenu" checked class="rounded border-slate-300 text-[#00296B]" />
                            En menú
                        </label>
                        <label class="flex items-center gap-2 text-xs font-medium text-slate-700 cursor-pointer">
                            <input type="checkbox" id="categoryManagerIsActive" checked class="rounded border-slate-300 text-[#00296B]" />
                            Activa
                        </label>
                    </div>

                    <div class="md:col-span-12">
                        <label class="block text-[11px] font-semibold uppercase tracking-wider text-slate-600 mb-1">Descripción (opcional)</label>
                        <textarea id="categoryManagerDescription" rows="2" maxlength="500"
                                  class="w-full text-sm rounded-xl border border-slate-300 px-3 py-2 bg-white focus:ring-2 focus:ring-[#00509D] focus:outline-none"></textarea>
                    </div>

                    <div class="md:col-span-12 flex items-center justify-end gap-2 pt-1">
                        <button type="button" id="categoryManagerEditorCancel2"
                                class="px-4 py-2 rounded-xl border border-slate-300 bg-white text-slate-700 text-xs font-semibold hover:bg-slate-100 transition">
                            Cancelar
                        </button>
                        <button type="submit" id="categoryManagerSave"
                                class="inline-flex items-center gap-1.5 px-5 py-2 rounded-xl bg-[#00296B] hover:bg-[#003F88] text-white text-xs font-bold shadow-sm transition">
                            <span id="categoryManagerSaveSpinner" class="hidden animate-spin w-3 h-3 border-2 border-white border-t-transparent rounded-full"></span>
                            <span>Guardar</span>
                        </button>
                    </div>
                </form>
            </div>

            <!-- Árbol -->
            <div id="categoryManagerTree" class="space-y-3"></div>

            <div id="categoryManagerEmpty" class="hidden py-16 text-center text-slate-400">
                <svg class="w-12 h-12 mx-auto text-slate-300 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/></svg>
                <p class="text-sm font-semibold text-slate-600">No hay categorías configuradas</p>
                <p class="text-xs text-slate-400 mt-0.5">Usa “Nueva categoría” para crear la primera.</p>
            </div>

            <div id="categoryManagerLoading" class="hidden py-16 text-center text-slate-400">
                <svg class="animate-spin h-6 w-6 mx-auto text-[#00509D]" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path></svg>
                <p class="text-xs font-semibold mt-2">Cargando categorías...</p>
            </div>
        </div>

        <!-- Footer -->
        <div class="p-4 border-t border-slate-100 bg-slate-50 flex items-center justify-between gap-3">
            <span class="text-[11px] text-slate-400">Los cambios se guardan al instante.</span>
            <button type="button" id="categoryManagerDone"
                    class="px-5 py-2 rounded-xl bg-[#00296B] hover:bg-[#003F88] text-white text-xs font-bold shadow-xs transition">
                Listo
            </button>
        </div>
    </div>

    @Html.AntiForgeryToken()
</div>

<script>
    (function () {
        'use strict';

        var modal = document.getElementById('categoryManagerModal');
        if (!modal || modal.dataset.bound === 'true') return;
        modal.dataset.bound = 'true';

        var els = {
            search: document.getElementById('categoryManagerSearch'),
            newBtn: document.getElementById('categoryManagerNew'),
            alert: document.getElementById('categoryManagerAlert'),
            editor: document.getElementById('categoryManagerEditor'),
            editorTitle: document.getElementById('categoryManagerEditorTitle'),
            editorCancel: document.getElementById('categoryManagerEditorCancel'),
            editorCancel2: document.getElementById('categoryManagerEditorCancel2'),
            form: document.getElementById('categoryManagerForm'),
            id: document.getElementById('categoryManagerId'),
            name: document.getElementById('categoryManagerName'),
            parent: document.getElementById('categoryManagerParent'),
            parentHint: document.getElementById('categoryManagerParentHint'),
            order: document.getElementById('categoryManagerOrder'),
            showInMenu: document.getElementById('categoryManagerShowInMenu'),
            isActive: document.getElementById('categoryManagerIsActive'),
            description: document.getElementById('categoryManagerDescription'),
            save: document.getElementById('categoryManagerSave'),
            saveSpinner: document.getElementById('categoryManagerSaveSpinner'),
            tree: document.getElementById('categoryManagerTree'),
            empty: document.getElementById('categoryManagerEmpty'),
            loading: document.getElementById('categoryManagerLoading'),
            close: document.getElementById('categoryManagerClose'),
            done: document.getElementById('categoryManagerDone')
        };

        var categories = [];
        var editingChildren = false;

        function token() {
            var input = modal.querySelector('input[name="__RequestVerificationToken"]');
            return input ? input.value : '';
        }

        function escapeHtml(text) {
            if (text === null || text === undefined) return '';
            return String(text)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#039;');
        }

        function toast(message, type) {
            if (typeof window.showToast === 'function') {
                window.showToast(message, type || 'success');
            }
        }

        function showAlert(message, type) {
            if (!els.alert) return;
            if (!message) {
                els.alert.classList.add('hidden');
                els.alert.textContent = '';
                return;
            }

            els.alert.className = 'mb-4 rounded-xl border px-4 py-3 text-xs font-semibold ' +
                (type === 'error'
                    ? 'border-rose-200 bg-rose-50 text-rose-700'
                    : 'border-emerald-200 bg-emerald-50 text-emerald-700');
            els.alert.textContent = message;
        }

        function setLoading(loading) {
            els.loading?.classList.toggle('hidden', !loading);
            if (loading) els.empty?.classList.add('hidden');
        }

        function byOrder(a, b) {
            return (a.order || 0) - (b.order || 0) || String(a.name).localeCompare(String(b.name));
        }

        function matchesSearch(category, term) {
            if (!term) return true;
            return String(category.name || '').toLowerCase().indexOf(term) !== -1 ||
                String(category.slug || '').toLowerCase().indexOf(term) !== -1;
        }

        function filteredCategories() {
            var term = (els.search?.value || '').trim().toLowerCase();
            if (!term) return categories;

            var matchIds = new Set();
            categories.forEach(function (category) {
                if (matchesSearch(category, term)) matchIds.add(category.id);
            });

            // Incluye el padre cuando coincide una subcategoría y viceversa.
            categories.forEach(function (category) {
                if (category.parentId && matchIds.has(category.id)) matchIds.add(category.parentId);
            });

            return categories.filter(function (category) { return matchIds.has(category.id); });
        }

        function render() {
            if (!els.tree) return;

            var visible = filteredCategories();
            var parents = visible.filter(function (c) { return !c.parentId; }).sort(byOrder);
            var children = visible.filter(function (c) { return !!c.parentId; });
            var parentIds = new Set(parents.map(function (p) { return p.id; }));
            var orphans = children.filter(function (c) { return !parentIds.has(c.parentId); }).sort(byOrder);

            els.tree.innerHTML = '';

            var hasAny = parents.length > 0 || children.length > 0;
            els.empty?.classList.toggle('hidden', hasAny || categories.length > 0);
            if (categories.length === 0) {
                els.empty?.classList.remove('hidden');
            }

            parents.forEach(function (parent) {
                var parentChildren = children.filter(function (c) { return c.parentId === parent.id; }).sort(byOrder);
                els.tree.appendChild(renderParent(parent, parentChildren));
            });

            if (orphans.length > 0) {
                var orphanCard = document.createElement('div');
                orphanCard.className = 'rounded-2xl border border-amber-200 bg-amber-50/60 p-4';
                orphanCard.innerHTML =
                    '<p class="text-xs font-bold text-amber-800 mb-2">Subcategorías sin categoría principal visible</p>' +
                    '<div class="space-y-2">' + orphans.map(function (child) {
                        return renderChild(child, true);
                    }).join('') + '</div>';
                els.tree.appendChild(orphanCard);
            }

            if (!hasAny && categories.length > 0) {
                var noResults = document.createElement('div');
                noResults.className = 'py-12 text-center text-slate-400';
                noResults.innerHTML = '<p class="text-sm font-semibold text-slate-600">Sin resultados</p><p class="text-xs text-slate-400 mt-0.5">Prueba con otro término de búsqueda.</p>';
                els.tree.appendChild(noResults);
            }

            bindTreeActions();
        }

        function renderParent(parent, children) {
            var card = document.createElement('div');
            card.className = 'rounded-2xl border border-slate-200 bg-white p-4 shadow-2xs';
            card.setAttribute('data-category-id', parent.id);

            var childrenHtml = children.length > 0
                ? '<div class="mt-3 ml-6 space-y-2">' + children.map(function (child) { return renderChild(child, false); }).join('') + '</div>'
                : '<p class="mt-3 ml-6 text-[11px] italic text-slate-400">Sin subcategorías. Usa “+ Subcategoría” para añadir una.</p>';

            card.innerHTML =
                '<div class="flex flex-wrap items-start justify-between gap-3">' +
                    '<div class="flex items-start gap-3 min-w-0">' +
                        '<span class="w-9 h-9 rounded-xl bg-[#00296B]/10 text-[#00296B] font-bold text-xs flex items-center justify-center shrink-0">#' + (parent.order || 0) + '</span>' +
                        '<div class="min-w-0">' +
                            '<div class="flex items-center gap-2 flex-wrap">' +
                                '<h4 class="font-bold text-slate-800 text-sm">' + escapeHtml(parent.name) + '</h4>' +
                                '<span class="text-[10px] text-slate-400 font-mono bg-slate-100 px-2 py-0.5 rounded-md">/' + escapeHtml(parent.slug) + '</span>' +
                                '<span class="text-[10px] uppercase font-bold tracking-wider px-2 py-0.5 rounded-full bg-[#00509D]/10 text-[#00509D]">Categoría principal</span>' +
                            '</div>' +
                            '<div class="flex items-center gap-2 text-[11px] text-slate-500 mt-1 flex-wrap">' +
                                '<span>' + children.length + ' subcategoría(s)</span>' +
                                '<span>•</span>' +
                                '<span class="' + (parent.showInMenu ? 'text-emerald-600 font-semibold' : 'text-slate-400') + '">' + (parent.showInMenu ? 'Visible en menú' : 'Oculta del menú') + '</span>' +
                                '<span>•</span>' +
                                '<span class="' + (parent.isActive ? 'text-emerald-600 font-semibold' : 'text-rose-500') + '">' + (parent.isActive ? 'Activa' : 'Inactiva') + '</span>' +
                            '</div>' +
                        '</div>' +
                    '</div>' +
                    '<div class="flex items-center gap-1.5">' +
                        '<button type="button" data-category-action="add-sub" data-category-id="' + parent.id + '" class="inline-flex items-center gap-1 px-2.5 py-1.5 rounded-lg bg-blue-50 hover:bg-blue-100 text-[#003F88] font-bold text-[11px] transition">' +
                            '<svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg> Subcategoría' +
                        '</button>' +
                        '<button type="button" data-category-action="edit" data-category-id="' + parent.id + '" class="p-2 text-slate-500 hover:text-[#00509D] hover:bg-blue-50 rounded-lg transition" title="Editar categoría">' +
                            '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>' +
                        '</button>' +
                        '<button type="button" data-category-action="delete" data-category-id="' + parent.id + '" class="p-2 text-slate-400 hover:text-rose-600 hover:bg-rose-50 rounded-lg transition" title="Eliminar categoría">' +
                            '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>' +
                        '</button>' +
                    '</div>' +
                '</div>' +
                childrenHtml;

            return card;
        }

        function renderChild(child, isOrphan) {
            return '<div class="flex flex-wrap items-center justify-between gap-2 p-2.5 rounded-xl border ' +
                (isOrphan ? 'border-amber-200 bg-white' : 'border-slate-200 bg-white') + '" data-category-id="' + child.id + '">' +
                    '<div class="flex items-center gap-2 min-w-0">' +
                        '<span class="w-6 h-6 rounded-md bg-slate-100 text-slate-500 font-bold text-[10px] flex items-center justify-center shrink-0">#' + (child.order || 0) + '</span>' +
                        '<div class="min-w-0">' +
                            '<div class="flex items-center gap-2 flex-wrap">' +
                                '<span class="font-semibold text-slate-800 text-xs">' + escapeHtml(child.name) + '</span>' +
                                '<span class="text-[10px] text-slate-400 font-mono">/' + escapeHtml(child.slug) + '</span>' +
                                '<span class="text-[9px] uppercase font-bold tracking-wider px-1.5 py-0.5 rounded-full bg-slate-100 text-slate-600">Subcategoría</span>' +
                            '</div>' +
                            '<div class="flex items-center gap-2 text-[10px] text-slate-500 mt-0.5">' +
                                '<span class="' + (child.showInMenu ? 'text-emerald-600 font-semibold' : 'text-slate-400') + '">' + (child.showInMenu ? 'Visible' : 'Oculta') + '</span>' +
                                '<span>•</span>' +
                                '<span class="' + (child.isActive ? 'text-emerald-600 font-semibold' : 'text-rose-500') + '">' + (child.isActive ? 'Activa' : 'Inactiva') + '</span>' +
                            '</div>' +
                        '</div>' +
                    '</div>' +
                    '<div class="flex items-center gap-1">' +
                        '<button type="button" data-category-action="edit" data-category-id="' + child.id + '" class="p-1.5 text-slate-500 hover:text-[#00509D] hover:bg-blue-50 rounded-lg transition" title="Editar subcategoría">' +
                            '<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>' +
                        '</button>' +
                        '<button type="button" data-category-action="delete" data-category-id="' + child.id + '" class="p-1.5 text-slate-400 hover:text-rose-600 hover:bg-rose-50 rounded-lg transition" title="Eliminar subcategoría">' +
                            '<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>' +
                        '</button>' +
                    '</div>' +
                '</div>';
        }

        function bindTreeActions() {
            els.tree.querySelectorAll('[data-category-action]').forEach(function (button) {
                button.addEventListener('click', function () {
                    var action = button.getAttribute('data-category-action');
                    var id = button.getAttribute('data-category-id');
                    var category = categories.find(function (c) { return c.id === id; });
                    if (!category) return;

                    if (action === 'edit') openEditor(category);
                    else if (action === 'add-sub') openEditor(null, category.id);
                    else if (action === 'delete') deleteCategory(category);
                });
            });
        }

        function buildParentOptions(selectedId, excludeId) {
            if (!els.parent) return;

            var parents = categories.filter(function (c) { return !c.parentId && c.id !== excludeId; }).sort(byOrder);
            els.parent.innerHTML = '<option value="">— Sin padre (categoría raíz) —</option>' +
                parents.map(function (parent) {
                    return '<option value="' + parent.id + '"' + (parent.id === selectedId ? ' selected' : '') + '>' + escapeHtml(parent.name) + '</option>';
                }).join('');
        }

        function openEditor(category, parentId) {
            if (!els.editor) return;

            showAlert('');
            els.editor.classList.remove('hidden');
            editingChildren = false;

            if (category) {
                var childCount = categories.filter(function (c) { return c.parentId === category.id; }).length;
                editingChildren = childCount > 0;

                if (els.id) els.id.value = category.id;
                if (els.name) els.name.value = category.name || '';
                if (els.order) els.order.value = category.order || 0;
                if (els.showInMenu) els.showInMenu.checked = !!category.showInMenu;
                if (els.isActive) els.isActive.checked = !!category.isActive;
                if (els.description) els.description.value = category.description || '';
                buildParentOptions(category.parentId || '', category.id);

                if (els.editorTitle) {
                    els.editorTitle.textContent = category.parentId ? 'Editar subcategoría' : 'Editar categoría principal';
                }

                if (els.parent) els.parent.disabled = editingChildren;
                if (els.parentHint) {
                    els.parentHint.classList.toggle('hidden', !editingChildren);
                    els.parentHint.textContent = editingChildren
                        ? 'No puedes convertir en subcategoría una categoría que ya tiene subcategorías.'
                        : '';
                }
            } else {
                if (els.id) els.id.value = '';
                if (els.name) els.name.value = '';
                if (els.order) els.order.value = nextOrder(parentId);
                if (els.showInMenu) els.showInMenu.checked = true;
                if (els.isActive) els.isActive.checked = true;
                if (els.description) els.description.value = '';
                buildParentOptions(parentId || '', null);

                if (els.editorTitle) {
                    els.editorTitle.textContent = parentId ? 'Nueva subcategoría' : 'Nueva categoría principal';
                }

                if (els.parent) els.parent.disabled = false;
                if (els.parentHint) {
                    els.parentHint.classList.add('hidden');
                    els.parentHint.textContent = '';
                }
            }

            els.editor.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            window.setTimeout(function () { els.name?.focus(); }, 60);
        }

        function nextOrder(parentId) {
            var siblings = categories.filter(function (c) {
                return parentId ? c.parentId === parentId : !c.parentId;
            });
            var max = siblings.reduce(function (acc, c) { return Math.max(acc, c.order || 0); }, 0);
            return max + 1;
        }

        function closeEditor() {
            els.editor?.classList.add('hidden');
            if (els.parent) els.parent.disabled = false;
            if (els.parentHint) els.parentHint.classList.add('hidden');
            showAlert('');
        }

        async function loadCategories() {
            setLoading(true);
            try {
                var response = await fetch('/admin/categorias/listado', { headers: { 'Accept': 'application/json' } });
                if (!response.ok) throw new Error('No se pudieron cargar las categorías.');
                categories = await response.json();
                if (!Array.isArray(categories)) categories = [];
                render();
            } catch (error) {
                showAlert(error.message || 'No se pudieron cargar las categorías.', 'error');
            } finally {
                setLoading(false);
            }
        }

        async function saveCategory(event) {
            event.preventDefault();

            var name = (els.name?.value || '').trim();
            if (!name) {
                showAlert('El nombre de la categoría es obligatorio.', 'error');
                els.name?.focus();
                return;
            }

            var id = els.id?.value || '';
            var parentId = els.parent?.value || '';
            var payload = {
                id: id || null,
                name: name,
                parentId: parentId || null,
                description: els.description?.value || null,
                order: parseInt(els.order?.value || '0', 10) || 0,
                showInMenu: !!els.showInMenu?.checked,
                isActive: !!els.isActive?.checked
            };

            setSaving(true);
            showAlert('');

            try {
                var response = await fetch('/admin/categorias/guardar', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token()
                    },
                    body: JSON.stringify(payload)
                });

                var data = await response.json().catch(function () { return {}; });
                if (!response.ok || !data.success) {
                    throw new Error(data.message || 'No se pudo guardar la categoría.');
                }

                closeEditor();
                await loadCategories();
                emitChanged(id ? 'updated' : 'created', data.category);
                toast(id ? 'Categoría actualizada correctamente.' : 'Categoría creada correctamente.', 'success');
            } catch (error) {
                showAlert(error.message || 'No se pudo guardar la categoría.', 'error');
            } finally {
                setSaving(false);
            }
        }

        async function deleteCategory(category) {
            var children = categories.filter(function (c) { return c.parentId === category.id; });
            var message = children.length > 0
                ? '¿Eliminar "' + category.name + '" y sus ' + children.length + ' subcategoría(s)? Esta acción no se puede deshacer.'
                : '¿Eliminar la categoría "' + category.name + '"? Esta acción no se puede deshacer.';

            var confirmed = await window.appConfirm(message, {
                title: 'Eliminar categoría',
                type: 'danger',
                acceptLabel: 'Sí, eliminar'
            });

            if (!confirmed) return;

            try {
                var response = await fetch('/admin/categorias/eliminar-ajax/' + encodeURIComponent(category.id) + '?deleteChildren=true', {
                    method: 'POST',
                    headers: { 'RequestVerificationToken': token() }
                });

                var data = await response.json().catch(function () { return {}; });
                if (!response.ok || !data.success) {
                    throw new Error(data.message || 'No se pudo eliminar la categoría.');
                }

                await loadCategories();
                emitChanged('deleted', category);
                toast('Categoría eliminada correctamente.', 'success');
            } catch (error) {
                showAlert(error.message || 'No se pudo eliminar la categoría.', 'error');
            }
        }

        function setSaving(saving) {
            if (els.save) els.save.disabled = saving;
            if (els.save) els.save.classList.toggle('opacity-60', saving);
            if (els.save) els.save.classList.toggle('cursor-not-allowed', saving);
            els.saveSpinner?.classList.toggle('hidden', !saving);
        }

        function emitChanged(type, category) {
            var detail = { categories: categories.slice(), meta: { type: type, category: category || null } };
            window.dispatchEvent(new CustomEvent('category-manager:changed', { detail: detail }));
        }

        function open() {
            showAlert('');
            closeEditor();
            modal.classList.remove('hidden');
            modal.style.display = 'flex';
            document.body.classList.add('overflow-hidden');
            if (els.search) els.search.value = '';
            loadCategories();
        }

        function close() {
            modal.classList.add('hidden');
            modal.style.display = 'none';
            document.body.classList.remove('overflow-hidden');
        }

        els.newBtn?.addEventListener('click', function () { openEditor(null, null); });
        els.editorCancel?.addEventListener('click', closeEditor);
        els.editorCancel2?.addEventListener('click', closeEditor);
        els.form?.addEventListener('submit', saveCategory);
        els.search?.addEventListener('input', render);
        els.close?.addEventListener('click', close);
        els.done?.addEventListener('click', close);

        document.addEventListener('keydown', function (event) {
            if (event.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
                close();
            }
        });

        // API pública reutilizable.
        window.categoryManager = {
            open: open,
            close: close,
            refresh: loadCategories,
            getCategories: function () { return categories.slice(); }
        };

        // Cualquier botón con data-open-category-manager abre el modal.
        document.querySelectorAll('[data-open-category-manager]').forEach(function (button) {
            button.addEventListener('click', function (event) {
                event.preventDefault();
                open();
            });
        });
    })();
</script>
