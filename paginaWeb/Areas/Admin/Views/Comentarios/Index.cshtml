@model List<Domine.Entities.Comment>
@{
    ViewData["Title"] = "Moderación de Comentarios";
    var estado = (string)ViewBag.Estado;
}

<div class="space-y-6">
    <!-- Pestañas de filtro -->
    <div class="flex items-center gap-2 border-b border-slate-200 pb-3">
        <a href="/admin/comentarios" class="px-4 py-2 rounded-xl text-xs font-semibold transition @(estado == "pendiente" ? "bg-[#00296B] text-white shadow-xs" : "bg-white text-slate-600 hover:bg-slate-100")">
            Pendientes
        </a>
        <a href="/admin/comentarios?estado=aprobado" class="px-4 py-2 rounded-xl text-xs font-semibold transition @(estado == "aprobado" ? "bg-[#00296B] text-white shadow-xs" : "bg-white text-slate-600 hover:bg-slate-100")">
            Aprobados
        </a>
        <a href="/admin/comentarios?estado=rechazado" class="px-4 py-2 rounded-xl text-xs font-semibold transition @(estado == "rechazado" ? "bg-[#00296B] text-white shadow-xs" : "bg-white text-slate-600 hover:bg-slate-100")">
            Rechazados
        </a>
        <a href="/admin/comentarios?estado=todos" class="px-4 py-2 rounded-xl text-xs font-semibold transition @(estado == "todos" ? "bg-[#00296B] text-white shadow-xs" : "bg-white text-slate-600 hover:bg-slate-100")">
            Todos
        </a>
    </div>

    <!-- Lista de comentarios -->
    <div class="bg-white rounded-2xl border border-slate-200/80 shadow-xs overflow-hidden">
        @if (!Model.Any())
        {
            <div class="p-12 text-center text-slate-400">
                <svg class="w-12 h-12 mx-auto text-slate-300 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"/></svg>
                <p class="font-medium text-slate-600">No hay comentarios en este filtro.</p>
            </div>
        }
        else
        {
            <div class="divide-y divide-slate-100">
                @foreach (var c in Model)
                {
                    <div class="p-6 hover:bg-slate-50/50 transition flex flex-col md:flex-row md:items-start justify-between gap-4">
                        <div class="space-y-2 flex-1">
                            <div class="flex items-center gap-3">
                                <span class="font-bold text-slate-900 text-sm">@c.Name</span>
                                <span class="text-xs text-slate-400 font-mono">@c.CreatedAt.ToString("g")</span>
                                @if (c.Status == Domine.Entities.CommentStatus.Pendiente)
                                {
                                    <span class="px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-amber-50 text-amber-700 border border-amber-200">Pendiente</span>
                                }
                                else if (c.Status == Domine.Entities.CommentStatus.Aprobado)
                                {
                                    <span class="px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">Aprobado</span>
                                }
                                else
                                {
                                    <span class="px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-rose-50 text-rose-700 border border-rose-200">Rechazado</span>
                                }
                            </div>

                            <p class="text-sm text-slate-700 bg-slate-50 p-3.5 rounded-xl border border-slate-100 leading-relaxed font-sans">
                                @c.Content
                            </p>
                        </div>

                        <!-- Acciones -->
                        <div class="flex items-center gap-2 flex-shrink-0 pt-2 md:pt-0">
                            @if (c.Status != Domine.Entities.CommentStatus.Aprobado)
                            {
                                <form method="post" action="/admin/comentarios/aprobar/@c.Id">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="returnEstado" value="@estado" />
                                    <button type="submit" class="px-3 py-1.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-semibold shadow-xs transition">
                                        ✓ Aprobar
                                    </button>
                                </form>
                            }

                            @if (c.Status != Domine.Entities.CommentStatus.Rechazado)
                            {
                                <form method="post" action="/admin/comentarios/rechazar/@c.Id">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="returnEstado" value="@estado" />
                                    <button type="submit" class="px-3 py-1.5 rounded-xl bg-amber-600 hover:bg-amber-700 text-white text-xs font-semibold shadow-xs transition">
                                        ✕ Rechazar
                                    </button>
                                </form>
                            }

                            <form method="post" action="/admin/comentarios/eliminar/@c.Id" onsubmit="return confirm('¿Eliminar definitivamente este comentario?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="returnEstado" value="@estado" />
                                <button type="submit" class="p-1.5 text-slate-400 hover:text-rose-600 rounded-lg transition" title="Eliminar">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                                </button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>
