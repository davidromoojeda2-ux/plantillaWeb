@model paginaWeb.Areas.Admin.Models.ArticleFormViewModel

<script src="~/js/content-blocks-editor.js" asp-append-version="true"></script>
<script src="~/js/document-manager.js" asp-append-version="true"></script>
<script src="~/js/admin-slug.js" asp-append-version="true"></script>
<script>

    const coverImageUrlInput = document.getElementById('coverImageUrlInput');
    const coverImageIdInput = document.getElementById('coverImageIdInput');
    const coverPreviewContainer = document.getElementById('coverPreviewContainer');
    const coverPreviewImg = document.getElementById('coverPreviewImg');
    const coverFullViewLink = document.getElementById('coverFullViewLink');
    const toggleFitBtn = document.getElementById('toggleFitBtn');
    const removeCoverBtn = document.getElementById('removeCoverBtn');

    window.updateCoverPreview = function(url) {
        if (url) {
            coverPreviewImg.src = url;
            coverPreviewImg.referrerPolicy = 'no-referrer';
            coverPreviewImg.classList.remove('opacity-30');
            document.getElementById('coverErrorBadge')?.classList.add('hidden');
            if (coverFullViewLink) coverFullViewLink.href = url;
            coverPreviewContainer.classList.remove('hidden');
        } else {
            coverPreviewContainer.classList.add('hidden');
            coverImageIdInput.value = '';
            if (coverFullViewLink) coverFullViewLink.href = '#';
        }
        if (typeof window.checkCurrentCoverUsage === 'function') {
            window.checkCurrentCoverUsage();
        }
    };

    // Alternar ajuste de imagen (cover vs contain)
    toggleFitBtn?.addEventListener('click', () => {
        if (coverPreviewImg.classList.contains('object-cover')) {
            coverPreviewImg.classList.remove('object-cover');
            coverPreviewImg.classList.add('object-contain');
            toggleFitBtn.title = "Modo: Ajustar completa (Clic para Llenar 16:9)";
        } else {
            coverPreviewImg.classList.remove('object-contain');
            coverPreviewImg.classList.add('object-cover');
            toggleFitBtn.title = "Modo: Llenar 16:9 (Clic para Ajustar completa)";
        }
    });

    // Actualizar vista previa cuando el usuario edite la ruta o URL manualmente
    coverImageUrlInput?.addEventListener('input', () => {
        window.updateCoverPreview(coverImageUrlInput.value.trim());
    });

    removeCoverBtn?.addEventListener('click', () => {
        coverImageIdInput.value = '';
        coverImageUrlInput.value = '';
        window.updateCoverPreview('');
    });

    // Filtrado dinámico de subcategorías según la categoría seleccionada
    const categorySelect = document.getElementById('categorySelect');
    const subcategorySelect = document.getElementById('subcategorySelect');

    window.filterSubcategories = function() {
        const selectedCat = categorySelect?.value;
        const currentSubVal = subcategorySelect?.value;
        let currentSubStillValid = false;

        Array.from(subcategorySelect?.options || []).forEach((opt, idx) => {
            if (idx === 0) return; // Opción "-- Ninguna --"
            const parent = opt.getAttribute('data-parent');
            if (!selectedCat || parent === selectedCat) {
                opt.hidden = false;
                opt.disabled = false;
                if (opt.value === currentSubVal) currentSubStillValid = true;
            } else {
                opt.hidden = true;
                opt.disabled = true;
            }
        });

        if (!currentSubStillValid && selectedCat && subcategorySelect) {
            subcategorySelect.value = '';
        }
    };

    categorySelect?.addEventListener('change', window.filterSubcategories);
    window.filterSubcategories();

    // Reconstruye los selects de taxonomía cuando el modal de categorías cambia los datos.
    window.addEventListener('category-manager:changed', (event) => {
        const categories = Array.isArray(event.detail?.categories) ? event.detail.categories : [];
        if (!categorySelect || !subcategorySelect) return;

        const currentCategory = categorySelect.value;
        const currentSubcategory = subcategorySelect.value;

        const parents = categories
            .filter(c => !c.parentId)
            .sort((a, b) => (a.order || 0) - (b.order || 0));
        const children = categories.filter(c => !!c.parentId);

        categorySelect.innerHTML = '<option value="">-- Seleccionar Categoría --</option>';
        parents.forEach(c => {
            const option = document.createElement('option');
            option.value = c.id;
            option.textContent = c.name;
            categorySelect.appendChild(option);
        });

        subcategorySelect.innerHTML = '<option value="">-- Ninguna --</option>';
        children.forEach(c => {
            const option = document.createElement('option');
            option.value = c.id;
            option.textContent = c.name;
            option.dataset.parent = c.parentId;
            subcategorySelect.appendChild(option);
        });

        if (Array.from(categorySelect.options).some(o => o.value === currentCategory)) {
            categorySelect.value = currentCategory;
        }
        if (Array.from(subcategorySelect.options).some(o => o.value === currentSubcategory)) {
            subcategorySelect.value = currentSubcategory;
        }

        window.filterSubcategories();
    });

    // Validación editorial: campos, estructura y enlaces caídos.
    (function () {
        const card = document.getElementById('articleValidationCard');
        const button = document.getElementById('btnValidateArticle');
        const label = document.getElementById('btnValidateArticleLabel');
        const results = document.getElementById('validationResults');
        const errorsBox = document.getElementById('validationErrors');
        const warningsBox = document.getElementById('validationWarnings');
        const linksSection = document.getElementById('validationLinksSection');
        const linksBox = document.getElementById('validationLinks');
        const cleanBox = document.getElementById('validationClean');
        const summaryBadge = document.getElementById('validationSummaryBadge');
        const aiButton = document.getElementById('btnAiCorrect');
        const aiLabel = document.getElementById('btnAiCorrectLabel');
        const form = document.getElementById('articleForm');

        if (!card || !button || !results || !form) return;

        const validateUrl = card.getAttribute('data-validate-url');
        const correctUrl = card.getAttribute('data-correct-url');
        const removeLinksUrl = card.getAttribute('data-remove-links-url');
        const applyLinkActionsUrl = card.getAttribute('data-apply-link-actions-url');
        if (!validateUrl) return;

        function getToken() {
            return form.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
        }

        let lastIssues = [];

        // Observaciones que la IA no puede resolver por sí sola (requieren elección
        // de categoría, portada o estado).
        const MANUAL_ONLY_CODES = new Set(['category', 'cover', 'status']);

        function correctableIssues() {
            return lastIssues.filter(issue => !MANUAL_ONLY_CODES.has(issue.code));
        }

        // Usa el diálogo estándar del sistema (app-dialogs.js). Si por alguna razón
        // no estuviera cargado, conserva el confirm nativo como último recurso.
        function confirmDialog(message, options) {
            if (typeof window.appConfirm === 'function') {
                return window.appConfirm(message, options || {});
            }
            return Promise.resolve(window.confirm(message));
        }

        function alertDialog(message, options) {
            if (typeof window.appAlert === 'function') {
                return window.appAlert(message, options || {});
            }
            window.alert(message);
            return Promise.resolve();
        }

        function setBadge(text, classes) {
            summaryBadge.textContent = text;
            summaryBadge.className = 'px-2 py-0.5 rounded-full text-[10px] font-bold ' + classes;
        }

        function highlight(element) {
            if (!element) return;
            const previous = element.style.boxShadow;
            element.style.transition = 'box-shadow 0.2s ease';
            element.style.boxShadow = '0 0 0 3px rgba(245, 158, 11, 0.55)';
            setTimeout(() => {
                element.style.boxShadow = previous || '';
            }, 1800);
        }

        function focusField(id) {
            const field = document.getElementById(id);
            if (!field) return false;

            field.scrollIntoView({ behavior: 'smooth', block: 'center' });
            field.focus?.({ preventScroll: true });
            highlight(field);
            return true;
        }

        function focusBlock(index) {
            const editor = window.contentBlocksEditor;
            if (editor && typeof editor.focusBlock === 'function' && editor.focusBlock(index)) {
                return true;
            }

            const block = document.querySelector(
                '#contentBlocksEditor .cbe-block[data-index="' + index + '"]');
            if (!block) return false;

            block.scrollIntoView({ behavior: 'smooth', block: 'center' });
            highlight(block);
            return true;
        }

        // Lleva al usuario al punto observado. Si una observación abarca varios
        // bloques, cada clic avanza al siguiente.
        function goToIssue(issue, item) {
            if (issue.field && focusField(issue.field)) return;

            const indexes = Array.isArray(issue.blockIndexes) ? issue.blockIndexes : [];
            if (indexes.length > 0) {
                const next = Number(item.dataset.nextTarget || 0) % indexes.length;
                item.dataset.nextTarget = String(next + 1);
                if (focusBlock(indexes[next])) return;
            }

            if (issue.url) {
                const editor = document.getElementById('contentBlocksEditor');
                editor?.scrollIntoView({ behavior: 'smooth', block: 'center' });
                highlight(editor);
            }
        }

        function createIssueItem(issue) {
            const item = document.createElement('li');
            const hasTarget = !!issue.field
                || (Array.isArray(issue.blockIndexes) && issue.blockIndexes.length > 0);
            item.className = 'rounded px-1 -mx-1 ' + (hasTarget
                ? 'cursor-pointer hover:bg-black/5 focus:outline-none focus:ring-2 focus:ring-amber-400'
                : '');
            item.textContent = issue.message;

            if (hasTarget) {
                item.tabIndex = 0;
                item.title = 'Ir al punto observado';
                item.setAttribute('role', 'button');

                const arrow = document.createElement('span');
                arrow.className = 'ml-1 text-[10px] font-bold opacity-70';
                arrow.textContent = '→';
                item.appendChild(arrow);

                if (issue.code === 'link' && issue.severity === 'error' && issue.url
                    && Array.isArray(issue.blockIndexes) && issue.blockIndexes.length > 0) {
                    const removeLink = document.createElement('button');
                    removeLink.type = 'button';
                    removeLink.className = 'ml-2 text-[10px] font-bold text-rose-700 underline hover:text-rose-900';
                    removeLink.textContent = 'Quitar enlace';
                    removeLink.addEventListener('click', async event => {
                        event.stopPropagation();

                        const accepted = await confirmDialog(
                            '¿Quitar el enlace caído?\n\n' + issue.url +
                            '\n\nSe conservará el texto visible.',
                            {
                                title: 'Quitar enlace',
                                type: 'danger',
                                acceptLabel: 'Quitar enlace',
                                cancelLabel: 'Rechazar'
                            });

                        if (!accepted) return;

                        try {
                            await removeBrokenLinks([issue.url]);
                        } catch (error) {
                            await alertDialog(error.message || 'No se pudo quitar el enlace.', {
                                title: 'No se pudo quitar el enlace',
                                type: 'danger'
                            });
                        }
                    });
                    removeLink.addEventListener('keydown', event => event.stopPropagation());
                    item.appendChild(removeLink);
                }

                const activate = () => goToIssue(issue, item);
                item.addEventListener('click', activate);
                item.addEventListener('keydown', event => {
                    if (event.key !== 'Enter' && event.key !== ' ') return;
                    event.preventDefault();
                    activate();
                });
            }

            return item;
        }

        function renderIssues(container, title, issues) {
            container.innerHTML = '';
            if (!issues || issues.length === 0) {
                container.classList.add('hidden');
                return;
            }

            const heading = document.createElement('p');
            heading.className = 'font-bold mb-1';
            heading.textContent = title;
            container.appendChild(heading);

            const list = document.createElement('ul');
            list.className = 'space-y-1 list-disc list-inside';
            issues.forEach(issue => list.appendChild(createIssueItem(issue)));
            container.appendChild(list);
            container.classList.remove('hidden');
        }

        // Respaldo para respuestas antiguas que solo traen errores y avisos.
        function renderList(container, title, items) {
            renderIssues(container, title,
                (items || []).map(message => ({ message, blockIndexes: [] })));
        }

        function statusMeta(status) {
            switch (status) {
                case 'ok':
                    return { label: 'Correcto', classes: 'bg-emerald-100 text-emerald-800 border-emerald-200' };
                case 'restringido':
                    return { label: 'Restringido', classes: 'bg-amber-100 text-amber-800 border-amber-200' };
                case 'caido':
                    return { label: 'Caído', classes: 'bg-rose-100 text-rose-800 border-rose-200' };
                case 'sin-respuesta':
                    return { label: 'Sin respuesta', classes: 'bg-rose-100 text-rose-800 border-rose-200' };
                case 'error-servidor':
                    return { label: 'Error del servidor', classes: 'bg-rose-100 text-rose-800 border-rose-200' };
                default:
                    return { label: status || 'Desconocido', classes: 'bg-slate-100 text-slate-700 border-slate-200' };
            }
        }

        function renderLinks(links) {
            linksBox.innerHTML = '';
            if (!links || links.length === 0) {
                linksSection.classList.add('hidden');
                return;
            }

            links.forEach(link => {
                const meta = statusMeta(link.status);
                const row = document.createElement('div');
                row.className = 'flex items-center gap-2 rounded-lg border border-slate-200 bg-slate-50 px-2 py-1.5';

                const anchor = document.createElement('a');
                anchor.href = link.url;
                anchor.target = '_blank';
                anchor.rel = 'noopener noreferrer';
                anchor.className = 'min-w-0 flex-1 truncate text-[11px] text-[#00509D] hover:underline';
                anchor.textContent = link.url;
                anchor.title = link.url;

                const badge = document.createElement('span');
                badge.className = 'shrink-0 rounded-full border px-1.5 py-0.5 text-[9px] font-bold ' + meta.classes;
                badge.textContent = meta.label + (link.statusCode ? ' · ' + link.statusCode : '');

                row.appendChild(anchor);
                row.appendChild(badge);
                linksBox.appendChild(row);
            });

            linksSection.classList.remove('hidden');
        }

        async function validateArticle() {
            const token = getToken();
            const payload = {
                title: document.getElementById('titleInput')?.value || document.getElementById('Title')?.value || '',
                summary: document.getElementById('Summary')?.value || '',
                slug: document.getElementById('slugInput')?.value || document.getElementById('Slug')?.value || '',
                author: document.getElementById('Author')?.value || '',
                categoryId: document.getElementById('categorySelect')?.value || document.getElementById('CategoryId')?.value || '',
                coverImageUrl: document.getElementById('coverImageUrlInput')?.value || document.getElementById('CoverImageUrl')?.value || '',
                status: document.getElementById('Status')?.value || '',
                blocksJson: document.getElementById('BlocksJsonInput')?.value || '[]'
            };

            button.disabled = true;
            const originalLabel = label.textContent;
            label.textContent = 'Validando…';
            window.contentBlocksEditor?.clearIssueMarks?.();

            try {
                const response = await fetch(validateUrl, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify(payload)
                });

                if (!response.ok) {
                    throw new Error('La validación no está disponible (HTTP ' + response.status + ').');
                }

                const data = await response.json();
                results.classList.remove('hidden');

                lastIssues = Array.isArray(data.issues) ? data.issues : [];
                if (lastIssues.length === 0) {
                    lastIssues = [
                        ...(Array.isArray(data.errors) ? data.errors : []).map(message => ({
                            severity: 'error', code: 'general', message, blockIndexes: []
                        })),
                        ...(Array.isArray(data.warnings) ? data.warnings : []).map(message => ({
                            severity: 'warning', code: 'general', message, blockIndexes: []
                        }))
                    ];
                }

                const errorIssues = lastIssues.filter(issue => issue.severity === 'error');
                const warningIssues = lastIssues.filter(issue => issue.severity === 'warning');

                renderIssues(errorsBox, 'Errores', errorIssues);
                renderIssues(warningsBox, 'Avisos', warningIssues);
                renderLinks(data.links);
                window.contentBlocksEditor?.markIssues?.(lastIssues);

                aiButton?.classList.toggle('hidden', correctableIssues().length === 0);
                cleanBox.classList.toggle('hidden', lastIssues.length > 0);

                if (errorIssues.length > 0) {
                    setBadge(errorIssues.length + (errorIssues.length === 1 ? ' error' : ' errores'), 'bg-rose-100 text-rose-800 border border-rose-200');
                } else if (warningIssues.length > 0) {
                    setBadge(warningIssues.length + (warningIssues.length === 1 ? ' aviso' : ' avisos'), 'bg-amber-100 text-amber-800 border border-amber-200');
                } else {
                    setBadge('Sin problemas', 'bg-emerald-100 text-emerald-800 border border-emerald-200');
                }
            } catch (error) {
                results.classList.remove('hidden');
                lastIssues = [];
                aiButton?.classList.add('hidden');
                window.contentBlocksEditor?.clearIssueMarks?.();
                renderList(errorsBox, 'No se pudo validar', [error.message || 'Inténtalo de nuevo.']);
                warningsBox.classList.add('hidden');
                linksSection.classList.add('hidden');
                cleanBox.classList.add('hidden');
                setBadge('Error', 'bg-rose-100 text-rose-800 border border-rose-200');
            } finally {
                button.disabled = false;
                label.textContent = originalLabel || 'Validar artículo';
            }
        }

        function applyBlocksJson(blocksJson, blocks) {
            if (typeof blocksJson !== 'string' && !Array.isArray(blocks)) return;

            if (window.contentBlocksEditor?.replaceBlocks) {
                window.contentBlocksEditor.replaceBlocks(
                    Array.isArray(blocks) ? blocks : JSON.parse(blocksJson));
            } else if (typeof blocksJson === 'string') {
                // Respaldo si el navegador conserva una versión antigua del editor:
                // al menos el cuerpo se guarda con el formulario.
                const input = document.getElementById('BlocksJsonInput');
                if (input) input.value = blocksJson;
            }
        }

        function applyCorrection(data) {
            let correctedBlocks = null;
            if (typeof data.blocksJson === 'string') {
                try {
                    correctedBlocks = JSON.parse(data.blocksJson);
                } catch (error) {
                    console.warn('El cuerpo corregido no es JSON válido', error);
                    throw new Error('La IA devolvió un cuerpo no válido. Inténtalo de nuevo.');
                }
            }

            const title = document.getElementById('titleInput');
            if (title && typeof data.title === 'string') {
                title.value = data.title;
                title.dispatchEvent(new Event('input', { bubbles: true }));
            }

            const summary = document.getElementById('Summary');
            if (summary && typeof data.summary === 'string') {
                summary.value = data.summary;
                summary.dispatchEvent(new Event('input', { bubbles: true }));
            }

            if (correctedBlocks) {
                if (!Array.isArray(correctedBlocks) || correctedBlocks.length === 0) {
                    throw new Error('La IA no devolvió bloques para el artículo. Inténtalo de nuevo.');
                }

                applyBlocksJson(data.blocksJson, correctedBlocks);
            }
        }

        function shortUrl(url) {
            const value = String(url || '');
            return value.length > 90 ? value.slice(0, 87) + '…' : value;
        }

        function describeLinkAction(action) {
            const mark = action.verified ? '✓' : '✗';
            const detail = action.validation || (action.verified ? 'Verificado.' : 'No verificado.');
            const reason = action.reason ? '\n  Motivo: ' + action.reason : '';

            if (action.type === 'replace') {
                return '• Reemplazar ' + shortUrl(action.url) + ' → ' + shortUrl(action.replacement || '(sin URL)') +
                    '\n  ' + mark + ' ' + detail + reason;
            }

            return '• Quitar ' + shortUrl(action.url) + '\n  ' + mark + ' ' + detail + reason;
        }

        function confirmLinkActions(actions) {
            const lines = actions.map(describeLinkAction).join('\n\n');
            return confirmDialog(
                'La IA propone estos cambios de enlaces:\n\n' + lines +
                '\n\nSolo se aplicarán los cambios marcados con ✓. ¿Aplicar los cambios verificados?',
                {
                    title: 'Cambios de enlaces',
                    type: 'warning',
                    acceptLabel: 'Aplicar cambios',
                    cancelLabel: 'Rechazar'
                });
        }

        async function applyLinkActions(actions) {
            if (!applyLinkActionsUrl || !Array.isArray(actions) || actions.length === 0) return;

            const token = getToken();
            const response = await fetch(applyLinkActionsUrl, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify({
                    blocksJson: document.getElementById('BlocksJsonInput')?.value || '[]',
                    actions: actions.map(action => ({
                        type: action.type,
                        url: action.url,
                        replacement: action.replacement || null
                    })),
                    confirmed: true
                })
            });

            const data = await response.json().catch(() => ({}));
            if (!response.ok) {
                throw new Error(data.message || 'No se pudieron aplicar los cambios de enlaces (HTTP ' +
                    response.status + ').');
            }

            applyBlocksJson(data.blocksJson);

            if (window.showToast) {
                const applied = Number(data.applied) || 0;
                const skipped = Number(data.skipped) || 0;
                window.showToast(
                    'Se aplicaron ' + applied + ' cambio(s) de enlaces.' +
                    (skipped > 0 ? ' ' + skipped + ' no se pudieron aplicar.' : ''),
                    skipped > 0 ? 'info' : 'success');
            }

            await validateArticle();
        }

        async function removeBrokenLinks(urls) {
            if (!removeLinksUrl || !Array.isArray(urls) || urls.length === 0) return;

            const token = getToken();
            const response = await fetch(removeLinksUrl, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify({
                    blocksJson: document.getElementById('BlocksJsonInput')?.value || '[]',
                    urls,
                    confirmed: true
                })
            });

            const data = await response.json().catch(() => ({}));
            if (!response.ok) {
                throw new Error(data.message || 'No se pudieron quitar los enlaces (HTTP ' + response.status + ').');
            }

            applyBlocksJson(data.blocksJson);

            if (window.showToast) {
                window.showToast(
                    Number(data.removed) > 0
                        ? 'Se quitaron ' + data.removed + ' enlace(s) caído(s).'
                        : 'Los enlaces revisados ya no están caídos; no se quitó ninguno.',
                    'success');
            }

            await validateArticle();
        }

        async function correctWithAi() {
            if (!correctUrl) return;

            const issues = correctableIssues();
            if (issues.length === 0) {
                if (window.showToast) {
                    window.showToast('Las observaciones actuales requieren corrección manual.', 'info');
                }
                return;
            }

            const accepted = await confirmDialog(
                'La IA reescribirá el título, el resumen y el cuerpo del artículo para corregir las observaciones. ¿Continuar?',
                {
                    title: 'Corregir con IA',
                    type: 'warning',
                    acceptLabel: 'Corregir',
                    cancelLabel: 'Rechazar'
                });

            if (!accepted) return;

            const token = getToken();
            const payload = {
                title: document.getElementById('titleInput')?.value || '',
                summary: document.getElementById('Summary')?.value || '',
                blocksJson: document.getElementById('BlocksJsonInput')?.value || '[]',
                issues: issues.map(issue => ({ code: issue.code || null, message: issue.message }))
            };

            aiButton.disabled = true;
            const originalLabel = aiLabel.textContent;
            aiLabel.textContent = 'Corrigiendo…';

            try {
                const response = await fetch(correctUrl, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify(payload)
                });

                const data = await response.json().catch(() => ({}));
                if (!response.ok) {
                    throw new Error(data.message || 'La corrección no está disponible (HTTP ' + response.status + ').');
                }

                applyCorrection(data);

                const linkActions = Array.isArray(data.linkActions) ? data.linkActions : [];
                const verifiedActions = linkActions.filter(action => action.verified);
                const remaining = Number(data.remainingStyleIssues) || 0;

                // Los cambios de enlaces solo se aplican con confirmación explícita
                // y después de que el servidor los haya validado.
                let appliedLinkChanges = false;
                if (verifiedActions.length > 0) {
                    const applyChanges = await confirmLinkActions(linkActions);
                    if (applyChanges) {
                        await applyLinkActions(verifiedActions);
                        appliedLinkChanges = true;
                    }
                } else if (linkActions.length > 0) {
                    await alertDialog(
                        'La IA propuso cambios de enlaces, pero ninguno se pudo verificar. No se aplicó ningún cambio.',
                        { title: 'Cambios de enlaces', type: 'warning' });
                }

                if (appliedLinkChanges) return;

                if (window.showToast) {
                    const attempts = Number(data.attempts) || 1;
                    let message = 'Corrección aplicada' +
                        (attempts > 1 ? ' tras ' + attempts + ' intentos' : '') + '.';
                    if (linkActions.length > 0) {
                        message += ' Se mantuvieron los cambios de enlaces propuestos (' +
                            linkActions.length + ').';
                    }
                    if (remaining > 0) {
                        message += ' Quedan ' + remaining + ' aviso(s) de estilo; puedes reintentar la corrección.';
                    }
                    message += ' Revisa los cambios antes de guardar.';
                    window.showToast(message,
                        linkActions.length > 0 || remaining > 0 ? 'info' : 'success');
                }
                await validateArticle();
            } catch (error) {
                await alertDialog(error.message || 'No se pudo corregir el artículo.', {
                    title: 'No se pudo corregir',
                    type: 'danger'
                });
            } finally {
                aiButton.disabled = false;
                aiLabel.textContent = originalLabel || 'Corregir con IA';
            }
        }

        button.addEventListener('click', validateArticle);
        aiButton?.addEventListener('click', correctWithAi);
    })();
</script>
