@model List<Domine.Entities.Article>
@{
    ViewData["Title"] = "Gestión de Artículos";
    var categories = (Dictionary<string, string>?)ViewBag.Categories ?? new();
}

@section HeaderActions {
    <a href="/admin/articulos/nuevo" class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-[#FDC500] hover:bg-[#FFD500] text-[#00296B] font-semibold text-sm shadow-sm transition-all">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
        Nuevo Artículo
    </a>
}

<div class="bg-white rounded-2xl border border-slate-200/80 shadow-xs overflow-hidden">
    <div class="p-6 border-b border-slate-100 flex items-center justify-between">
        <h3 class="font-bold text-slate-800 text-base">Publicaciones del Portal</h3>
        <span class="text-xs text-slate-400">Total: @Model.Count</span>
    </div>

    @if (!Model.Any())
    {
        <div class="p-12 text-center text-slate-400">
            <svg class="w-12 h-12 mx-auto text-slate-300 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9.5a2 2 0 00-.586-1.414l-4.5-4.5A2 2 0 0015.5 3H5"/></svg>
            <p class="font-medium text-slate-600">No hay artículos registrados.</p>
            <p class="text-xs text-slate-400 mt-1">Comienza publicando tu primera noticia o crónica.</p>
            <a href="/admin/articulos/nuevo" class="mt-4 inline-block text-xs font-semibold text-[#00509D] hover:underline">Crear artículo ahora →</a>
        </div>
    }
    else
    {
        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm">
                <thead class="bg-slate-50 border-b border-slate-100 text-xs font-semibold uppercase text-slate-500 tracking-wider">
                    <tr>
                        <th class="px-6 py-3.5">Título</th>
                        <th class="px-6 py-3.5">Categoría</th>
                        <th class="px-6 py-3.5">Estado</th>
                        <th class="px-6 py-3.5">Fecha</th>
                        <th class="px-6 py-3.5">Vistas</th>
                        <th class="px-6 py-3.5 text-right">Acciones</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @foreach (var art in Model)
                    {
                        <tr class="hover:bg-slate-50/60 transition-colors">
                            <td class="px-6 py-4">
                                <a href="/admin/articulos/editar/@art.Id" class="font-semibold text-slate-800 hover:text-[#00509D] line-clamp-1">
                                    @art.Title
                                </a>
                                <span class="text-xs text-slate-400 font-mono">/@art.Slug</span>
                            </td>
                            <td class="px-6 py-4 text-xs text-slate-600">
                                @(art.CategoryId != null && categories.ContainsKey(art.CategoryId) ? categories[art.CategoryId] : "-")
                            </td>
                            <td class="px-6 py-4">
                                @if (art.Status == Domine.Entities.ArticleStatus.Publicado)
                                {
                                    <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">
                                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Publicado
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-amber-50 text-amber-700 border border-amber-200">
                                        <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span> Borrador
                                    </span>
                                }
                            </td>
                            <td class="px-6 py-4 text-xs text-slate-500">
                                @art.CreatedAt.ToString("dd/MM/yyyy")
                            </td>
                            <td class="px-6 py-4 text-xs font-mono text-slate-600">
                                @art.ViewCount
                            </td>
                            <td class="px-6 py-4 text-right">
                                <div class="inline-flex items-center gap-2">
                                    <a href="/articulos/@art.Slug" target="_blank" class="p-1.5 text-slate-400 hover:text-[#00509D] rounded-lg transition" title="Ver en portal público">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
                                    </a>
                                    <a href="/admin/articulos/editar/@art.Id" class="p-1.5 text-slate-400 hover:text-slate-700 rounded-lg transition" title="Editar">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                                    </a>
                                    <form method="post" action="/admin/articulos/eliminar/@art.Id" onsubmit="return confirm('¿Seguro que deseas eliminar este artículo? Esta acción no se puede deshacer.');" class="inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="p-1.5 text-slate-400 hover:text-rose-600 rounded-lg transition" title="Eliminar">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
