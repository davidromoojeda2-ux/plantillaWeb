@model List<ArticleResponseDto>
@{
    ViewData["Title"] = "Gestión de Artículos";
}

@section HeaderActions {
    <a asp-area="Admin" asp-controller="Articulos" asp-action="Create" class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-[#FDC500] hover:bg-[#FFD500] text-[#00296B] font-semibold text-sm shadow-sm transition-all">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
        Nuevo Artículo
    </a>
}

<component type="typeof(ArticleList)" render-mode="Server" />
