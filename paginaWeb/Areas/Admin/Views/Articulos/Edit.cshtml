@model paginaWeb.Areas.Admin.Models.ArticleFormViewModel
@{
    ViewData["Title"] = "Editar Artículo";
    ViewData["IsEdit"] = true;
}

@section HeaderActions {
    <a asp-area="" asp-controller="Home" asp-action="Articulo" asp-route-slug="@Model.Slug"
       target="_blank" rel="noopener noreferrer"
       class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl border border-slate-300 bg-white hover:bg-slate-50 text-slate-700 font-semibold text-sm shadow-xs transition-all">
        <svg class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
        Ver página pública
    </a>
    <button type="submit" form="articleForm"
            class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-[#FDC500] hover:bg-[#FFD500] text-[#00296B] font-semibold text-sm shadow-sm transition-all">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
        </svg>
        Actualizar Noticia
    </button>
}

<partial name="_ArticleForm" model="Model" />

@if (ViewData["IsEdit"] as bool? == true)
{
    <partial name="_ShareNetworksModal" model="(List<string>?)ViewBag.EnabledShareNetworks" />
}

@section Scripts {
    <partial name="_ArticleFormScripts" model="Model" />
}
