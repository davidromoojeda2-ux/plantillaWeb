@model paginaWeb.Areas.Admin.Models.ArticleFormViewModel
@{
    ViewData["Title"] = "Editar Artículo";
    ViewData["IsEdit"] = true;
}

<partial name="_ArticleForm" model="Model" />

@if (ViewData["IsEdit"] as bool? == true)
{
    <partial name="_ShareNetworksModal" model="(List<string>?)ViewBag.EnabledShareNetworks" />
}

@section Scripts {
    <partial name="_ArticleFormScripts" model="Model" />
}
