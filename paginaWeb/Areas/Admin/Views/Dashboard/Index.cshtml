@{
    ViewData["Title"] = "Dashboard";
    var recentArticles = (List<ArticleResponseDto>?)ViewBag.RecentArticles ?? new();
    var pendingComments = (List<CommentResponseDto>?)ViewBag.PendingComments ?? new();
    var whatsAppGroups = (List<WhatsAppGroupDto>?)ViewBag.WhatsAppGroups ?? new();
    var socialProfiles = (List<SocialProfileDto>?)ViewBag.SocialProfiles ?? new();
    var activeGroups = whatsAppGroups.Count(g => g.Active && !string.IsNullOrWhiteSpace(g.Url));
    var activeSocialProfiles = socialProfiles.Count(p => p.Active && !string.IsNullOrWhiteSpace(p.Url));
}

@Html.AntiForgeryToken()

@section HeaderActions {
    <a asp-area="Admin" asp-controller="Articulos" asp-action="Create"
       class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-[#FDC500] hover:bg-[#FFD500] text-[#00296B] font-semibold text-sm shadow-sm transition-all">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
        </svg>
        Nueva Noticia
    </a>
}

<div class="space-y-8">
    <!-- ─── Métricas Principales ─────────────────────────────────────────────── -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        <div class="bg-white p-6 rounded-2xl border border-slate-200/80 flex items-center justify-between">
            <div>
                <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Artículos Totales</p>
                <h3 class="text-3xl font-bold text-slate-800 mt-1">@ViewBag.TotalArticles</h3>
            </div>
            <div class="text-slate-300">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9.5a2 2 0 00-.586-1.414l-4.5-4.5A2 2 0 0015.5 3H5" />
                </svg>
            </div>
        </div>

        <div class="bg-white p-6 rounded-2xl border border-slate-200/80 flex items-center justify-between">
            <div>
                <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Categorías</p>
                <h3 class="text-3xl font-bold text-slate-800 mt-1">@ViewBag.TotalCategories</h3>
            </div>
            <div class="text-slate-300">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
                </svg>
            </div>
        </div>

        <div class="bg-white p-6 rounded-2xl border border-slate-200/80 flex items-center justify-between">
            <div>
                <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Comentarios Pendientes</p>
                <h3 class="text-3xl font-bold text-slate-800 mt-1">@ViewBag.PendingCommentsCount</h3>
            </div>
            <div class="text-slate-300">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" />
                </svg>
            </div>
        </div>

        <div class="bg-white p-6 rounded-2xl border border-slate-200/80 flex items-center justify-between">
            <div>
                <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Acción Rápida</p>
                <a asp-area="Admin" asp-controller="Imagenes" asp-action="Index"
                   class="text-sm font-semibold text-[#00509D] hover:underline mt-1 block">Subir Imágenes <partial name="_SvgIcon" model="@(new SvgIcon("arrow-right", "w-3.5 h-3.5"))" /></a>
            </div>
            <div class="text-slate-300">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
            </div>
        </div>
    </div>

    <!-- ─── Comunidad y Difusión ──────────────────────────────────────────────── -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-5">
        <div class="bg-white p-6 rounded-2xl border border-slate-200/80 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div class="flex items-start gap-3.5">
                <div class="w-11 h-11 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center flex-shrink-0">
                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
                    </svg>
                </div>
                <div>
                    <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Comunidad</p>
                    <h3 class="text-base font-bold text-slate-800 mt-0.5">Grupos de WhatsApp</h3>
                    <p class="text-xs text-slate-400 mt-0.5">
                        <span id="whatsAppGroupsCount">@activeGroups</span> grupo(s) activo(s) · se muestran en “Únete”
                    </p>
                </div>
            </div>
            <button type="button" id="btnOpenWhatsAppGroupsModal"
                    class="self-start sm:self-center inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl border border-slate-300 bg-white hover:bg-slate-50 text-xs font-semibold text-slate-700 transition flex-shrink-0">
                Gestionar
            </button>
        </div>

        <div class="bg-white p-6 rounded-2xl border border-slate-200/80 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div class="flex items-start gap-3.5">
                <div class="w-11 h-11 rounded-xl bg-blue-50 text-[#00509D] flex items-center justify-center flex-shrink-0">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M13.828 10.172a4 4 0 010 5.656l-3 3a4 4 0 01-5.656-5.656l1.5-1.5m5.656-5.656l1.5-1.5a4 4 0 015.656 5.656l-3 3a4 4 0 01-5.656 0"/>
                    </svg>
                </div>
                <div>
                    <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Comunidad</p>
                    <h3 class="text-base font-bold text-slate-800 mt-0.5">Redes sociales del sitio</h3>
                    <p class="text-xs text-slate-400 mt-0.5">
                        <span id="socialProfilesCount">@activeSocialProfiles</span> red(es) activa(s) · se muestran en el footer
                    </p>
                </div>
            </div>
            <button type="button" id="btnOpenSocialProfilesModal"
                    class="self-start sm:self-center inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl border border-slate-300 bg-white hover:bg-slate-50 text-xs font-semibold text-slate-700 transition flex-shrink-0">
                Gestionar
            </button>
        </div>
    </div>

    <!-- ─── Contenido Reciente y Moderación ───────────────────────────────────── -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <!-- Últimas Noticias -->
        <div class="bg-white rounded-2xl border border-slate-200/80 p-6">
            <div class="flex items-center justify-between mb-5">
                <h3 class="font-bold text-slate-800 text-lg">Últimas Publicaciones</h3>
                <a asp-area="Admin" asp-controller="Articulos" asp-action="Index"
                   class="text-xs font-semibold text-[#00509D] hover:underline">Ver todas</a>
            </div>

            @if (!recentArticles.Any())
            {
                <div class="text-center py-10 text-slate-400 text-sm">
                    No hay artículos registrados aún.
                    <div class="mt-3">
                        <a asp-area="Admin" asp-controller="Articulos" asp-action="Create"
                           class="text-[#00509D] font-semibold hover:underline">Crear el primer artículo <partial name="_SvgIcon" model="@(new SvgIcon("arrow-right", "w-3.5 h-3.5"))" /></a>
                    </div>
                </div>
            }
            else
            {
                <div class="divide-y divide-slate-100">
                    @foreach (var art in recentArticles)
                    {
                        <div class="py-3.5 flex items-center justify-between">
                            <div class="pr-4 min-w-0">
                                <div class="flex items-center gap-2">
                                    <a asp-area="Admin" asp-controller="Articulos" asp-action="Edit" asp-route-id="@art.Id"
                                       class="font-medium text-slate-800 hover:text-[#00509D] text-sm line-clamp-1">
                                        @art.Title
                                    </a>
                                    @if (art.Featured)
                                    {
                                        <span
                                            class="inline-flex items-center gap-0.5 px-1.5 py-0.5 rounded text-[10px] font-bold bg-amber-100 text-amber-950 border border-amber-300 flex-shrink-0 cursor-help"
                                            data-tooltip="Artículo fijado como portada principal en el Hero">
                                            Hero
                                        </span>
                                    }
                                </div>
                                <p class="text-xs text-slate-400 mt-0.5">
                                    @art.CreatedAt.ToString("dd MMM yyyy") • @art.ViewCount vistas
                                </p>
                            </div>
                            <div class="flex items-center gap-2 flex-shrink-0">
                                @if (art.Status == "Publicado")
                                {
                                    <span
                                    class="px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">Publicado</span>
                                }
                                else
                                {
                                    <span
                                    class="px-2.5 py-1 rounded-full text-xs font-semibold bg-amber-50 text-amber-700 border border-amber-200">Borrador</span>
                                }
                                <a asp-area="Admin" asp-controller="Articulos" asp-action="Edit" asp-route-id="@art.Id"
                                   class="p-1.5 text-slate-400 hover:text-slate-600 rounded-lg transition-colors"
                                   data-tooltip="Editar artículo">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                              d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                    </svg>
                                </a>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- Comentarios Pendientes -->
        <div class="bg-white rounded-2xl border border-slate-200/80 p-6">
            <div class="flex items-center justify-between mb-5">
                <h3 class="font-bold text-slate-800 text-lg">Comentarios Pendientes</h3>
                <a asp-area="Admin" asp-controller="Comentarios" asp-action="Index"
                   class="text-xs font-semibold text-[#00509D] hover:underline">Ir a moderación</a>
            </div>

            @if (!pendingComments.Any())
            {
                <div class="text-center py-10 text-slate-400 text-sm">
                    <svg class="w-12 h-12 mx-auto text-slate-300 mb-3" fill="none" stroke="currentColor"
                         viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                              d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" />
                    </svg>
                    No hay comentarios pendientes por moderar.
                </div>
            }
            else
            {
                <div class="space-y-3">
                    @foreach (var c in pendingComments)
                    {
                        <div class="p-4 rounded-xl bg-slate-50 border border-slate-200 text-sm">
                            <div class="flex items-center justify-between mb-1.5">
                                <span class="font-semibold text-slate-800">@c.Name</span>
                                <span class="text-xs text-slate-400">@c.CreatedAt.ToString("g")</span>
                            </div>
                            <p class="text-slate-600 text-xs line-clamp-2 italic">"@c.Content"</p>
                            <div class="mt-3 flex items-center gap-2">
                                <form method="post" asp-area="Admin" asp-controller="Comentarios" asp-action="Approve"
                                      asp-route-id="@c.Id" class="inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit"
                                            data-tooltip="Aprobar y publicar comentario"
                                            data-tooltip-variant="success"
                                            class="px-3 py-1 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-semibold transition-colors">Aprobar</button>
                                </form>
                                <form method="post" asp-area="Admin" asp-controller="Comentarios" asp-action="Reject"
                                      asp-route-id="@c.Id" class="inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit"
                                            data-tooltip="Rechazar comentario"
                                            data-tooltip-variant="danger"
                                            class="px-3 py-1 rounded-lg bg-rose-600 hover:bg-rose-700 text-white text-xs font-semibold transition-colors">Rechazar</button>
                                </form>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

<partial name="_WhatsAppGroupsModal" model="whatsAppGroups" />
<partial name="_SocialProfilesModal" model="socialProfiles" />
