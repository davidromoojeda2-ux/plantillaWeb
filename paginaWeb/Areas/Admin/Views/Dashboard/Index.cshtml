@{
    ViewData["Title"] = "Dashboard";
    var recentArticles = (List<ArticleResponseDto>?)ViewBag.RecentArticles ?? new();
    var pendingComments = (List<CommentResponseDto>?)ViewBag.PendingComments ?? new();
}

@section HeaderActions {
    <a href="/admin/articulos/nuevo" class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-[#FDC500] hover:bg-[#FFD500] text-[#00296B] font-semibold text-sm shadow-sm transition-all">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
        Nueva Noticia
    </a>
}

<div class="space-y-8">
    <!-- ─── Métricas Principales ─────────────────────────────────────────────── -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        <div class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-xs flex items-center justify-between">
            <div>
                <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Artículos Totales</p>
                <h3 class="text-3xl font-bold text-slate-800 mt-1">@ViewBag.TotalArticles</h3>
            </div>
            <div class="w-12 h-12 rounded-xl bg-blue-50 text-[#003F88] flex items-center justify-center">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9.5a2 2 0 00-.586-1.414l-4.5-4.5A2 2 0 0015.5 3H5"/></svg>
            </div>
        </div>

        <div class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-xs flex items-center justify-between">
            <div>
                <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Categorías</p>
                <h3 class="text-3xl font-bold text-slate-800 mt-1">@ViewBag.TotalCategories</h3>
            </div>
            <div class="w-12 h-12 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/></svg>
            </div>
        </div>

        <div class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-xs flex items-center justify-between">
            <div>
                <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Comentarios Pendientes</p>
                <h3 class="text-3xl font-bold text-slate-800 mt-1">@ViewBag.PendingCommentsCount</h3>
            </div>
            <div class="w-12 h-12 rounded-xl bg-rose-50 text-rose-600 flex items-center justify-center">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"/></svg>
            </div>
        </div>

        <div class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-xs flex items-center justify-between">
            <div>
                <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Acción Rápida</p>
                <a href="/admin/imagenes" class="text-sm font-semibold text-[#00509D] hover:underline mt-1 block">Subir Imágenes →</a>
            </div>
            <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
            </div>
        </div>
    </div>

    <!-- ─── Contenido Reciente y Moderación ───────────────────────────────────── -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <!-- Últimas Noticias -->
        <div class="bg-white rounded-2xl border border-slate-200/80 shadow-xs p-6">
            <div class="flex items-center justify-between mb-5">
                <h3 class="font-bold text-slate-800 text-lg">Últimas Publicaciones</h3>
                <a href="/admin/articulos" class="text-xs font-semibold text-[#00509D] hover:underline">Ver todas</a>
            </div>

            @if (!recentArticles.Any())
            {
                <div class="text-center py-10 text-slate-400 text-sm">
                    No hay artículos registrados aún.
                    <div class="mt-3">
                        <a href="/admin/articulos/nuevo" class="text-[#00509D] font-semibold hover:underline">Crear el primer artículo →</a>
                    </div>
                </div>
            }
            else
            {
                <div class="divide-y divide-slate-100">
                    @foreach (var art in recentArticles)
                    {
                        <div class="py-3.5 flex items-center justify-between">
                            <div class="pr-4">
                                <a href="/admin/articulos/editar/@art.Id" class="font-medium text-slate-800 hover:text-[#00509D] text-sm line-clamp-1">
                                    @art.Title
                                </a>
                                <p class="text-xs text-slate-400 mt-0.5">
                                    @art.CreatedAt.ToString("dd MMM yyyy") • @art.ViewCount vistas
                                </p>
                            </div>
                            <div class="flex items-center gap-2 flex-shrink-0">
                                @if (art.Status == "Publicado")
                                {
                                    <span class="px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">Publicado</span>
                                }
                                else
                                {
                                    <span class="px-2.5 py-1 rounded-full text-xs font-semibold bg-amber-50 text-amber-700 border border-amber-200">Borrador</span>
                                }
                                <a href="/admin/articulos/editar/@art.Id" class="p-1.5 text-slate-400 hover:text-slate-600 rounded-lg">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                                </a>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- Comentarios Pendientes -->
        <div class="bg-white rounded-2xl border border-slate-200/80 shadow-xs p-6">
            <div class="flex items-center justify-between mb-5">
                <h3 class="font-bold text-slate-800 text-lg">Comentarios Pendientes</h3>
                <a href="/admin/comentarios" class="text-xs font-semibold text-[#00509D] hover:underline">Ir a moderación</a>
            </div>

            @if (!pendingComments.Any())
            {
                <div class="text-center py-10 text-slate-400 text-sm">
                    No hay comentarios pendientes por moderar. 🎉
                </div>
            }
            else
            {
                <div class="space-y-3">
                    @foreach (var c in pendingComments)
                    {
                        <div class="p-4 rounded-xl bg-slate-50 border border-slate-200 text-sm">
                            <div class="flex items-center justify-between mb-1.5">
                                <span class="font-semibold text-slate-800">@c.Name</span>
                                <span class="text-xs text-slate-400">@c.CreatedAt.ToString("g")</span>
                            </div>
                            <p class="text-slate-600 text-xs line-clamp-2 italic">"@c.Content"</p>
                            <div class="mt-3 flex items-center gap-2">
                                <form method="post" action="/admin/comentarios/aprobar/@c.Id" class="inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="px-3 py-1 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-semibold">Aprobar</button>
                                </form>
                                <form method="post" action="/admin/comentarios/rechazar/@c.Id" class="inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="px-3 py-1 rounded-lg bg-rose-600 hover:bg-rose-700 text-white text-xs font-semibold">Rechazar</button>
                                </form>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>
