@model paginaWeb.Areas.Admin.Models.CategoryFormViewModel
@{
    ViewData["Title"] = "Nueva Categoría";
}

<div class="max-w-2xl mx-auto bg-white rounded-2xl border border-slate-200/80 shadow-xs p-8">
    <h3 class="text-lg font-bold text-slate-800 mb-6">Crear Categoría o Subcategoría</h3>

    <form method="post" asp-area="Admin" asp-controller="Categorias" asp-action="Create" class="space-y-6">
        @Html.AntiForgeryToken()

        <div>
            <label asp-for="Name" class="block text-xs font-semibold uppercase tracking-wider text-slate-600 mb-1.5">Nombre</label>
            <input asp-for="Name" id="nameInput" required placeholder="ej: Ciencia y Tecnología"
                   class="w-full text-sm rounded-xl border border-slate-300 px-4 py-2.5 focus:ring-2 focus:ring-[#00509D] focus:outline-none" />
            <span asp-validation-for="Name" class="text-xs text-rose-600 mt-1 block"></span>
        </div>

        <div>
            <label asp-for="Slug" class="block text-xs font-semibold uppercase tracking-wider text-slate-600 mb-1.5 flex items-center gap-1.5">
                Slug URL
                <button type="button" class="cms-tooltip-icon" data-tooltip="Ruta amigable en la URL (ej: /categoria/ciencia-y-salud)">i</button>
            </label>
            <input asp-for="Slug" id="slugInput" required placeholder="ej: ciencia-y-tecnologia"
                   class="w-full text-sm font-mono rounded-xl border border-slate-300 px-4 py-2.5 focus:ring-2 focus:ring-[#00509D] focus:outline-none" />
            <span asp-validation-for="Slug" class="text-xs text-rose-600 mt-1 block"></span>
        </div>

        <div>
            <label asp-for="ParentId" class="block text-xs font-semibold uppercase tracking-wider text-slate-600 mb-1.5 flex items-center gap-1.5">
                Nivel Jerárquico / Categoría Padre
                <button type="button" class="cms-tooltip-icon" data-tooltip="Si seleccionas una categoría padre, esta se convertirá en una subcategoría">i</button>
            </label>
            <select asp-for="ParentId" id="parentSelect" class="w-full text-sm rounded-xl border border-slate-300 px-4 py-2.5 bg-white focus:ring-2 focus:ring-[#00509D] focus:outline-none">
                <option value="">-- Ninguna (Crear como Categoría Principal) --</option>
                @foreach (var p in Model.Parents)
                {
                    <option value="@p.Id" selected="@(p.Id == Model.ParentId)">Subcategoría de: @p.Name</option>
                }
            </select>
            <span asp-validation-for="ParentId" class="text-xs text-rose-600 mt-1 block"></span>
            <div id="parentHelper" class="mt-2 text-xs font-semibold px-3 py-1.5 rounded-lg bg-slate-50 border border-slate-200 text-slate-600">
                <!-- Se actualiza dinámicamente con JS -->
            </div>
        </div>

        <div>
            <label asp-for="Description" class="block text-xs font-semibold uppercase tracking-wider text-slate-600 mb-1.5">Descripción</label>
            <textarea asp-for="Description" rows="2" placeholder="Breve descripción del tema..."
                      class="w-full text-sm rounded-xl border border-slate-300 px-4 py-2 focus:ring-2 focus:ring-[#00509D] focus:outline-none"></textarea>
            <span asp-validation-for="Description" class="text-xs text-rose-600 mt-1 block"></span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-2">
            <div>
                <label asp-for="Order" class="block text-xs font-semibold uppercase tracking-wider text-slate-600 mb-1.5">Orden</label>
                <input asp-for="Order" type="number" min="0" class="w-full text-sm rounded-xl border border-slate-300 px-3 py-2" />
            </div>

            <div class="flex items-center pt-5">
                <label class="flex items-center gap-2 cursor-pointer">
                    <input asp-for="ShowInMenu" type="checkbox" class="rounded border-slate-300 text-[#00296B]" />
                    <span class="text-xs font-semibold text-slate-700 flex items-center gap-1">
                        Mostrar en Menú
                        <button type="button" class="cms-tooltip-icon" data-tooltip="Determina si aparece en la barra de navegación del portal">i</button>
                    </span>
                </label>
            </div>

            <div class="flex items-center pt-5">
                <label class="flex items-center gap-2 cursor-pointer">
                    <input asp-for="IsActive" type="checkbox" class="rounded border-slate-300 text-[#00296B]" />
                    <span class="text-xs font-semibold text-slate-700">Activa</span>
                </label>
            </div>
        </div>

        <div class="pt-6 border-t border-slate-100 flex gap-3">
            <button type="submit" class="py-2.5 px-6 rounded-xl bg-[#FDC500] hover:bg-[#FFD500] text-[#00296B] font-bold text-sm shadow-sm transition">
                Guardar Categoría
            </button>
            <a asp-area="Admin" asp-controller="Categorias" asp-action="Index" class="py-2.5 px-5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-600 text-sm font-semibold transition">
                Cancelar
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        const nameInput = document.getElementById('nameInput');
        const slugInput = document.getElementById('slugInput');
        const parentSelect = document.getElementById('parentSelect');
        const parentHelper = document.getElementById('parentHelper');

        function updateParentHelper() {
            if (!parentSelect || !parentHelper) return;
            const val = parentSelect.value;
            if (val) {
                const text = parentSelect.options[parentSelect.selectedIndex]?.text || '';
                parentHelper.innerHTML = `<span class="text-amber-600 font-bold">↳ Creando como Subcategoría:</span> Esta entidad se anidará directamente dentro de <strong class="text-slate-800">${text.replace('Subcategoría de: ', '')}</strong>.`;
                parentHelper.className = "mt-2 text-xs font-medium px-3 py-2 rounded-xl bg-amber-50/80 border border-amber-200 text-amber-800";
            } else {
                parentHelper.innerHTML = `<span class="text-[#00509D] font-bold">★ Creando como Categoría Principal:</span> Aparecerá en el nivel raíz de la navegación y portal.`;
                parentHelper.className = "mt-2 text-xs font-medium px-3 py-2 rounded-xl bg-blue-50/80 border border-blue-200 text-[#003F88]";
            }
        }

        parentSelect?.addEventListener('change', updateParentHelper);
        updateParentHelper();

        nameInput.addEventListener('input', () => {
            if (!slugInput.dataset.manual) {
                slugInput.value = nameInput.value
                    .toLowerCase()
                    .trim()
                    .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
                    .replace(/[^a-z0-9]+/g, '-')
                    .replace(/^-+|-+$/g, '');
            }
        });
        slugInput.addEventListener('input', () => {
            slugInput.dataset.manual = 'true';
        });
    </script>
}
