@model ImageQualitySettingsDto
@{
    var initialValues = new
    {
        quality = Model.Quality,
        qualitySmall = Model.QualitySmall,
        qualityMedium = Model.QualityMedium,
        qualityLarge = Model.QualityLarge
    };
}

<div id="imageQualityModal"
     class="fixed inset-0 z-[70] hidden items-center justify-center bg-slate-900/60 backdrop-blur-xs p-4"
     role="dialog" aria-modal="true" aria-labelledby="imageQualityModalTitle">
    <div class="bg-white rounded-2xl shadow-2xl border border-slate-200 w-full max-w-2xl max-h-[90vh] flex flex-col">
        <div class="p-5 border-b border-slate-100 flex items-start justify-between gap-4">
            <div>
                <h3 id="imageQualityModalTitle" class="text-base font-bold text-slate-800">Calidad de optimización WebP</h3>
                <p class="text-xs text-slate-500 mt-0.5">
                    Ajusta la compresión de las nuevas imágenes. Todas se guardan sin EXIF, XMP, IPTC ni perfil ICC.
                </p>
            </div>
            <button type="button" data-close-image-quality
                    class="p-1.5 rounded-lg text-slate-400 hover:text-slate-600 hover:bg-slate-100 transition"
                    aria-label="Cerrar">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        </div>

        <div class="p-5 overflow-y-auto flex-1 space-y-5">
            <!-- Calidad global -->
            <div class="rounded-xl border border-slate-200 bg-slate-50/60 p-4">
                <div class="flex items-center justify-between gap-3">
                    <div>
                        <p class="text-sm font-bold text-slate-800">Calidad global</p>
                        <p class="text-[11px] text-slate-500 mt-0.5">Se aplica a todas las variantes que no tengan un valor propio.</p>
                    </div>
                    <output data-quality-output="global" class="text-lg font-black text-[#00296B] tabular-nums">80%</output>
                </div>
                <input type="range" min="1" max="100" step="1" value="@Model.Quality"
                       data-quality-input="global" class="quality-range w-full mt-3"
                       aria-label="Calidad global de compresión" />
                <div class="flex flex-wrap items-center gap-2 mt-3">
                    <span class="text-[11px] font-semibold text-slate-500 mr-1">Presets:</span>
                    <button type="button" data-quality-preset="70"
                            class="px-2.5 py-1 rounded-lg border border-slate-300 bg-white text-[11px] font-semibold text-slate-600 hover:border-[#00296B] hover:text-[#00296B] transition">
                        Ahorro · 70%
                    </button>
                    <button type="button" data-quality-preset="80"
                            class="px-2.5 py-1 rounded-lg border border-[#00296B] bg-[#00296B] text-[11px] font-semibold text-white transition">
                        Equilibrado · 80%
                    </button>
                    <button type="button" data-quality-preset="90"
                            class="px-2.5 py-1 rounded-lg border border-slate-300 bg-white text-[11px] font-semibold text-slate-600 hover:border-[#00296B] hover:text-[#00296B] transition">
                        Máxima · 90%
                    </button>
                </div>
                <p class="text-[11px] text-slate-400 mt-2">
                    Rango permitido: 1–100. Recomendado entre 60 y 95 para equilibrar nitidez y peso.
                </p>
            </div>

            <!-- Overrides por variante -->
            <details class="rounded-xl border border-slate-200 bg-white">
                <summary class="px-4 py-3 cursor-pointer select-none list-none [&::-webkit-details-marker]:hidden flex items-center justify-between gap-3">
                    <span class="text-xs font-bold uppercase tracking-wider text-slate-600">Ajustes avanzados por tamaño</span>
                    <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                    </svg>
                </summary>
                <div class="px-4 pb-4 space-y-3 border-t border-slate-100 pt-3">
                    <div class="rounded-xl border border-slate-200 p-3">
                        <div class="flex items-center justify-between gap-2">
                            <div>
                                <p class="text-xs font-bold text-slate-700">400 px · Miniatura</p>
                                <p class="text-[11px] text-slate-400">Tarjetas móviles y listados compactos</p>
                            </div>
                            <label class="inline-flex items-center gap-1.5 text-[11px] font-medium text-slate-600">
                                <input type="checkbox" data-use-global="small"
                                       class="rounded border-slate-300 text-[#00296B] focus:ring-[#00509D]" />
                                Usar global
                            </label>
                        </div>
                        <div class="flex items-center gap-3 mt-2">
                            <input type="range" min="1" max="100" step="1" data-quality-input="small"
                                   class="quality-range flex-1" aria-label="Calidad para 400 px" />
                            <output data-quality-output="small" class="w-12 text-right text-xs font-bold text-[#00296B] tabular-nums">80%</output>
                        </div>
                    </div>

                    <div class="rounded-xl border border-slate-200 p-3">
                        <div class="flex items-center justify-between gap-2">
                            <div>
                                <p class="text-xs font-bold text-slate-700">800 px · Estándar</p>
                                <p class="text-[11px] text-slate-400">Tarjetas de escritorio y contenido</p>
                            </div>
                            <label class="inline-flex items-center gap-1.5 text-[11px] font-medium text-slate-600">
                                <input type="checkbox" data-use-global="medium"
                                       class="rounded border-slate-300 text-[#00296B] focus:ring-[#00509D]" />
                                Usar global
                            </label>
                        </div>
                        <div class="flex items-center gap-3 mt-2">
                            <input type="range" min="1" max="100" step="1" data-quality-input="medium"
                                   class="quality-range flex-1" aria-label="Calidad para 800 px" />
                            <output data-quality-output="medium" class="w-12 text-right text-xs font-bold text-[#00296B] tabular-nums">80%</output>
                        </div>
                    </div>

                    <div class="rounded-xl border border-slate-200 p-3">
                        <div class="flex items-center justify-between gap-2">
                            <div>
                                <p class="text-xs font-bold text-slate-700">1600 px · Portada</p>
                                <p class="text-[11px] text-slate-400">Hero, portadas y pantallas grandes</p>
                            </div>
                            <label class="inline-flex items-center gap-1.5 text-[11px] font-medium text-slate-600">
                                <input type="checkbox" data-use-global="large"
                                       class="rounded border-slate-300 text-[#00296B] focus:ring-[#00509D]" />
                                Usar global
                            </label>
                        </div>
                        <div class="flex items-center gap-3 mt-2">
                            <input type="range" min="1" max="100" step="1" data-quality-input="large"
                                   class="quality-range flex-1" aria-label="Calidad para 1600 px" />
                            <output data-quality-output="large" class="w-12 text-right text-xs font-bold text-[#00296B] tabular-nums">80%</output>
                        </div>
                    </div>
                </div>
            </details>

            <p class="text-[11px] text-slate-500 leading-relaxed">
                Los cambios aplican únicamente a imágenes nuevas. Las ya publicadas conservan sus variantes actuales.
                Los metadatos se eliminan siempre, independientemente de la calidad elegida.
            </p>

            <div id="imageQualityError"
                 class="hidden text-xs text-rose-700 bg-rose-50 border border-rose-200 rounded-lg px-3 py-2"></div>
        </div>

        <div class="p-4 border-t border-slate-100 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
            <button type="button" id="btnResetImageQuality"
                    class="inline-flex items-center justify-center gap-1.5 px-3 py-2 rounded-xl border border-slate-300 text-xs font-semibold text-slate-700 hover:bg-slate-50 transition">
                Restaurar 80%
            </button>
            <div class="flex items-center justify-end gap-2">
                <button type="button" data-close-image-quality
                        class="px-4 py-2 text-xs font-bold text-slate-600 hover:bg-slate-100 rounded-xl transition">Cancelar</button>
                <button type="button" id="btnSaveImageQuality"
                        class="px-5 py-2 text-xs font-bold text-white bg-[#00296B] hover:bg-[#00509D] rounded-xl shadow-xs transition disabled:opacity-60 disabled:cursor-not-allowed">
                    Guardar
                </button>
            </div>
        </div>
    </div>

    @Html.AntiForgeryToken()
</div>

<style>
    #imageQualityModal .quality-range {
        accent-color: #00296B;
        height: 1.25rem;
    }
</style>

<script>
    (function () {
        var modal = document.getElementById('imageQualityModal');
        if (!modal) return;

        var initial = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(initialValues));
        var summary = document.getElementById('imageQualitySummary');
        var errorBox = document.getElementById('imageQualityError');
        var saveBtn = document.getElementById('btnSaveImageQuality');

        var inputs = {
            global: modal.querySelector('[data-quality-input="global"]'),
            small: modal.querySelector('[data-quality-input="small"]'),
            medium: modal.querySelector('[data-quality-input="medium"]'),
            large: modal.querySelector('[data-quality-input="large"]')
        };

        var outputs = {
            global: modal.querySelector('[data-quality-output="global"]'),
            small: modal.querySelector('[data-quality-output="small"]'),
            medium: modal.querySelector('[data-quality-output="medium"]'),
            large: modal.querySelector('[data-quality-output="large"]')
        };

        var useGlobal = {
            small: modal.querySelector('[data-use-global="small"]'),
            medium: modal.querySelector('[data-use-global="medium"]'),
            large: modal.querySelector('[data-use-global="large"]')
        };

        var variantKeys = ['small', 'medium', 'large'];

        function clamp(value) {
            var number = parseInt(value, 10);
            if (isNaN(number)) return 80;
            return Math.min(100, Math.max(1, number));
        }

        function render() {
            var global = clamp(inputs.global.value);
            outputs.global.textContent = global + '%';

            variantKeys.forEach(function (key) {
                if (useGlobal[key].checked) {
                    inputs[key].value = global;
                    outputs[key].textContent = global + '%';
                } else {
                    outputs[key].textContent = clamp(inputs[key].value) + '%';
                }
            });
        }

        function apply(values) {
            inputs.global.value = clamp(values.quality);

            variantKeys.forEach(function (key) {
                var override = values['quality' + key.charAt(0).toUpperCase() + key.slice(1)];
                var useDefault = override === null || override === undefined;

                useGlobal[key].checked = useDefault;
                inputs[key].disabled = useDefault;
                inputs[key].value = useDefault ? clamp(values.quality) : clamp(override);
            });

            render();
        }

        function currentValues() {
            return {
                quality: clamp(inputs.global.value),
                qualitySmall: useGlobal.small.checked ? null : clamp(inputs.small.value),
                qualityMedium: useGlobal.medium.checked ? null : clamp(inputs.medium.value),
                qualityLarge: useGlobal.large.checked ? null : clamp(inputs.large.value)
            };
        }

        function updateSummary(values) {
            if (!summary) return;

            var global = values.quality;
            var small = values.qualitySmall === null ? global : values.qualitySmall;
            var medium = values.qualityMedium === null ? global : values.qualityMedium;
            var large = values.qualityLarge === null ? global : values.qualityLarge;

            summary.textContent = 'Global ' + global + '% · 400 ' + small + '% · 800 ' + medium + '% · 1600 ' + large + '%';
        }

        function showError(message) {
            errorBox.textContent = message;
            errorBox.classList.remove('hidden');
        }

        function hideError() {
            errorBox.textContent = '';
            errorBox.classList.add('hidden');
        }

        function openModal() {
            apply(initial);
            hideError();
            modal.classList.remove('hidden');
            modal.classList.add('flex');
            inputs.global.focus();
        }

        function closeModal() {
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }

        function save() {
            var values = currentValues();

            hideError();
            saveBtn.disabled = true;

            fetch('/admin/ajustes/calidad-imagenes', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': window.cmsModals ? window.cmsModals.token(modal) : ''
                },
                body: JSON.stringify(values)
            })
                .then(function (response) {
                    return response.json().catch(function () { return {}; })
                        .then(function (data) { return { ok: response.ok, data: data }; });
                })
                .then(function (result) {
                    if (!result.ok || !result.data.success) {
                        throw new Error(result.data.message || 'No se pudo guardar la configuración.');
                    }

                    initial = values;
                    updateSummary(values);
                    if (window.cmsModals) window.cmsModals.toast('Calidad de imágenes actualizada.', 'success');
                    closeModal();
                })
                .catch(function (error) {
                    showError(error.message || 'No se pudo guardar la configuración.');
                })
                .finally(function () {
                    saveBtn.disabled = false;
                });
        }

        document.getElementById('btnOpenImageQualityModal')?.addEventListener('click', openModal);

        modal.querySelectorAll('[data-close-image-quality]').forEach(function (button) {
            button.addEventListener('click', closeModal);
        });

        inputs.global.addEventListener('input', render);

        variantKeys.forEach(function (key) {
            inputs[key].addEventListener('input', render);

            useGlobal[key].addEventListener('change', function () {
                inputs[key].disabled = useGlobal[key].checked;
                if (useGlobal[key].checked) inputs[key].value = clamp(inputs.global.value);
                render();
            });
        });

        modal.querySelectorAll('[data-quality-preset]').forEach(function (button) {
            button.addEventListener('click', function () {
                inputs.global.value = clamp(button.getAttribute('data-quality-preset'));
                render();
            });
        });

        document.getElementById('btnResetImageQuality')?.addEventListener('click', function () {
            apply({ quality: 80, qualitySmall: null, qualityMedium: null, qualityLarge: null });
            hideError();
        });

        saveBtn?.addEventListener('click', save);

        document.addEventListener('keydown', function (event) {
            if (event.key === 'Escape' && !modal.classList.contains('hidden')) closeModal();
        });

        // Estado inicial coherente desde el primer render (aunque el modal esté oculto)
        apply(initial);
    })();
</script>
