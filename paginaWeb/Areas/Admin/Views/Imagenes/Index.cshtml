@model List<ImageMetadataResponseDto>
@{
    ViewData["Title"] = "Biblioteca de Imágenes";
    var articles = (List<ArticleResponseDto>?)ViewBag.Articles ?? new();
}

<div class="space-y-8">
    <!-- ─── Subida de Nuevas Imágenes ────────────────────────────────────────── -->
    <div class="bg-white rounded-2xl border border-slate-200/80 shadow-xs p-6">
        <h3 class="font-bold text-slate-800 text-sm mb-4">Subir Nueva Imagen al Repositorio</h3>

        <form method="post" action="/admin/imagenes/subir" enctype="multipart/form-data" class="grid grid-cols-1 md:grid-cols-4 gap-4 items-end">
            @Html.AntiForgeryToken()
            <div class="md:col-span-1">
                <label class="block text-xs font-semibold uppercase tracking-wider text-slate-600 mb-1.5">Archivo de Imagen</label>
                <input type="file" name="file" accept="image/*" required
                       class="w-full text-xs text-slate-500 file:mr-3 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-semibold file:bg-blue-50 file:text-[#003F88] hover:file:bg-blue-100 cursor-pointer" />
            </div>

            <div class="md:col-span-1">
                <label class="block text-xs font-semibold uppercase tracking-wider text-slate-600 mb-1.5">Texto Alt (Accesibilidad)</label>
                <input type="text" name="alt" placeholder="Descripción de la imagen..."
                       class="w-full text-sm rounded-xl border border-slate-300 px-3 py-2 focus:ring-2 focus:ring-[#00509D] focus:outline-none" />
            </div>

            <div class="md:col-span-1">
                <label class="block text-xs font-semibold uppercase tracking-wider text-slate-600 mb-1.5">Vincular a Artículo (Opcional)</label>
                <select name="articleId" class="w-full text-sm rounded-xl border border-slate-300 px-3 py-2 bg-white focus:ring-2 focus:ring-[#00509D] focus:outline-none">
                    <option value="">-- Sin artículo --</option>
                    @foreach (var art in articles)
                    {
                        <option value="@art.Id">@art.Title</option>
                    }
                </select>
                <label class="flex items-center gap-1.5 mt-1.5 cursor-pointer">
                    <input type="checkbox" name="setAsCover" value="true" class="rounded border-slate-300 text-[#00296B] focus:ring-[#00296B]" />
                    <span class="text-[11px] text-slate-600">Asignar como portada</span>
                </label>
            </div>

            <div class="md:col-span-1">
                <button type="submit" class="w-full py-2.5 px-4 rounded-xl bg-[#FDC500] hover:bg-[#FFD500] text-[#00296B] font-bold text-sm shadow-sm transition">
                    Optimizar y Guardar
                </button>
            </div>
        </form>
    </div>

    <!-- ─── Galería de Imágenes ──────────────────────────────────────────────── -->
    <div class="bg-white rounded-2xl border border-slate-200/80 shadow-xs p-6">
        <div class="flex items-center justify-between mb-6">
            <h3 class="font-bold text-slate-800 text-base">Archivos Multimedia Disponibles</h3>
            <span class="text-xs text-slate-400">Total: @Model.Count imágenes</span>
        </div>

        @if (!Model.Any())
        {
            <div class="py-16 text-center text-slate-400">
                <svg class="w-12 h-12 mx-auto text-slate-300 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                <p class="font-medium text-slate-600">Aún no se han subido imágenes.</p>
                <p class="text-xs text-slate-400 mt-1">Utiliza el formulario superior para añadir las primeras fotografías.</p>
            </div>
        }
        else
        {
            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
                @foreach (var img in Model)
                {
                    var previewVariant = img.Variants.OrderBy(v => v.Width).FirstOrDefault() ?? img.Variants.First();
                    var maxVariant = img.Variants.OrderByDescending(v => v.Width).FirstOrDefault() ?? img.Variants.First();

                    <div class="group rounded-2xl border border-slate-200 overflow-hidden bg-slate-50 flex flex-col justify-between hover:shadow-md transition">
                        <div>
                            <div class="aspect-video w-full overflow-hidden bg-slate-200 relative">
                                <img src="@previewVariant.PublicUrl" alt="@img.Alt" loading="lazy" class="w-full h-full object-cover group-hover:scale-105 transition duration-300" />
                                <span class="absolute top-2 right-2 bg-black/60 text-white text-[10px] font-mono px-2 py-0.5 rounded-full backdrop-blur-xs">
                                    @img.OriginalWidth × @img.OriginalHeight
                                </span>
                            </div>

                            <div class="p-3.5 space-y-3">
                                <p class="text-xs font-semibold text-slate-800 truncate" title="@img.OriginalFileName">
                                    @img.OriginalFileName
                                </p>

                                <!-- Estado de vinculación con Artículo -->
                                <div>
                                    @if (!string.IsNullOrEmpty(img.ArticleId))
                                    {
                                        <div class="flex items-center gap-1.5 text-[11px] text-emerald-700 bg-emerald-50 px-2 py-1 rounded-lg border border-emerald-200">
                                            <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/></svg>
                                            <a href="/admin/articulos/editar/@img.ArticleId" class="truncate hover:underline font-medium" title="Ir a editar artículo">
                                                @(img.ArticleTitle ?? "Artículo vinculado")
                                            </a>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-[11px] text-slate-400 italic">Sin artículo vinculado</span>
                                    }
                                </div>

                                <!-- Formulario para vincular / cambiar artículo -->
                                <form method="post" action="/admin/imagenes/vincular-articulo" class="bg-white p-2.5 rounded-xl border border-slate-200/80 space-y-1.5">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@img.Id" />
                                    <label class="block text-[10px] font-semibold uppercase tracking-wider text-slate-500">Vincular a artículo</label>
                                    <div class="flex gap-1.5">
                                        <select name="articleId" class="w-full text-xs rounded-lg border border-slate-300 px-2 py-1 bg-white focus:outline-none focus:ring-1 focus:ring-[#00509D]">
                                            <option value="">-- Desvincular --</option>
                                            @foreach (var art in articles)
                                            {
                                                <option value="@art.Id" selected="@(art.Id == img.ArticleId)">@art.Title</option>
                                            }
                                        </select>
                                        <button type="submit" class="px-2.5 py-1 bg-[#00509D] hover:bg-[#003F88] text-white text-xs font-semibold rounded-lg shrink-0 transition" title="Guardar vínculo">
                                            Vincular
                                        </button>
                                    </div>
                                    <label class="flex items-center gap-1 cursor-pointer">
                                        <input type="checkbox" name="setAsCover" value="true" class="rounded text-[#00296B] scale-90" />
                                        <span class="text-[10px] text-slate-600">Usar como portada</span>
                                    </label>
                                </form>

                                <form method="post" action="/admin/imagenes/actualizar-alt" class="flex gap-1.5 items-center">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@img.Id" />
                                    <input type="text" name="alt" value="@img.Alt" placeholder="Texto Alt..."
                                           class="w-full text-xs rounded-lg border border-slate-300 px-2 py-1 bg-white focus:outline-none focus:ring-1 focus:ring-[#00509D]" />
                                    <button type="submit" class="p-1 text-slate-500 hover:text-[#00509D]" title="Guardar Alt">✓</button>
                                </form>

                                <div class="flex flex-wrap gap-1 text-[10px] font-mono text-slate-500 pt-1">
                                    @foreach (var v in img.Variants)
                                    {
                                        <span class="bg-white border border-slate-200 px-1.5 py-0.5 rounded">@(v.Width)w (@(v.SizeBytes / 1024)KB)</span>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="p-3 border-t border-slate-200/80 bg-white flex items-center justify-between text-xs">
                            <button type="button" onclick="navigator.clipboard.writeText('@maxVariant.PublicUrl'); alert('URL copiada al portapapeles');"
                                    class="text-[#00509D] font-semibold hover:underline">
                                Copiar URL
                            </button>

                            <form method="post" action="/admin/imagenes/eliminar/@img.Id"
                                  onsubmit="return confirm('¿Eliminar esta imagen y todas sus variantes WebP? Si está en uso en artículos públicos, dejará de verse.');" class="inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="text-rose-600 hover:text-rose-800 transition" title="Eliminar archivo">
                                    Eliminar
                                </button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>
