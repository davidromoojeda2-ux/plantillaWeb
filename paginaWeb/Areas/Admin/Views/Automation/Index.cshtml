@model AutomationIndexViewModel
@using Domine.Entities
@{
    ViewData["Title"] = "Automatización";
    var status = Model.Status;
}

@section HeaderActions {
    <a asp-area="Admin" asp-controller="Automation" asp-action="Configuracion"
       class="inline-flex items-center gap-2 px-4 py-2 rounded-xl border border-slate-300 hover:bg-slate-100 text-slate-700 font-semibold text-sm shadow-sm transition-all">
        Configuración
    </a>
}

<div class="space-y-8">
    <!-- ─── Estado ──────────────────────────────────────────────────────────── -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        <div class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-xs flex items-center justify-between">
            <div>
                <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Estado</p>
                <h3 class="text-2xl font-bold mt-1 @(status.Paused ? "text-amber-600" : "text-emerald-600")">
                    @(status.Paused ? "Pausada" : "Activa")
                </h3>
            </div>
            <div class="w-12 h-12 rounded-xl @(status.Paused ? "bg-amber-50 text-amber-600" : "bg-emerald-50 text-emerald-600") flex items-center justify-center">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                </svg>
            </div>
        </div>

        <div class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-xs flex items-center justify-between">
            <div>
                <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Publicación</p>
                <h3 class="text-2xl font-bold mt-1 text-slate-800">@(status.AutoPublish ? "Automática" : "Borrador")</h3>
            </div>
            <div class="w-12 h-12 rounded-xl bg-blue-50 text-[#003F88] flex items-center justify-center">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
            </div>
        </div>

        <div class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-xs flex items-center justify-between">
            <div>
                <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Decisiones pendientes</p>
                <h3 class="text-2xl font-bold mt-1 text-slate-800">@status.PendingDecisionsCount</h3>
            </div>
            <div class="w-12 h-12 rounded-xl bg-rose-50 text-rose-600 flex items-center justify-center">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" />
                </svg>
            </div>
        </div>

        <div class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-xs flex items-center justify-between">
            <div>
                <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Frecuencia</p>
                <h3 class="text-2xl font-bold mt-1 text-slate-800">@status.FrequencyMinutes min</h3>
            </div>
            <div class="w-12 h-12 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
            </div>
        </div>
    </div>

    <!-- ─── Acciones ────────────────────────────────────────────────────────── -->
    <div class="flex flex-wrap items-center gap-3">
        <form method="post" asp-area="Admin" asp-controller="Automation" asp-action="Run"
              data-confirm="¿Ejecutar la automatización ahora? Se consultarán Serper e IA y puede tardar unos segundos."
              data-loading="Iniciando…">
            @Html.AntiForgeryToken()
            <button type="submit"
                    class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-[#FDC500] hover:bg-[#FFD500] text-[#00296B] font-semibold text-sm shadow-sm transition-all">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
                </svg>
                Ejecutar ahora
            </button>
        </form>

        <form method="post" asp-area="Admin" asp-controller="Automation" asp-action="TogglePause"
              data-confirm="@(status.Paused ? "¿Reanudar la automatización?" : "¿Pausar la automatización? Se detendrán las corridas programadas.")"
              data-loading="Procesando…">
            @Html.AntiForgeryToken()
            <button type="submit"
                    class="inline-flex items-center gap-2 px-4 py-2 rounded-xl border border-slate-300 hover:bg-slate-100 text-slate-700 font-semibold text-sm shadow-sm transition-all">
                @(status.Paused ? "Reanudar" : "Pausar")
            </button>
        </form>

        <a asp-area="Admin" asp-controller="Automation" asp-action="Historial"
           class="inline-flex items-center gap-2 px-4 py-2 rounded-xl border border-slate-300 hover:bg-slate-100 text-slate-700 font-semibold text-sm shadow-sm transition-all">
            Ver historial
        </a>
    </div>

    <!-- ─── Barra de estado del proceso ─────────────────────────────────────── -->
    @{
        var isRunning = Model.Status.IsRunning;
    }
    <div id="runStatusBar" class="rounded-xl px-4 py-3 text-sm font-semibold flex items-center gap-3 @(isRunning ? "bg-red-50 text-red-700 border border-red-200" : "bg-emerald-50 text-emerald-700 border border-emerald-200")">
        <span id="runStatusDot" class="w-3 h-3 rounded-full @(isRunning ? "bg-red-500 animate-pulse" : "bg-emerald-500")"></span>
        <span id="runStatusText">@(isRunning ? "Procesando…" : "Listo")</span>
        <span id="runStatusDetail" class="text-xs font-normal opacity-80"></span>
    </div>

    <!-- ─── Decisiones pendientes ───────────────────────────────────────────── -->
    <div class="bg-white rounded-2xl border border-slate-200/80 shadow-xs p-6">
        <div class="flex items-center justify-between mb-5">
            <h3 class="font-bold text-slate-800 text-lg">Temáticas repetidas (pendientes de decisión)</h3>
        </div>

        @if (!Model.PendingDecisions.Any())
        {
            <div class="text-center py-10 text-slate-400 text-sm">
                No hay temáticas pendientes de decisión.
            </div>
        }
        else
        {
            <div class="divide-y divide-slate-100">
                @foreach (var d in Model.PendingDecisions)
                {
                    <div class="py-4 flex items-center justify-between gap-4">
                        <div class="min-w-0">
                            <p class="font-medium text-slate-800 text-sm truncate">@d.TopicTitle</p>
                            @if (!string.IsNullOrWhiteSpace(d.Source))
                            {
                                <p class="text-xs text-slate-400 mt-0.5">Fuente: @d.Source</p>
                            }
                        </div>
                        <div class="flex items-center gap-2 flex-shrink-0">
                            <form method="post" asp-area="Admin" asp-controller="Automation" asp-action="ResolveDecision"
                                  asp-route-runId="@d.RunId" asp-route-decisionId="@d.DecisionId" asp-route-continuar="true"
                                  data-confirm="¿Generar el artículo para esta temática?"
                                  data-loading="Generando…"
                                  class="flex items-center gap-2">
                                @Html.AntiForgeryToken()
                                <input type="datetime-local" name="scheduledAt"
                                       class="px-2 py-1.5 rounded-lg border border-slate-300 text-xs text-slate-600"
                                       title="Fecha de publicación opcional" />
                                <button type="submit"
                                        class="px-3 py-1.5 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-semibold transition-colors">
                                    Continuar
                                </button>
                            </form>
                            <form method="post" asp-area="Admin" asp-controller="Automation" asp-action="ResolveDecision"
                                  asp-route-runId="@d.RunId" asp-route-decisionId="@d.DecisionId" asp-route-continuar="false">
                                @Html.AntiForgeryToken()
                                <button type="submit"
                                        class="px-3 py-1.5 rounded-lg bg-slate-200 hover:bg-slate-300 text-slate-700 text-xs font-semibold transition-colors">
                                    Omitir
                                </button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <!-- ─── Últimas corridas ─────────────────────────────────────────────────── -->
    <div class="bg-white rounded-2xl border border-slate-200/80 shadow-xs p-6">
        <div class="flex items-center justify-between mb-5">
            <h3 class="font-bold text-slate-800 text-lg">Últimas corridas</h3>
            <a asp-area="Admin" asp-controller="Automation" asp-action="Historial"
               class="text-xs font-semibold text-[#00509D] hover:underline">Ver todas</a>
        </div>

        @if (!Model.RecentRuns.Any())
        {
            <div class="text-center py-10 text-slate-400 text-sm">Aún no se ha ejecutado ninguna corrida.</div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="w-full text-sm">
                    <thead>
                        <tr class="text-left text-xs uppercase tracking-wider text-slate-400 border-b border-slate-100">
                            <th class="py-2 pr-4">Fecha</th>
                            <th class="py-2 pr-4">Disparador</th>
                            <th class="py-2 pr-4">Estado</th>
                            <th class="py-2 pr-4">Temas</th>
                            <th class="py-2 pr-4">Artículos</th>
                            <th class="py-2"></th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        @foreach (var run in Model.RecentRuns)
                        {
                            <tr>
                                <td class="py-3 pr-4 text-slate-600">@run.StartedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="py-3 pr-4 text-slate-600">@(run.Trigger == AutomationTrigger.Manual ? "Manual" : "Programada")</td>
                                <td class="py-3 pr-4">
                                    @if (run.Status == AutomationRunStatus.Completado)
                                    {
                                        <span class="px-2 py-0.5 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">Completado</span>
                                    }
                                    else if (run.Status == AutomationRunStatus.Fallido)
                                    {
                                        <span class="px-2 py-0.5 rounded-full text-xs font-semibold bg-rose-50 text-rose-700 border border-rose-200">Fallido</span>
                                    }
                                    else
                                    {
                                        <span class="px-2 py-0.5 rounded-full text-xs font-semibold bg-slate-100 text-slate-600 border border-slate-200">En progreso</span>
                                    }
                                </td>
                                <td class="py-3 pr-4 text-slate-600">@run.DiscoveredTopicsCount</td>
                                <td class="py-3 pr-4 text-slate-600">@run.GeneratedArticles.Count</td>
                                <td class="py-3 text-right">
                                    <a asp-area="Admin" asp-controller="Automation" asp-action="Detalle" asp-route-id="@run.Id"
                                       class="text-xs font-semibold text-[#00509D] hover:underline">Detalle</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var spinner = '<svg class="w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path></svg> ';

            document.querySelectorAll('form[data-confirm]').forEach(function (form) {
                form.addEventListener('submit', function (e) {
                    if (!confirm(form.getAttribute('data-confirm'))) {
                        e.preventDefault();
                        return;
                    }

                    var text = form.getAttribute('data-loading') || 'Procesando…';
                    var btn = form.querySelector('button[type="submit"]');
                    if (btn) {
                        btn.disabled = true;
                        btn.classList.add('opacity-70', 'cursor-not-allowed');
                        btn.innerHTML = spinner + text;
                    }
                });
            });

            // ─── Barra de estado del proceso (rojo en curso → verde finalizado) ───
            var statusBar = document.getElementById('runStatusBar');
            var statusDot = document.getElementById('runStatusDot');
            var statusText = document.getElementById('runStatusText');
            var statusDetail = document.getElementById('runStatusDetail');
            var statusUrl = '@Url.Action("Estado", "Automation", new { area = "Admin" })';

            function renderStatus(data) {
                if (!statusBar) return;
                if (data.running) {
                    statusBar.className = 'rounded-xl px-4 py-3 text-sm font-semibold flex items-center gap-3 bg-red-50 text-red-700 border border-red-200';
                    statusDot.className = 'w-3 h-3 rounded-full bg-red-500 animate-pulse';
                    statusText.textContent = 'Procesando…';
                    statusDetail.textContent = 'La corrida está en curso.';
                } else {
                    statusBar.className = 'rounded-xl px-4 py-3 text-sm font-semibold flex items-center gap-3 bg-emerald-50 text-emerald-700 border border-emerald-200';
                    statusDot.className = 'w-3 h-3 rounded-full bg-emerald-500';
                    statusText.textContent = data.lastRun ? 'Finalizado' : 'Listo';
                    statusDetail.textContent = data.lastRun
                        ? (data.lastRun.status + ' · ' + data.lastRun.generatedCount + ' artículo(s) · ' + data.lastRun.trigger)
                        : '';
                }
            }

            function pollStatus() {
                if (!statusUrl) return;
                fetch(statusUrl, { headers: { 'Accept': 'application/json' } })
                    .then(function (r) { return r.ok ? r.json() : null; })
                    .then(function (data) { if (data) renderStatus(data); })
                    .catch(function () { });
            }

            if (statusBar) {
                pollStatus();
                setInterval(pollStatus, 3000);
            }
        })();
    </script>
}
