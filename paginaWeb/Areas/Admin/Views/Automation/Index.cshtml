@model AutomationIndexViewModel
@using Domine.Entities
@{
    ViewData["Title"] = "Automatización";
    var status = Model.Status;
    var fm = status.FrequencyMinutes;
    var freqLabel = fm >= 60 ? $"{fm / 60} h" + (fm % 60 > 0 ? $" {fm % 60} min" : "") : $"{fm} min";
    var isRunning = status.IsRunning;
}

@section HeaderActions {
    <a asp-area="Admin" asp-controller="Automation" asp-action="Configuracion"
       class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-[#00509D] hover:bg-[#003F88] text-white font-semibold text-sm shadow-sm transition-all">
        Configuración
    </a>
}

<div class="space-y-6">

    <!-- ─── Consumo y saldo ──────────────────────────────────────────────────── -->
    <section class="bg-white rounded-2xl border border-slate-200/80 p-6">
        <div class="flex items-center justify-between mb-5">
            <h3 class="font-bold text-slate-800 text-lg">Consumo y saldo</h3>
            <button type="button" id="refreshBalance"
                    class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-[#00509D] hover:bg-[#003F88] text-white text-xs font-semibold shadow-sm transition-colors">
                Actualizar saldo
            </button>
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4">
            <div class="rounded-xl border border-slate-200/80 p-4">
                <p class="text-[10px] font-semibold text-slate-500 uppercase tracking-wider">Tokens IA</p>
                <p id="usageTotalTokens" class="text-2xl font-bold text-[#00296B] mt-1">@Model.Status.Usage.TotalTokens</p>
            </div>
            <div class="rounded-xl border border-slate-200/80 p-4">
                <p class="text-[10px] font-semibold text-slate-500 uppercase tracking-wider">Créditos Serper</p>
                <p id="usageTotalCredits" class="text-2xl font-bold text-[#00509D] mt-1">@Model.Status.Usage.TotalCredits</p>
            </div>
            <div class="rounded-xl border border-slate-200/80 p-4">
                <p class="text-[10px] font-semibold text-slate-500 uppercase tracking-wider">Corridas</p>
                <p id="usageRunCount" class="text-2xl font-bold text-slate-800 mt-1">@Model.Status.Usage.RunCount</p>
            </div>
            <div class="rounded-xl border border-slate-200/80 p-4">
                <p class="text-[10px] font-semibold text-slate-500 uppercase tracking-wider">Tokens última</p>
                <p id="usageLastTokens" class="text-2xl font-bold text-slate-800 mt-1">@(Model.Status.LastRun?.TotalTokens ?? 0)</p>
            </div>
            <div class="rounded-xl border border-slate-200/80 p-4">
                <p class="text-[10px] font-semibold text-slate-500 uppercase tracking-wider">Saldo Serper</p>
                <p id="balanceSerper" class="text-2xl font-bold text-[#00509D] mt-1">—</p>
            </div>
            <div class="rounded-xl border border-slate-200/80 p-4">
                <p class="text-[10px] font-semibold text-slate-500 uppercase tracking-wider">Saldo IA</p>
                <p id="balanceAi" class="text-2xl font-bold text-[#00509D] mt-1">—</p>
            </div>
        </div>
    </section>

    <!-- ─── Tarjetas de estado ───────────────────────────────────────────────── -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        <div class="bg-white p-6 rounded-2xl border border-slate-200/80 flex items-center justify-between">
            <div>
                <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Estado</p>
                <h3 class="text-3xl font-bold mt-1 @(status.Paused ? "text-red-600" : "text-green-700")">
                    @(status.Paused ? "Pausada" : "Activa")
                </h3>
            </div>
            <div class="text-slate-300">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                </svg>
            </div>
        </div>

        <div class="bg-white p-6 rounded-2xl border border-slate-200/80 flex items-center justify-between">
            <div>
                <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Publicación</p>
                <h3 class="text-3xl font-bold mt-1 text-slate-800">@(status.AutoPublish ? "Automática" : "Borrador")</h3>
            </div>
            <div class="text-slate-300">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
            </div>
        </div>

        <div class="bg-white p-6 rounded-2xl border border-slate-200/80 flex items-center justify-between">
            <div>
                <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Decisiones pendientes</p>
                <h3 class="text-3xl font-bold mt-1 text-slate-800">@status.PendingDecisionsCount</h3>
            </div>
            <div class="text-slate-300">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" />
                </svg>
            </div>
        </div>

        <div class="bg-white p-6 rounded-2xl border border-slate-200/80 flex items-center justify-between">
            <div>
                <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Frecuencia</p>
                <h3 class="text-3xl font-bold mt-1 text-slate-800">@freqLabel</h3>
            </div>
            <div class="text-slate-300">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
            </div>
        </div>
    </div>

    <!-- ─── Acciones ────────────────────────────────────────────────────────── -->
    <div class="flex flex-wrap items-center gap-3">
        <form method="post" asp-area="Admin" asp-controller="Automation" asp-action="Run"
              id="runForm"
              class="@(isRunning ? "hidden" : "")"
              data-confirm="¿Ejecutar la automatización ahora? Se consultarán Serper e IA y puede tardar unos segundos."
              data-confirm-type="primary"
              data-loading="Iniciando…">
            @Html.AntiForgeryToken()
            <button type="submit"
                    class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-[#FDC500] hover:bg-[#FFD500] text-[#00296B] font-semibold text-sm shadow-sm transition-all">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
                </svg>
                Ejecutar ahora
            </button>
        </form>

        <form method="post" asp-area="Admin" asp-controller="Automation" asp-action="Stop"
              id="stopForm"
              class="flex items-center gap-2 @(isRunning ? "" : "hidden")"
              data-confirm="¿Detener la corrida en curso? Se cancelará la generación actual."
              data-confirm-type="warning"
              data-loading="Deteniendo…">
            @Html.AntiForgeryToken()
            <button type="submit"
                    class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-rose-600 hover:bg-rose-700 text-white font-semibold text-sm shadow-sm transition-all">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <rect x="6" y="6" width="12" height="12" rx="1.5" stroke-width="2" />
                </svg>
                Detener
            </button>
        </form>

        <form method="post" asp-area="Admin" asp-controller="Automation" asp-action="TogglePause"
              data-confirm="@(status.Paused ? "¿Reanudar la automatización?" : "¿Pausar la automatización? Se detendrán las corridas programadas.")"
              data-confirm-type="@(status.Paused ? "success" : "warning")"
              data-loading="Procesando…">
            @Html.AntiForgeryToken()
            <button type="submit"
                    class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-[#00509D] hover:bg-[#003F88] text-white font-semibold text-sm shadow-sm transition-all">
                @(status.Paused ? "Reanudar" : "Pausar")
            </button>
        </form>

        <a asp-area="Admin" asp-controller="Automation" asp-action="Historial"
           class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-[#00296B] hover:bg-[#003F88] text-white font-semibold text-sm shadow-sm transition-all">
            Ver historial
        </a>
    </div>

    <!-- ─── Barra de estado del proceso ─────────────────────────────────────── -->
    <div id="runStatusBar" class="rounded-xl px-5 py-3.5 text-sm font-semibold flex items-center gap-3 @(isRunning ? "bg-red-600 text-white border border-red-700" : "bg-green-600 text-white border border-green-700")">
        <span id="runStatusDot" class="w-2.5 h-2.5 rounded-full bg-white flex-shrink-0 @(isRunning ? "animate-pulse" : "")"></span>
        <span id="runStatusText">@(isRunning ? "Procesando…" : "Listo")</span>
        <span id="runStatusDetail" class="text-xs font-normal opacity-80 ml-1"></span>
    </div>

    <!-- ─── Decisiones pendientes ───────────────────────────────────────────── -->
    <div class="bg-white rounded-2xl border border-slate-200/80 p-6">
        <div class="flex items-center justify-between mb-5">
            <h3 class="font-bold text-slate-800 text-lg">Decisiones pendientes <span class="text-slate-400 font-normal text-base">(requieren tu confirmación)</span></h3>
        </div>

        @if (!Model.PendingDecisions.Any())
        {
            <div class="text-center py-10 text-slate-400 text-sm">
                No hay decisiones pendientes de confirmación.
            </div>
        }
        else
        {
            <div class="divide-y divide-slate-100">
                @foreach (var d in Model.PendingDecisions)
                {
                    var isValidation = d.Kind == AutomationDecisionKind.Validacion;

                    <div class="py-4 flex flex-col gap-3">
                        <div class="flex flex-col sm:flex-row sm:items-start gap-3 sm:gap-4">
                            <div class="min-w-0 flex-1">
                                <div class="flex flex-wrap items-center gap-2">
                                    <p class="font-medium text-slate-800 text-sm">@d.TopicTitle</p>
                                    @if (isValidation)
                                    {
                                        <span class="px-2 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-amber-100 text-amber-800 border border-amber-200">
                                            Fuera de estándar
                                        </span>
                                    }
                                </div>
                                @if (!string.IsNullOrWhiteSpace(d.Source))
                                {
                                    <p class="text-xs text-slate-400 mt-0.5">Fuente: @d.Source</p>
                                }
                                @if (isValidation && d.ValidationErrors.Any())
                                {
                                    <ul class="mt-2.5 space-y-1 rounded-lg border border-rose-200 bg-rose-50 p-3 text-xs text-rose-700 list-disc list-inside">
                                        @foreach (var error in d.ValidationErrors)
                                        {
                                            <li>@error</li>
                                        }
                                    </ul>
                                }
                            </div>
                            <div class="flex flex-wrap items-center gap-2 flex-shrink-0">
                                <form method="post" asp-area="Admin" asp-controller="Automation" asp-action="ResolveDecision"
                                      asp-route-runId="@d.RunId" asp-route-decisionId="@d.DecisionId" asp-route-continuar="true"
                                      data-confirm="@(isValidation ? "El artículo no cumple los estándares configurados. ¿Guardarlo de todos modos?" : "¿Generar el artículo para esta temática?")"
                                      data-confirm-type="@(isValidation ? "warning" : "primary")"
                                      data-loading="@(isValidation ? "Guardando…" : "Generando…")"
                                      class="flex items-center gap-2">
                                    @Html.AntiForgeryToken()
                                    <input type="datetime-local" name="scheduledAt"
                                           class="px-2.5 py-1.5 rounded-lg border border-slate-300 text-xs text-slate-600 bg-white focus:outline-none focus:ring-2 focus:ring-[#00509D]/30 focus:border-[#00509D]"
                                           title="Fecha de publicación opcional" />
                                    <button type="submit"
                                            class="px-3.5 py-1.5 rounded-lg text-white text-xs font-semibold transition-colors @(isValidation ? "bg-amber-500 hover:bg-amber-600" : "bg-emerald-600 hover:bg-emerald-700")">
                                        @(isValidation ? "Guardar de todos modos" : "Continuar")
                                    </button>
                                </form>
                                <form method="post" asp-area="Admin" asp-controller="Automation" asp-action="ResolveDecision"
                                      asp-route-runId="@d.RunId" asp-route-decisionId="@d.DecisionId" asp-route-continuar="false">
                                    @Html.AntiForgeryToken()
                                    <button type="submit"
                                            class="px-3.5 py-1.5 rounded-lg bg-slate-500 hover:bg-slate-600 text-white text-xs font-semibold transition-colors">
                                        @(isValidation ? "Descartar" : "Omitir")
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <!-- ─── Últimas corridas ─────────────────────────────────────────────────── -->
    <div class="bg-white rounded-2xl border border-slate-200/80 p-6">
        <div class="flex items-center justify-between mb-5">
            <h3 class="font-bold text-slate-800 text-lg">Últimas corridas</h3>
            <a asp-area="Admin" asp-controller="Automation" asp-action="Historial"
               class="text-xs font-semibold text-[#00509D] hover:underline">Ver todas</a>
        </div>

        @if (!Model.RecentRuns.Any())
        {
            <div class="text-center py-10 text-slate-400 text-sm">Aún no se ha ejecutado ninguna corrida.</div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="w-full text-sm">
                    <thead>
                        <tr class="text-left text-xs uppercase tracking-wider text-slate-400 border-b border-slate-100">
                            <th class="pb-3 pr-4 font-semibold">Fecha</th>
                            <th class="pb-3 pr-4 font-semibold">Disparador</th>
                            <th class="pb-3 pr-4 font-semibold">Estado</th>
                            <th class="pb-3 pr-4 font-semibold">Temas</th>
                            <th class="pb-3 pr-4 font-semibold">Artículos</th>
                            <th class="pb-3"></th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        @foreach (var run in Model.RecentRuns)
                        {
                            <tr class="hover:bg-slate-50 transition-colors">
                                <td class="py-3.5 pr-4 text-slate-600">@run.StartedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="py-3.5 pr-4 text-slate-600">@(run.Trigger == AutomationTrigger.Manual ? "Manual" : "Programada")</td>
                                <td class="py-3.5 pr-4">
                                    @if (run.Status == AutomationRunStatus.Completado)
                                    {
                                        <span class="px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">Completado</span>
                                    }
                                    else if (run.Status == AutomationRunStatus.Fallido)
                                    {
                                        <span class="px-2.5 py-1 rounded-full text-xs font-semibold bg-rose-50 text-rose-700 border border-rose-200">Fallido</span>
                                    }
                                    else if (run.Status == AutomationRunStatus.Detenido)
                                    {
                                        <span class="px-2.5 py-1 rounded-full text-xs font-semibold bg-slate-100 text-slate-600 border border-slate-200">Detenido</span>
                                    }
                                    else
                                    {
                                        <span class="px-2.5 py-1 rounded-full text-xs font-semibold bg-amber-50 text-amber-700 border border-amber-200">En progreso</span>
                                    }
                                </td>
                                <td class="py-3.5 pr-4 text-slate-600">@run.DiscoveredTopicsCount</td>
                                <td class="py-3.5 pr-4 text-slate-600">@run.GeneratedArticles.Count</td>
                                <td class="py-3.5 text-right">
                                    <a asp-area="Admin" asp-controller="Automation" asp-action="Detalle" asp-route-id="@run.Id"
                                       class="text-xs font-semibold text-[#00509D] hover:underline">Detalle</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            // ─── Barra de estado del proceso (rojo en curso → verde finalizado) ───
            var statusBar = document.getElementById('runStatusBar');
            var statusDot = document.getElementById('runStatusDot');
            var statusText = document.getElementById('runStatusText');
            var statusDetail = document.getElementById('runStatusDetail');
            var statusUrl = '@Url.Action("Estado", "Automation", new { area = "Admin" })';
            var runForm = document.getElementById('runForm');
            var stopForm = document.getElementById('stopForm');

            function setRunning(running) {
                if (runForm) runForm.classList.toggle('hidden', running);
                if (stopForm) stopForm.classList.toggle('hidden', !running);
            }

            function renderStatus(data) {
                if (!statusBar) return;
                setRunning(!!data.running);
                if (data.running) {
                    statusBar.className = 'rounded-xl px-4 py-3 text-sm font-semibold flex items-center gap-3 bg-red-600 text-white border border-red-700';
                    statusDot.className = 'w-3 h-3 rounded-full bg-white animate-pulse';
                    statusText.textContent = 'Procesando…';
                    statusDetail.textContent = 'La corrida está en curso.';
                } else {
                    statusBar.className = 'rounded-xl px-4 py-3 text-sm font-semibold flex items-center gap-3 bg-green-600 text-white border border-green-700';
                    statusDot.className = 'w-3 h-3 rounded-full bg-white';
                    statusText.textContent = data.lastRun ? 'Finalizado' : 'Listo';
                    statusDetail.textContent = data.lastRun
                        ? (data.lastRun.status + ' · ' + data.lastRun.generatedCount + ' artículo(s) · ' + data.lastRun.trigger)
                        : '';
                }

                if (data.usage) {
                    var t = document.getElementById('usageTotalTokens');
                    var c = document.getElementById('usageTotalCredits');
                    var n = document.getElementById('usageRunCount');
                    if (t) t.textContent = data.usage.totalTokens;
                    if (c) c.textContent = data.usage.totalCredits;
                    if (n) n.textContent = data.usage.runCount;
                }
                if (data.lastRun) {
                    var lt = document.getElementById('usageLastTokens');
                    if (lt) lt.textContent = data.lastRun.totalTokens || 0;
                }
            }

            function pollStatus() {
                if (!statusUrl) return;
                fetch(statusUrl, { headers: { 'Accept': 'application/json' }, cache: 'no-store' })
                    .then(function (r) { return r.ok ? r.json() : null; })
                    .then(function (data) { if (data) renderStatus(data); })
                    .catch(function () { });
            }

            if (statusBar) {
                setRunning(@isRunning.ToString().ToLowerInvariant());
                pollStatus();
                setInterval(pollStatus, 3000);
            }

            // ─── Saldo disponible (Serper / IA) ─────────────────────────────────
            var balanceUrl = '@Url.Action("Saldo", "Automation", new { area = "Admin" })';
            var refreshBtn = document.getElementById('refreshBalance');

            function refreshBalance() {
                if (!balanceUrl) return;
                if (refreshBtn) { refreshBtn.disabled = true; refreshBtn.textContent = 'Actualizando…'; }

                fetch(balanceUrl + '?t=' + Date.now(), { headers: { 'Accept': 'application/json' }, cache: 'no-store' })
                    .then(function (r) { return r.ok ? r.json() : null; })
                    .then(function (b) {
                        if (!b) return;
                        var s = document.getElementById('balanceSerper');
                        var a = document.getElementById('balanceAi');
                        if (s) {
                            s.textContent = (b.serperCredits === null || b.serperCredits === undefined)
                                ? 'No disponible'
                                : (b.serperCredits + ' créditos');
                        }
                        if (a) {
                            if (b.aiBalance !== null && b.aiBalance !== undefined) {
                                a.textContent = (b.aiCurrency ? b.aiCurrency + ' ' : '') + b.aiBalance;
                            } else {
                                a.textContent = b.aiNote || 'No disponible';
                            }
                        }
                    })
                    .catch(function () { })
                    .finally(function () {
                        if (refreshBtn) { refreshBtn.disabled = false; refreshBtn.textContent = 'Actualizar saldo'; }
                    });
            }

            if (refreshBtn) refreshBtn.addEventListener('click', refreshBalance);
            refreshBalance();
            setInterval(refreshBalance, 60000);
        })();
    </script>
}
