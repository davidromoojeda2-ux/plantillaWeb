@model List<Domine.Entities.AutomationRun>
@using Domine.Entities
@{
    ViewData["Title"] = "Historial de Automatización";
    var page = (int)(ViewBag.Page ?? 1);
}

<div class="bg-white rounded-2xl border border-slate-200/80 shadow-xs p-6">
    <div class="flex items-center justify-between mb-5">
        <h3 class="font-bold text-slate-800 text-lg">Historial de corridas</h3>
        <a asp-area="Admin" asp-controller="Automation" asp-action="Index"
           class="text-xs font-semibold text-[#00509D] hover:underline">Volver al panel</a>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-10 text-slate-400 text-sm">No hay corridas registradas.</div>
    }
    else
    {
        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead class="bg-slate-50 border-b border-slate-100">
                    <tr class="text-left text-xs font-semibold uppercase text-slate-500 tracking-wider">
                        <th class="py-3.5 pr-4">Fecha</th>
                        <th class="py-3.5 pr-4">Disparador</th>
                        <th class="py-3.5 pr-4">Estado</th>
                        <th class="py-3.5 pr-4">Temas</th>
                        <th class="py-3.5 pr-4">Artículos</th>
                        <th class="py-3.5 pr-4">Decisiones</th>
                        <th class="py-3.5"></th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @foreach (var run in Model)
                    {
                        <tr class="hover:bg-slate-50/60 transition-colors">
                            <td class="py-3.5 pr-4 text-slate-600">@run.StartedAt.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="py-3.5 pr-4 text-slate-600">@(run.Trigger == AutomationTrigger.Manual ? "Manual" : "Programada")</td>
                            <td class="py-3.5 pr-4">
                                @if (run.Status == AutomationRunStatus.Completado)
                                {
                                    <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">Completado</span>
                                }
                                else if (run.Status == AutomationRunStatus.Fallido)
                                {
                                    <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-rose-50 text-rose-700 border border-rose-200">Fallido</span>
                                }
                                else
                                {
                                    <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-amber-50 text-amber-700 border border-amber-200">En progreso</span>
                                }
                            </td>
                            <td class="py-3.5 pr-4 text-slate-600">@run.DiscoveredTopicsCount</td>
                            <td class="py-3.5 pr-4 text-slate-600">@run.GeneratedArticles.Count</td>
                            <td class="py-3.5 pr-4 text-slate-600">@run.PendingDecisions.Count</td>
                            <td class="py-3.5 text-right">
                                <a asp-area="Admin" asp-controller="Automation" asp-action="Detalle" asp-route-id="@run.Id"
                                   class="text-xs font-semibold text-[#00509D] hover:underline">Detalle</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="mt-6 pt-4 border-t border-slate-100 flex items-center gap-2">
            @if (page > 1)
            {
                <a asp-area="Admin" asp-controller="Automation" asp-action="Historial" asp-route-page="@(page - 1)"
                   class="px-3 py-1.5 rounded-xl border border-slate-300 bg-white text-slate-700 text-xs font-semibold hover:bg-slate-50 transition">← Anterior</a>
            }
            <a asp-area="Admin" asp-controller="Automation" asp-action="Historial" asp-route-page="@(page + 1)"
               class="px-3 py-1.5 rounded-xl border border-slate-300 bg-white text-slate-700 text-xs font-semibold hover:bg-slate-50 transition">Siguiente →</a>
        </div>
    }
</div>
