@model List<Domine.Entities.AutomationRun>
@using Domine.Entities
@{
    ViewData["Title"] = "Historial de Automatización";
    var page = (int)(ViewBag.Page ?? 1);
}

<div class="bg-white rounded-2xl border border-slate-200/80 shadow-xs p-6">
    <div class="flex items-center justify-between mb-5">
        <h3 class="font-bold text-slate-800 text-lg">Historial de corridas</h3>
        <a asp-area="Admin" asp-controller="Automation" asp-action="Index"
           class="text-xs font-semibold text-[#00509D] hover:underline">Volver al panel</a>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-10 text-slate-400 text-sm">No hay corridas registradas.</div>
    }
    else
    {
        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead>
                    <tr class="text-left text-xs uppercase tracking-wider text-slate-400 border-b border-slate-100">
                        <th class="py-2 pr-4">Fecha</th>
                        <th class="py-2 pr-4">Disparador</th>
                        <th class="py-2 pr-4">Estado</th>
                        <th class="py-2 pr-4">Temas</th>
                        <th class="py-2 pr-4">Artículos</th>
                        <th class="py-2 pr-4">Decisiones</th>
                        <th class="py-2"></th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @foreach (var run in Model)
                    {
                        <tr>
                            <td class="py-3 pr-4 text-slate-600">@run.StartedAt.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="py-3 pr-4 text-slate-600">@(run.Trigger == AutomationTrigger.Manual ? "Manual" : "Programada")</td>
                            <td class="py-3 pr-4">@run.Status</td>
                            <td class="py-3 pr-4 text-slate-600">@run.DiscoveredTopicsCount</td>
                            <td class="py-3 pr-4 text-slate-600">@run.GeneratedArticles.Count</td>
                            <td class="py-3 pr-4 text-slate-600">@run.PendingDecisions.Count</td>
                            <td class="py-3 text-right">
                                <a asp-area="Admin" asp-controller="Automation" asp-action="Detalle" asp-route-id="@run.Id"
                                   class="text-xs font-semibold text-[#00509D] hover:underline">Detalle</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="mt-4 flex items-center gap-2">
            @if (page > 1)
            {
                <a asp-area="Admin" asp-controller="Automation" asp-action="Historial" asp-route-page="@(page - 1)"
                   class="px-3 py-1.5 rounded-lg border border-slate-300 text-slate-600 text-sm hover:bg-slate-100">Anterior</a>
            }
            <a asp-area="Admin" asp-controller="Automation" asp-action="Historial" asp-route-page="@(page + 1)"
               class="px-3 py-1.5 rounded-lg border border-slate-300 text-slate-600 text-sm hover:bg-slate-100">Siguiente</a>
        </div>
    }
</div>
