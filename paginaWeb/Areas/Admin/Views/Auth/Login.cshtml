@model Aplication.DTOs.AdminLoginDto
@{
    Layout = null;
    ViewData["Title"] = "Acceso al Panel Administrativo";
}

<!DOCTYPE html>
<html lang="es" class="h-full bg-slate-900">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Portal Informativo</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Merriweather:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/tailwind.css" asp-append-version="true" />
</head>
<body class="h-full font-sans antialiased flex items-center justify-center p-4 bg-gradient-to-br from-[#001D4A] via-[#00296B] to-[#003F88]">

    <div class="w-full max-w-md">
        <!-- Logo / Marca -->
        <div class="text-center mb-8">
            <div class="inline-flex items-center justify-center w-14 h-14 rounded-2xl bg-[#FDC500] text-[#00296B] font-bold text-2xl shadow-xl mb-4">
                N
            </div>
            <h1 class="text-2xl font-bold text-white tracking-tight">Portal Informativo</h1>
            <p class="text-sm text-blue-200 mt-1">Gestor de Contenidos y Noticias</p>
        </div>

        <!-- Tarjeta de Login -->
        <div class="bg-white rounded-2xl shadow-2xl p-8 border border-white/20">
            <h2 class="text-xl font-bold text-slate-800 mb-6 text-center">Iniciar Sesión</h2>

            @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
            {
                <div class="mb-5 p-3.5 rounded-xl bg-rose-50 border border-rose-200 text-rose-700 text-sm flex items-center gap-2">
                    <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                    <span>@ViewData.ModelState[string.Empty]?.Errors[0].ErrorMessage</span>
                </div>
            }

            <form method="post" action="/admin/login" class="space-y-5">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

                <div>
                    <label asp-for="Username" class="block text-xs font-semibold uppercase tracking-wider text-slate-600 mb-1.5">Usuario</label>
                    <input asp-for="Username" type="text" autocomplete="username" required
                           class="w-full px-4 py-2.5 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-[#00509D] focus:border-transparent transition-all text-sm"
                           placeholder="ej: admin" />
                    <span asp-validation-for="Username" class="text-xs text-rose-600 mt-1 block"></span>
                </div>

                <div>
                    <label asp-for="Password" class="block text-xs font-semibold uppercase tracking-wider text-slate-600 mb-1.5">Contraseña</label>
                    <input asp-for="Password" type="password" autocomplete="current-password" required
                           class="w-full px-4 py-2.5 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-[#00509D] focus:border-transparent transition-all text-sm"
                           placeholder="••••••••" />
                    <span asp-validation-for="Password" class="text-xs text-rose-600 mt-1 block"></span>
                </div>

                <div class="flex items-center justify-between text-sm">
                    <label class="flex items-center gap-2 text-slate-600 cursor-pointer">
                        <input asp-for="RememberMe" type="checkbox" class="rounded border-slate-300 text-[#00296B] focus:ring-[#00296B]" />
                        <span>Recordarme</span>
                    </label>
                </div>

                <button type="submit"
                        class="w-full py-3 px-4 rounded-xl bg-[#FDC500] hover:bg-[#FFD500] text-[#00296B] font-bold text-sm shadow-md hover:shadow-lg transition-all duration-200">
                    Acceder al Panel
                </button>
            </form>

            <div class="mt-6 pt-6 border-t border-slate-100 text-center text-xs text-slate-500">
                <span class="block text-slate-400 mb-1">Credenciales predeterminadas para entorno local:</span>
                <span class="font-mono bg-slate-100 px-2 py-1 rounded text-slate-700">admin / Admin123!</span>
            </div>
        </div>

        <div class="text-center mt-6">
            <a href="/" class="text-xs text-blue-200 hover:text-white transition-colors">
                ← Volver al portal público
            </a>
        </div>
    </div>

</body>
</html>
