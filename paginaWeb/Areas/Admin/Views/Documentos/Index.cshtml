@model paginaWeb.Areas.Admin.Models.DocumentLibraryViewModel
@{
    ViewData["Title"] = "Biblioteca de Documentos";
    var acceptedExtensions = string.Join(",", Model.AllowedExtensions);
}

<div class="space-y-8">
    @if (TempData["Success"] != null)
    {
        <div class="p-4 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-sm flex items-start gap-3 shadow-xs">
            <svg class="w-5 h-5 text-emerald-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            <div>
                <p class="font-semibold">Operación exitosa</p>
                <p class="text-xs text-emerald-700 mt-0.5">@TempData["Success"]</p>
            </div>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="p-4 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-sm flex items-start gap-3 shadow-xs">
            <svg class="w-5 h-5 text-rose-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            <div>
                <p class="font-semibold">No se pudo completar la operación</p>
                <p class="text-xs text-rose-700 mt-0.5">@TempData["Error"]</p>
            </div>
        </div>
    }

    <div class="bg-white rounded-2xl border border-slate-200/80 shadow-xs p-6">
        <div class="flex items-start justify-between gap-4 mb-4">
            <div>
                <h3 class="font-bold text-slate-800 text-base">Subir documento</h3>
                <p class="text-xs text-slate-500 mt-0.5">
                    Formatos permitidos: @string.Join(", ", Model.AllowedExtensions). Los archivos se validan por extensión, tamaño y firma real.
                </p>
            </div>
        </div>

        <form method="post" asp-area="Admin" asp-controller="Documentos" asp-action="Upload" enctype="multipart/form-data" class="space-y-4">
            @Html.AntiForgeryToken()

            <div class="grid grid-cols-1 md:grid-cols-12 gap-4">
                <div class="md:col-span-4">
                    <label class="block text-xs font-semibold uppercase tracking-wider text-slate-600 mb-1.5">
                        Archivo <span class="text-rose-500">*</span>
                    </label>
                    <input type="file" name="file" accept="@acceptedExtensions" required
                           class="w-full text-xs text-slate-500 file:mr-3 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-semibold file:bg-blue-50 file:text-[#003F88] hover:file:bg-blue-100 cursor-pointer border border-slate-200 rounded-xl p-1 bg-slate-50" />
                </div>

                <div class="md:col-span-4">
                    <label class="block text-xs font-semibold uppercase tracking-wider text-slate-600 mb-1.5">Nombre visible</label>
                    <input type="text" name="displayName" maxlength="200" placeholder="Ej. Informe anual 2026"
                           class="w-full text-sm rounded-xl border border-slate-300 px-3 py-2 focus:ring-2 focus:ring-[#00509D] focus:outline-none" />
                </div>

                <div class="md:col-span-4">
                    <label class="block text-xs font-semibold uppercase tracking-wider text-slate-600 mb-1.5">Descripción</label>
                    <input type="text" name="description" maxlength="1000" placeholder="Breve descripción opcional"
                           class="w-full text-sm rounded-xl border border-slate-300 px-3 py-2 focus:ring-2 focus:ring-[#00509D] focus:outline-none" />
                </div>
            </div>

            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pt-3 border-t border-slate-100">
                <label class="flex items-center gap-2 cursor-pointer">
                    <input type="checkbox" name="isPublic" value="true" class="rounded border-slate-300 text-[#00296B] focus:ring-[#00296B]" />
                    <span class="text-xs text-slate-700 font-medium">Descarga pública sin depender de un artículo publicado</span>
                </label>

                <button type="submit" class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl bg-[#00296B] hover:bg-[#003F88] text-white font-bold text-sm shadow-sm transition">
                    <svg class="w-4 h-4 text-[#FDC500]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" /></svg>
                    Subir y guardar
                </button>
            </div>
        </form>
    </div>

    <div class="bg-white rounded-2xl border border-slate-200/80 shadow-xs p-5">
        <form method="get" asp-area="Admin" asp-controller="Documentos" asp-action="Index" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-12 gap-3 items-center">
            <div class="lg:col-span-4">
                <div class="relative">
                    <input type="text" name="search" value="@Model.Search" placeholder="Buscar por nombre o descripción..."
                           class="w-full pl-9 pr-3 py-2 text-sm rounded-xl border border-slate-300 focus:ring-2 focus:ring-[#00509D] focus:outline-none" />
                    <svg class="w-4 h-4 text-slate-400 absolute left-3 top-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
                </div>
            </div>

            <div class="lg:col-span-2">
                <select name="storage" class="w-full text-sm rounded-xl border border-slate-300 px-3 py-2 bg-white focus:ring-2 focus:ring-[#00509D] focus:outline-none">
                    <option value="">-- Almacenamiento --</option>
                    <option value="s3" selected="@(Model.StorageFilter == "s3" || Model.StorageFilter == "r2")">S3 / R2</option>
                    <option value="local" selected="@(Model.StorageFilter == "local")">Local</option>
                </select>
            </div>

            <div class="lg:col-span-2">
                <select name="extension" class="w-full text-sm rounded-xl border border-slate-300 px-3 py-2 bg-white focus:ring-2 focus:ring-[#00509D] focus:outline-none">
                    <option value="">-- Formato --</option>
                    @foreach (var extension in Model.AllowedExtensions)
                    {
                        <option value="@extension" selected="@(Model.ExtensionFilter == extension)">@extension.TrimStart('.').ToUpperInvariant()</option>
                    }
                </select>
            </div>

            <div class="lg:col-span-2">
                <select name="articleId" class="w-full text-sm rounded-xl border border-slate-300 px-3 py-2 bg-white focus:ring-2 focus:ring-[#00509D] focus:outline-none">
                    <option value="">-- Artículo --</option>
                    <option value="linked" selected="@(Model.ArticleFilter == "linked")">Con artículo</option>
                    <option value="none" selected="@(Model.ArticleFilter == "none")">Sin artículo</option>
                    @foreach (var article in Model.Articles)
                    {
                        <option value="@article.Id" selected="@(Model.ArticleFilter == article.Id)">@article.Title</option>
                    }
                </select>
            </div>

            <div class="lg:col-span-2 flex gap-2">
                <button type="submit" class="flex-1 py-2 px-3 rounded-xl bg-slate-800 hover:bg-slate-900 text-white text-xs font-semibold transition">Filtrar</button>
                @if (!string.IsNullOrEmpty(Model.Search) || !string.IsNullOrEmpty(Model.StorageFilter) ||
                     !string.IsNullOrEmpty(Model.ExtensionFilter) || !string.IsNullOrEmpty(Model.ArticleFilter))
                {
                    <a asp-area="Admin" asp-controller="Documentos" asp-action="Index"
                       class="py-2 px-3 rounded-xl border border-slate-300 text-slate-600 hover:bg-slate-100 text-xs font-semibold transition">Limpiar</a>
                }
            </div>
        </form>
    </div>

    <div class="bg-white rounded-2xl border border-slate-200/80 shadow-xs p-6">
        <div class="flex items-center justify-between mb-5">
            <div>
                <h3 class="font-bold text-slate-800 text-lg">Documentos disponibles</h3>
                <p class="text-xs text-slate-400">Total encontrado: @Model.TotalCount documentos</p>
            </div>
            @if (Model.TotalPages > 1)
            {
                <span class="text-xs text-slate-500 font-medium">Página @Model.CurrentPage de @Model.TotalPages</span>
            }
        </div>

        @if (!Model.Documents.Any())
        {
            <div class="py-16 text-center text-slate-400">
                <svg class="w-16 h-16 mx-auto text-slate-300 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
                <p class="font-semibold text-slate-700 text-base">No se encontraron documentos.</p>
                <p class="text-xs text-slate-400 mt-1">Sube un documento o ajusta los filtros de búsqueda.</p>
            </div>
        }
        else
        {
            <div class="space-y-3">
                @foreach (var document in Model.Documents)
                {
                    var extensionLabel = document.Extension.TrimStart('.').ToUpperInvariant();
                    var iconClass = document.Extension.ToLowerInvariant() switch
                    {
                        ".pdf" => "bg-rose-50 text-rose-600",
                        ".doc" or ".docx" or ".odt" or ".rtf" => "bg-blue-50 text-blue-600",
                        ".xls" or ".xlsx" or ".ods" or ".csv" => "bg-emerald-50 text-emerald-600",
                        ".ppt" or ".pptx" or ".odp" => "bg-amber-50 text-amber-600",
                        _ => "bg-slate-100 text-slate-500"
                    };
                    var isCloud = document.Storage.Equals("s3", StringComparison.OrdinalIgnoreCase) ||
                                  document.Storage.Equals("r2", StringComparison.OrdinalIgnoreCase);

                    <div class="flex flex-col lg:flex-row lg:items-center gap-4 rounded-2xl border border-slate-200 bg-slate-50/40 p-4 hover:border-slate-300 transition">
                        <div class="flex items-start gap-3.5 min-w-0 flex-1">
                            <span class="inline-flex h-12 w-12 shrink-0 items-center justify-center rounded-xl text-[11px] font-black @iconClass">
                                @extensionLabel
                            </span>
                            <div class="min-w-0">
                                <div class="flex flex-wrap items-center gap-2">
                                    <p class="text-sm font-bold text-slate-800 truncate" title="@document.OriginalFileName">@document.DisplayName</p>
                                    <span class="px-2 py-0.5 rounded-full text-[10px] font-bold border @(document.IsPublic ? "bg-emerald-50 text-emerald-700 border-emerald-200" : "bg-slate-100 text-slate-600 border-slate-200")">
                                        @(document.IsPublic ? "Público" : "Privado")
                                    </span>
                                    <span class="px-2 py-0.5 rounded-full text-[10px] font-bold border @(isCloud ? "bg-indigo-50 text-indigo-700 border-indigo-200" : "bg-amber-50 text-amber-700 border-amber-200")">
                                        @(isCloud ? "S3 / R2" : "Local")
                                    </span>
                                </div>
                                <p class="text-[11px] text-slate-500 mt-1">
                                    @document.OriginalFileName · @DocumentMapper.FormatSize(document.SizeBytes) · @document.UploadedAt.ToString("dd/MM/yyyy HH:mm") · @document.DownloadCount descargas
                                </p>
                                @if (!string.IsNullOrWhiteSpace(document.Description))
                                {
                                    <p class="text-[11px] text-slate-500 mt-1 line-clamp-2">@document.Description</p>
                                }
                                @if (!string.IsNullOrEmpty(document.ArticleId))
                                {
                                    <a asp-area="Admin" asp-controller="Articulos" asp-action="Edit" asp-route-id="@document.ArticleId"
                                       class="mt-1.5 inline-flex items-center gap-1 text-[11px] font-semibold text-[#00509D] hover:underline">
                                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 010 5.656l-3 3a4 4 0 01-5.656-5.656l1.5-1.5m5.656-5.656l1.5-1.5a4 4 0 015.656 5.656l-3 3a4 4 0 01-5.656 0" /></svg>
                                        @document.ArticleTitle
                                    </a>
                                }
                            </div>
                        </div>

                        <div class="flex items-center gap-2 shrink-0">
                            <a asp-area="Admin" asp-controller="Documentos" asp-action="Download" asp-route-id="@document.Id"
                               class="px-3 py-1.5 rounded-lg border border-slate-300 bg-white text-xs font-semibold text-slate-700 hover:bg-slate-100 transition">
                                Descargar
                            </a>
                            <button type="button"
                                    data-document-edit
                                    data-document-id="@document.Id"
                                    data-document-name="@document.DisplayName"
                                    data-document-description="@document.Description"
                                    data-document-public="@document.IsPublic.ToString().ToLowerInvariant()"
                                    class="px-3 py-1.5 rounded-lg border border-slate-300 bg-white text-xs font-semibold text-slate-700 hover:bg-slate-100 transition">
                                Editar
                            </button>
                            <form method="post" asp-area="Admin" asp-controller="Documentos" asp-action="Delete" asp-route-id="@document.Id"
                                  data-confirm="¿Eliminar este documento? También se quitará de los artículos que lo usen."
                                  data-confirm-type="danger" class="inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="px-3 py-1.5 rounded-lg border border-rose-200 bg-rose-50 text-xs font-semibold text-rose-700 hover:bg-rose-100 transition">
                                    Eliminar
                                </button>
                            </form>
                        </div>
                    </div>
                }
            </div>

            @if (Model.TotalPages > 1)
            {
                <div class="flex flex-col sm:flex-row items-center justify-between gap-4 mt-8 pt-6 border-t border-slate-200">
                    <p class="text-xs text-slate-500">
                        Mostrando documentos <strong>@((Model.CurrentPage - 1) * Model.PageSize + 1)</strong> a
                        <strong>@(Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalCount))</strong> de
                        <strong>@Model.TotalCount</strong>
                    </p>

                    <nav class="flex items-center gap-1.5">
                        @if (Model.HasPreviousPage)
                        {
                            <a asp-area="Admin" asp-controller="Documentos" asp-action="Index"
                               asp-route-page="@(Model.CurrentPage - 1)"
                               asp-route-search="@Model.Search"
                               asp-route-storage="@Model.StorageFilter"
                               asp-route-extension="@Model.ExtensionFilter"
                               asp-route-articleId="@Model.ArticleFilter"
                               class="px-3 py-1.5 rounded-lg border border-slate-300 bg-white text-xs font-semibold text-slate-700 hover:bg-slate-50 transition">Anterior</a>
                        }

                        @for (var pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++)
                        {
                            if (pageNumber == 1 || pageNumber == Model.TotalPages ||
                                (pageNumber >= Model.CurrentPage - 2 && pageNumber <= Model.CurrentPage + 2))
                            {
                                <a asp-area="Admin" asp-controller="Documentos" asp-action="Index"
                                   asp-route-page="@pageNumber"
                                   asp-route-search="@Model.Search"
                                   asp-route-storage="@Model.StorageFilter"
                                   asp-route-extension="@Model.ExtensionFilter"
                                   asp-route-articleId="@Model.ArticleFilter"
                                   class="px-3 py-1.5 rounded-lg text-xs font-semibold transition @(pageNumber == Model.CurrentPage ? "bg-[#00296B] text-white" : "border border-slate-300 bg-white text-slate-700 hover:bg-slate-50")">
                                    @pageNumber
                                </a>
                            }
                            else if (pageNumber == Model.CurrentPage - 3 || pageNumber == Model.CurrentPage + 3)
                            {
                                <span class="px-2 text-slate-400">...</span>
                            }
                        }

                        @if (Model.HasNextPage)
                        {
                            <a asp-area="Admin" asp-controller="Documentos" asp-action="Index"
                               asp-route-page="@(Model.CurrentPage + 1)"
                               asp-route-search="@Model.Search"
                               asp-route-storage="@Model.StorageFilter"
                               asp-route-extension="@Model.ExtensionFilter"
                               asp-route-articleId="@Model.ArticleFilter"
                               class="px-3 py-1.5 rounded-lg border border-slate-300 bg-white text-xs font-semibold text-slate-700 hover:bg-slate-50 transition">Siguiente</a>
                        }
                    </nav>
                </div>
            }
        }
    </div>
</div>

<div id="documentEditModal" class="fixed inset-0 z-50 hidden bg-black/50 backdrop-blur-xs items-center justify-center p-4">
    <div class="bg-white rounded-2xl max-w-lg w-full p-6 shadow-2xl border border-slate-200">
        <div class="flex items-center justify-between pb-4 border-b border-slate-100">
            <h4 class="text-base font-bold text-slate-900">Editar documento</h4>
            <button type="button" id="documentEditClose" class="text-slate-400 hover:text-slate-600 p-1 rounded-lg" aria-label="Cerrar">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
            </button>
        </div>

        <form id="documentEditForm" class="mt-4 space-y-4">
            <input type="hidden" id="documentEditId" />
            <div>
                <label class="block text-xs font-semibold text-slate-600 mb-1">Nombre visible</label>
                <input type="text" id="documentEditName" maxlength="200" required
                       class="w-full text-sm rounded-xl border border-slate-300 px-3 py-2 focus:ring-2 focus:ring-[#00509D] focus:outline-none" />
            </div>
            <div>
                <label class="block text-xs font-semibold text-slate-600 mb-1">Descripción</label>
                <textarea id="documentEditDescription" maxlength="1000" rows="3"
                          class="w-full text-sm rounded-xl border border-slate-300 px-3 py-2 focus:ring-2 focus:ring-[#00509D] focus:outline-none"></textarea>
            </div>
            <label class="flex items-center gap-2 cursor-pointer">
                <input type="checkbox" id="documentEditPublic" class="rounded border-slate-300 text-[#00296B] focus:ring-[#00296B]" />
                <span class="text-xs text-slate-700 font-medium">Descarga pública sin depender de un artículo publicado</span>
            </label>
            <p id="documentEditError" class="hidden text-xs font-semibold text-rose-600"></p>
            <div class="flex gap-3 pt-2">
                <button type="button" id="documentEditCancel" class="flex-1 py-2.5 px-4 rounded-xl border border-slate-300 text-slate-700 font-semibold text-xs hover:bg-slate-50 transition">Cancelar</button>
                <button type="submit" class="flex-1 py-2.5 px-4 rounded-xl bg-[#00296B] hover:bg-[#003F88] text-white font-bold text-xs shadow-sm transition">Guardar cambios</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            'use strict';

            const modal = document.getElementById('documentEditModal');
            const form = document.getElementById('documentEditForm');
            const idInput = document.getElementById('documentEditId');
            const nameInput = document.getElementById('documentEditName');
            const descriptionInput = document.getElementById('documentEditDescription');
            const publicInput = document.getElementById('documentEditPublic');
            const errorBox = document.getElementById('documentEditError');

            function closeModal() {
                modal?.classList.add('hidden');
                modal?.classList.remove('flex');
            }

            document.querySelectorAll('[data-document-edit]').forEach(function (button) {
                button.addEventListener('click', function () {
                    idInput.value = button.dataset.documentId || '';
                    nameInput.value = button.dataset.documentName || '';
                    descriptionInput.value = button.dataset.documentDescription || '';
                    publicInput.checked = button.dataset.documentPublic === 'true';
                    errorBox?.classList.add('hidden');
                    modal?.classList.remove('hidden');
                    modal?.classList.add('flex');
                    nameInput.focus();
                });
            });

            document.getElementById('documentEditClose')?.addEventListener('click', closeModal);
            document.getElementById('documentEditCancel')?.addEventListener('click', closeModal);
            modal?.addEventListener('click', function (event) {
                if (event.target === modal) closeModal();
            });

            form?.addEventListener('submit', async function (event) {
                event.preventDefault();
                if (errorBox) errorBox.classList.add('hidden');

                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                const formData = new URLSearchParams();
                formData.append('id', idInput.value);
                formData.append('displayName', nameInput.value);
                formData.append('description', descriptionInput.value);
                formData.append('isPublic', publicInput.checked ? 'true' : 'false');

                try {
                    const response = await fetch('@Url.Action("Rename", "Documentos", new { area = "Admin" })', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded',
                            'RequestVerificationToken': token || ''
                        },
                        body: formData.toString()
                    });

                    const data = await response.json().catch(function () { return null; });
                    if (!response.ok || !data?.success) {
                        throw new Error(data?.message || 'No se pudo actualizar el documento.');
                    }

                    window.location.reload();
                } catch (error) {
                    if (errorBox) {
                        errorBox.textContent = error.message || 'No se pudo actualizar el documento.';
                        errorBox.classList.remove('hidden');
                    }
                }
            });
        })();
    </script>
}
