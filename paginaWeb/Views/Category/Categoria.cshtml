@model CategoryPageViewModel
@using paginaWeb.Models.Home
@{
    var title = Model.ParentCategory != null
        ? $"{Model.Category.Name} - {Model.ParentCategory.Name}"
        : Model.Category.Name;
    ViewData["Title"] = title;
    ViewData["MetaDescription"] = Model.Category.Description ?? $"Noticias y artículos de {Model.Category.Name}";
}

@section Styles {
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
}

<div class="public-page">
    <!-- ─── 1. Cabecera Hero de Extremo a Extremo (Full Width) ───────────────── -->
    <header class="page-hero">
        <div class="page-hero__glow" aria-hidden="true"></div>

        <div class="container page-hero__inner">
            <!-- Breadcrumb -->
            <nav class="page-hero__breadcrumb" aria-label="Migas de pan">
                <a asp-controller="Home" asp-action="Index">Inicio</a>
                <span>/</span>
                @if (Model.ParentCategory != null)
                {
                    <a asp-controller="Category" asp-action="Categoria"
                       asp-route-slug="@Model.ParentCategory.Slug">@Model.ParentCategory.Name</a>
                    <span>/</span>
                }
                <span class="page-hero__breadcrumb-current">@Model.Category.Name</span>
            </nav>

            <div class="flex flex-wrap items-center gap-3">
                <h1 class="page-hero__title">@Model.Category.Name</h1>
            </div>

            @if (!string.IsNullOrEmpty(Model.Category.Description))
            {
                <p class="page-hero__subtitle">
                    @Model.Category.Description
                </p>
            }

            <!-- Subcategorías asociadas / hermanas -->
            @if (Model.Subcategories != null && Model.Subcategories.Any())
            {
                <div class="pt-2">
                    <span class="text-xs font-bold uppercase tracking-wider text-white/70 block mb-2">
                        @(Model.ParentCategory != null ? "Otras subcategorías relacionadas:" : "Especialidades y Subcategorías:")
                    </span>
                    <div class="page-hero__pills">
                        @if (Model.ParentCategory != null)
                        {
                            <a asp-controller="Category" asp-action="Categoria" asp-route-slug="@Model.ParentCategory.Slug"
                               class="page-hero__pill">
                                Todas en @Model.ParentCategory.Name
                            </a>
                        }
                        @foreach (var sub in Model.Subcategories)
                        {
                            var isCurrent = sub.Slug == Model.Category.Slug;
                            <a asp-controller="Category" asp-action="Categoria" asp-route-slug="@sub.Slug"
                               class="page-hero__pill @(isCurrent ? "page-hero__pill--active" : "")">
                                @sub.Name
                            </a>
                        }
                    </div>
                </div>
            }

            <div class="page-hero__count">
                <span>Total de publicaciones disponibles: <strong class="text-[#FDC500]">@Model.TotalCount</strong>
                    artículos</span>
                </div>
            </div>
        </header>

        <!-- ─── 2. Contenido de Extremo a Extremo (Mismo contenedor de la Home) ─── -->
        <main class="page-content-section container">
            @if (!Model.Articles.Any())
            {
                <div
                    class="bg-white rounded-2xl p-12 sm:p-16 text-center text-slate-500 border border-slate-200/90 shadow-xs max-w-2xl mx-auto my-8">
                    <svg class="w-14 h-14 mx-auto text-slate-300 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                              d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
                    </svg>
                    <h3 class="text-xl font-bold text-[#00296B]">No hay publicaciones en esta categoría todavía</h3>
                    <p class="text-sm text-slate-500 mt-2">Vuelve pronto para consultar nuevas coberturas e investigaciones.</p>
                    <a asp-controller="Home" asp-action="Index"
                       class="mt-6 inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-[#00296B] hover:bg-[#003F88] text-white text-xs font-bold uppercase tracking-wider transition shadow-sm">
                        Volver al inicio
                    </a>
                </div>
            }
            else
            {
                <ul class="card-grid card-grid--posts" role="list">
                    @foreach (var art in Model.Articles)
                    {
                        <partial name="Partials/_PostCard" model="art" />
                    }
                </ul>

                <!-- ─── Paginación Modular Reutilizable ───────────────────────────── -->
                <partial name="Partials/_Pagination"
                         model="PaginationViewModel.ForCategory(Model.CurrentPage, Model.TotalPages, Model.Category.Slug)" />
            }
        </main>
    </div>

    @section Scripts {
        <script src="~/js/reveal.js" asp-append-version="true" defer></script>
    }
