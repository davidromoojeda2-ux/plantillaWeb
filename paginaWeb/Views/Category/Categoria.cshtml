@model CategoryPageViewModel
@using paginaWeb.Models.Home
@{
    var title = Model.ParentCategory != null
        ? $"{Model.Category.Name} - {Model.ParentCategory.Name}"
        : Model.Category.Name;
    ViewData["Title"] = title;
    ViewData["MetaDescription"] = Model.Category.Description ?? $"Noticias y artículos de {Model.Category.Name}";
}


<div class="public-page">
    <!-- ─── 1. Cabecera Hero de Extremo a Extremo (Full Width) ───────────────── -->
    <header class="page-hero">
        <div class="page-hero__glow" aria-hidden="true"></div>

        <div class="container page-hero__inner">
            <!-- Breadcrumb -->
            <nav class="page-hero__breadcrumb" aria-label="Migas de pan">
                <a asp-controller="Home" asp-action="Index" class="inline-flex items-center gap-1 transition-colors">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M3 12l9-9 9 9M5 10v10a1 1 0 001 1h4v-6h4v6h4a1 1 0 001-1V10" />
                    </svg>
                    Inicio
                </a>
                <span>/</span>
                @if (Model.ParentCategory != null)
                {
                    <a asp-controller="Category" asp-action="Categoria"
                       asp-route-slug="@Model.ParentCategory.Slug">@Model.ParentCategory.Name</a>
                    <span>/</span>
                }
                <span class="page-hero__breadcrumb-current">@Model.Category.Name</span>
            </nav>

            <div class="page-hero__layout">
                <div class="page-hero__content">
                    <h1 class="page-hero__title">@Model.Category.Name</h1>

                    @if (!string.IsNullOrEmpty(Model.Category.Description))
                    {
                        <p class="page-hero__subtitle">
                            @Model.Category.Description
                        </p>
                    }

                    <div class="page-hero__count">
                        <span>Total de publicaciones disponibles: <strong
                            class="text-[#FDC500]">@Model.TotalCount</strong>
                            artículos</span>
                        </div>
                    </div>

                    <!-- Subcategorías asociadas / hermanas en el margen derecho -->
                    @if (Model.Subcategories != null && Model.Subcategories.Any())
                    {
                        <aside class="page-hero__aside"
                               aria-label="@(Model.ParentCategory != null ? "Otras subcategorías relacionadas" : "Especialidades y subcategorías")">
                            <span class="page-hero__aside-title">
                                @(Model.ParentCategory != null ? "Otras subcategorías relacionadas:" : "Especialidades y Subcategorías:")
                            </span>
                            <ul class="page-hero__sublist" role="list">
                                @if (Model.ParentCategory != null)
                                {
                                    <li>
                                        <a asp-controller="Category" asp-action="Categoria"
                                           asp-route-slug="@Model.ParentCategory.Slug" class="page-hero__sublink">
                                            <span>Todas en @Model.ParentCategory.Name</span>
                                        </a>
                                    </li>
                                }
                                @foreach (var sub in Model.Subcategories)
                                {
                                    var isCurrent = sub.Slug == Model.Category.Slug;
                                    <li>
                                        <a asp-controller="Category" asp-action="Categoria" asp-route-slug="@sub.Slug"
                                           class="page-hero__sublink @(isCurrent ? "page-hero__sublink--active" : "")"
                                           aria-current="@(isCurrent ? "page" : null)">
                                            <span>@sub.Name</span>
                                        </a>
                                    </li>
                                }
                            </ul>
                        </aside>
                    }
                </div>
            </header>

            <!-- ─── 2. Contenido de Extremo a Extremo (Mismo contenedor de la Home) ─── -->
            <main class="page-content-section container">
                @if (!Model.Articles.Any())
                {
                    <div
                        class="bg-white rounded-2xl p-12 sm:p-16 text-center text-slate-500 border border-slate-200/90 shadow-xs max-w-2xl mx-auto my-8">
                        <partial name="_SvgIcon"
                                 model="@(new SvgIcon("article", "w-14 h-14 mx-auto text-slate-300 mb-4", StrokeWidth: "1.5"))" />
                        <h3 class="text-xl font-bold text-[#00296B]">No hay publicaciones en esta categoría todavía</h3>
                        <p class="text-sm text-slate-500 mt-2">Vuelve pronto para consultar nuevas coberturas e investigaciones.</p>
                        <a asp-controller="Home" asp-action="Index"
                           class="mt-6 inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-[#00296B] hover:bg-[#003F88] text-white text-xs font-bold uppercase tracking-wider transition shadow-sm">
                            Volver al inicio
                        </a>
                    </div>
                }
                else
                {
                    <ul class="card-grid card-grid--posts" role="list">
                        @{
                            var cardIndex = 0;
                        }
                        @foreach (var art in Model.Articles)
                        {
                            ViewData["PostCardPriority"] = cardIndex++ == 0;
                            <partial name="Partials/_PostCard" model="art" />
                        }
                    </ul>

                    <!-- ─── Paginación Modular Reutilizable ───────────────────────────── -->
                    <partial name="Partials/_Pagination"
                             model="PaginationViewModel.ForCategory(Model.CurrentPage, Model.TotalPages, Model.Category.Slug)" />
                }
            </main>
        </div>

        @section StructuredData {
            @{
                var structuredDataBaseUrl = SiteUrl.Resolve(Context, Configuration);
                var pageUrl = Model.CurrentPage > 1
                    ? $"/categoria/{Model.Category.Slug}?page={Model.CurrentPage}"
                    : $"/categoria/{Model.Category.Slug}";

                var breadcrumb = new List<BreadcrumbItem> { new("Inicio", "/") };
                if (Model.ParentCategory != null)
                    breadcrumb.Add(new(Model.ParentCategory.Name, $"/categoria/{Model.ParentCategory.Slug}"));
                breadcrumb.Add(new(Model.Category.Name, $"/categoria/{Model.Category.Slug}"));

                var collectionJsonLd = StructuredDataBuilder.BuildCollectionPage(
                    Model.Category.Name,
                    Model.Category.Description,
                    pageUrl,
                    Model.Articles.Select(a => new ArticleListItem(a.Article.Title, $"/articulos/{a.Article.Slug}")),
                    structuredDataBaseUrl);
                var breadcrumbJsonLd = StructuredDataBuilder.BuildBreadcrumbList(breadcrumb, structuredDataBaseUrl);
            }
            @JsonLd.Render(collectionJsonLd)
            @JsonLd.Render(breadcrumbJsonLd)
        }

        @section Scripts {
            <script src="~/js/reveal.js" asp-append-version="true" defer></script>
        }
