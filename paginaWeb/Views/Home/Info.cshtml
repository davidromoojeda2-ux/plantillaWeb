@model PageResponseDto
@{
    ViewData["Title"] = Model.Title;
    var otherPages = (List<PageResponseDto>?)ViewBag.OtherPages ?? new();
    var institutionalNavDesktop = new InstitutionalNavViewModel(otherPages, Model.Slug, IsMobile: false);
    var institutionalNavMobile = new InstitutionalNavViewModel(otherPages, Model.Slug, IsMobile: true);
    var institutionalHeader = new CollapsibleMenuHeaderViewModel("Información legal");
}


<div class="public-page">
    <!-- ─── 1. Cabecera Hero de Extremo a Extremo (Full Width) ───────────────── -->
    <header class="page-hero">
        <div class="page-hero__glow" aria-hidden="true"></div>

        <div class="container page-hero__inner">
            <!-- Breadcrumb -->
            <nav class="page-hero__breadcrumb" aria-label="Migas de pan">
                <a asp-controller="Home" asp-action="Index">Inicio</a>
                <span>/</span>
                <span class="text-white/80">Legal</span>
                <span>/</span>
                <span class="page-hero__breadcrumb-current">@Model.Title</span>
            </nav>

            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 text-[#FDC500] text-xs font-bold tracking-wider uppercase backdrop-blur-xs border border-white/10 w-fit">
                <span>ACTUALIZACIÓN:</span>
                <span>@Model.UpdatedAt.ToString("dd MMMM yyyy")</span>
            </div>

            <h1 class="page-hero__title">
                @Model.Title
            </h1>

            <p class="page-hero__subtitle">
                @if (!string.IsNullOrWhiteSpace(Model.Subtitle))
                {
                    @Model.Subtitle
                }
                else
                {
                    <span class="opacity-50 italic">Sin descripción. Edita esta sección desde el panel de administración.</span>
                }
            </p>
        </div>
    </header>

    <!-- ─── 2. Contenido de Extremo a Extremo (Mismo contenedor de la Home) ─── -->
    <main class="page-content-section container">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-start">
            <!-- Menú Lateral Institucional (escritorio) -->
            <aside class="hidden lg:block lg:col-span-4 bg-[#00296B] text-white p-5 rounded-2xl shadow-lg shadow-[#00296B]/20 space-y-4 sticky top-28 z-10">
                <h4 class="pb-3 border-b border-white/15">
                    <partial name="Partials/_MenuBrand" model="institutionalHeader.Title" />
                </h4>
                <partial name="Partials/_InstitutionalNav" model="institutionalNavDesktop" />
            </aside>

            <!-- Menú desplegable Institucional (móvil y tablet) -->
            <details id="institutionalMenu" open
                     class="lg:hidden lg:col-span-4 group overflow-hidden bg-[#00296B] text-white rounded-2xl shadow-lg shadow-[#00296B]/20">
                <partial name="Partials/_CollapsibleMenuHeader" model="institutionalHeader" />
                <partial name="Partials/_InstitutionalNav" model="institutionalNavMobile" />
            </details>

            <!-- Contenido Estructurado -->
            <article class="lg:col-span-8 bg-white p-8 sm:p-12 rounded-2xl border border-slate-200/90 shadow-xs">
                <div class="article-prose max-w-none">
                    <partial name="Partials/ContentBlocks/_ContentBlocks" model="Model.Blocks" />
                </div>

                @if (Model.Slug == "politica-de-cookies")
                {
                    <div id="configurar-cookies"
                         class="mt-10 rounded-2xl border border-slate-200 bg-slate-50/80 p-6 sm:p-7">
                        <h2 class="text-lg font-bold text-[#00296B]">Gestionar tus preferencias</h2>
                        <p class="mt-2 text-sm text-slate-600 leading-relaxed">
                            Puedes aceptar o rechazar las categorías opcionales en cualquier momento. Tu elección
                            se guarda durante 12 meses y puedes cambiarla cuando quieras.
                        </p>
                        <a href="/info/politica-de-cookies#configurar-cookies"
                           data-cookie-settings
                           class="mt-4 inline-flex items-center justify-center rounded-xl bg-[#00296B] px-5 py-2.5 text-sm font-bold text-white transition hover:bg-[#00509D]">
                            Configurar cookies
                        </a>
                    </div>
                }
            </article>
        </div>
    </main>
</div>
