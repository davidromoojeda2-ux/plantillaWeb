@model PageResponseDto
@{
    ViewData["Title"] = Model.Title;
    var otherPages = (List<PageResponseDto>?)ViewBag.OtherPages ?? new();
}

@section Styles {
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
}

<div class="public-page">
    <!-- ─── 1. Cabecera Hero de Extremo a Extremo (Full Width) ───────────────── -->
    <header class="page-hero">
        <div class="page-hero__glow" aria-hidden="true"></div>

        <div class="container page-hero__inner">
            <!-- Breadcrumb -->
            <nav class="page-hero__breadcrumb" aria-label="Migas de pan">
                <a asp-controller="Home" asp-action="Index">Inicio</a>
                <span>/</span>
                <span class="text-white/80">Institucional</span>
                <span>/</span>
                <span class="page-hero__breadcrumb-current">@Model.Title</span>
            </nav>

            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 text-[#FDC500] text-xs font-bold tracking-wider uppercase backdrop-blur-xs border border-white/10 w-fit">
                <span>ACTUALIZACIÓN:</span>
                <span>@Model.UpdatedAt.ToString("dd MMMM yyyy")</span>
            </div>

            <h1 class="page-hero__title">
                @Model.Title
            </h1>

            <p class="page-hero__subtitle">
                @if (!string.IsNullOrWhiteSpace(Model.Subtitle))
                {
                    @Model.Subtitle
                }
                else
                {
                    <span class="opacity-50 italic">Sin descripción. Edita esta sección desde el panel de administración.</span>
                }
            </p>
        </div>
    </header>

    <!-- ─── 2. Contenido de Extremo a Extremo (Mismo contenedor de la Home) ─── -->
    <main class="page-content-section container">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-start">
            <!-- Menú Lateral Institucional -->
            <aside class="lg:col-span-4 bg-white p-6 rounded-2xl border border-slate-200/90 shadow-xs space-y-3 sticky top-28 z-10">
                <h4 class="text-xs font-bold uppercase tracking-wider text-slate-400 pb-2 border-b border-slate-100">
                    Documentos Institucionales
                </h4>
                <nav class="space-y-1.5 text-xs">
                    @foreach (var pageItem in otherPages)
                    {
                        <a asp-controller="Home" asp-action="Info" asp-route-slug="@pageItem.Slug"
                           class="block px-3 py-2 rounded-xl transition font-medium @(pageItem.Slug == Model.Slug ? "bg-[#00296B] text-white font-bold shadow-xs" : "text-slate-700 hover:bg-slate-100")">
                            @pageItem.Title
                        </a>
                    }
                </nav>
            </aside>

            <!-- Contenido Estructurado -->
            <article class="lg:col-span-8 bg-white p-8 sm:p-12 rounded-2xl border border-slate-200/90 shadow-xs">
                <div class="article-prose max-w-none space-y-6">
                    <partial name="Partials/ContentBlocks/_ContentBlocks" model="Model.Blocks" />
                </div>
            </article>
        </div>
    </main>
</div>
