@model List<ArticleResponseDto>
@{
    var category = (CategoryResponseDto)ViewBag.Category;
    ViewData["Title"] = category.Name;
    ViewData["MetaDescription"] = category.Description ?? $"Noticias y artículos de {category.Name}";
    var categories = (Dictionary<string, string>?)ViewBag.Categories ?? new();
    var images = (Dictionary<string, ImageMetadataResponseDto>?)ViewBag.Images ?? new();
    int currentPage = (int)ViewBag.Page;
    int totalPages = (int)ViewBag.TotalPages;
    long totalCount = (long)ViewBag.TotalCount;
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-12">
    <!-- ─── Cabecera de Categoría ────────────────────────────────────────────── -->
    <div class="bg-white rounded-3xl p-8 sm:p-12 border border-slate-200/80 shadow-xs space-y-3">
        <div class="flex items-center gap-2 text-xs font-semibold text-slate-400 uppercase tracking-wider">
            <a href="/" class="hover:underline">Inicio</a>
            <span>/</span>
            <span>Categoría</span>
        </div>
        <h1 class="text-3xl sm:text-5xl font-serif font-black text-[#00296B]">@category.Name</h1>
        @if (!string.IsNullOrEmpty(category.Description))
        {
            <p class="text-sm sm:text-base text-slate-600 max-w-2xl leading-relaxed">
                @category.Description
            </p>
        }
        <div class="pt-2 text-xs font-semibold text-[#00509D]">
            @totalCount publicaciones en esta sección
        </div>
    </div>

    <!-- ─── Grid de Artículos ────────────────────────────────────────────────── -->
    @if (!Model.Any())
    {
        <div class="bg-white rounded-3xl p-16 text-center text-slate-400 border border-slate-200/80">
            <p class="text-lg font-semibold text-slate-700">No hay artículos publicados en esta categoría todavía.</p>
            <p class="text-xs text-slate-400 mt-2">Vuelve pronto para consultar nuevas coberturas.</p>
            <a href="/" class="mt-6 inline-block px-5 py-2.5 rounded-full bg-[#00296B] text-white text-xs font-bold">
                Volver al inicio
            </a>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            @foreach (var art in Model)
            {
                var artCover = art.CoverImageId != null && images.ContainsKey(art.CoverImageId) ? images[art.CoverImageId] : null;
                var artImgUrl = !string.IsNullOrWhiteSpace(art.CoverImageUrl) ? art.CoverImageUrl : (ImageMapper.GetThumbnailUrl(artCover) ?? ImageMapper.GetBestUrl(artCover));

                <partial name="Partials/_ArticleCard" model="(Article: art, ImageUrl: artImgUrl, CategoryName: category.Name)" />
            }
        </div>

        <!-- Paginación -->
        @if (totalPages > 1)
        {
            <div class="flex items-center justify-center gap-2 pt-8">
                @if (currentPage > 1)
                {
                    <a href="/categoria/@category.Slug?page=@(currentPage - 1)"
                       class="px-4 py-2 rounded-xl bg-white border border-slate-200 text-xs font-semibold text-slate-700 hover:bg-slate-50 transition">
                        ← Anterior
                    </a>
                }
                @for (int p = 1; p <= totalPages; p++)
                {
                    <a href="/categoria/@category.Slug?page=@p"
                       class="w-9 h-9 rounded-xl flex items-center justify-center text-xs font-bold transition @(p == currentPage ? "bg-[#00296B] text-white" : "bg-white border border-slate-200 text-slate-700 hover:bg-slate-50")">
                        @p
                    </a>
                }
                @if (currentPage < totalPages)
                {
                    <a href="/categoria/@category.Slug?page=@(currentPage + 1)"
                       class="px-4 py-2 rounded-xl bg-white border border-slate-200 text-xs font-semibold text-slate-700 hover:bg-slate-50 transition">
                        Siguiente →
                    </a>
                }
            </div>
        }
    }
</div>
