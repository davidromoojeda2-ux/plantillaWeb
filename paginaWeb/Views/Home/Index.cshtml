@model HomePageViewModel
@{
    ViewData["Title"] = "Noticias Principales y Análisis";
    ViewData["MetaDescription"] = "Últimas noticias, reportajes y análisis en profundidad sobre tecnología, economía y cultura.";
}

@section Styles {
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
}

<div class="home">
    <!-- ─── 1. Hero ───────────────────────────────────────────────────────────── -->
    
    
    <section class="hero" id="inicio" aria-labelledby="hero-title">
        <div class="hero__glow" aria-hidden="true"></div>

        <div class="container hero__inner">
            <div class="hero__intro" data-reveal>
                <p class="hero__kicker">Portal Noticias · Información y análisis</p>
                <h1 id="hero-title" class="hero__title">@Model.Hero.Title</h1>
                <p class="hero__subtitle">@Model.Hero.Subtitle</p>

                <form class="hero__search" asp-controller="Home" asp-action="Buscar" method="get" role="search">
                    <label for="hero-search-input" class="sr-only">Buscar noticias</label>
                    <input id="hero-search-input" class="hero__search-input" type="search" name="q"
                           placeholder="Buscar noticias, temas o autores…" autocomplete="off" />
                    <button id="hero-search-btn" type="submit" class="btn btn--accent">Buscar</button>
                </form>
            </div>

            @* @if (Model.Hero.Cards.Any())
            {
                <ul class="card-grid card-grid--hero" role="list">
                    @foreach (var card in Model.Hero.Cards)
                    {
                        <li class="card-grid__item" data-reveal>
                            <partial name="Partials/Home/_FeatureCard" model="card" />
                        </li>
                    }
                </ul>
            } *@
        </div>

        <svg class="hero__curve" viewBox="0 0 1440 200" preserveAspectRatio="none" aria-hidden="true" focusable="false">
            <path d="M0 200V150C240 45 480 22 720 22s480 23 720 128v50H0z" />
        </svg>
    </section>
     

    <!-- ─── 2. Marquesina ─────────────────────────────────────────────────────── -->
    <!-- 
    @{
        var marqueePhrases = new[]
        {
            "Periodismo independiente",
            "Análisis en profundidad",
            "Verificación de hechos",
            "Tecnología · Economía · Cultura"
        };
    }
    <div class="marquee" role="note" aria-label="@string.Join(". ", marqueePhrases)">
        <div class="marquee__track">
            @for (var copy = 0; copy < 2; copy++)
            {
                <ul class="marquee__group" role="list" aria-hidden="true">
                    @foreach (var phrase in marqueePhrases)
                    {
                        <li class="marquee__item">@phrase</li>
                    }
                </ul>
            }
        </div>
    </div>
    -->

    <!-- ─── 3. Últimas publicaciones ─────────────────────────────────────────── -->
    <section class="section container" id="ultimas-publicaciones" aria-labelledby="ultimas-publicaciones-title">
        <div class="section-header" data-reveal>
            <div class="section-header__text">
                <h2 id="@Model.PostsHeader.HeadingId" class="section-header__title">@Model.PostsHeader.Title</h2>
                @if (!string.IsNullOrWhiteSpace(Model.PostsHeader.Subtitle))
                {
                    <p class="section-header__subtitle">@Model.PostsHeader.Subtitle</p>
                }
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.PostsHeader.LinkText) &&
            !string.IsNullOrWhiteSpace(Model.PostsHeader.LinkHref))
            {
                <a class="link-arrow" href="@Model.PostsHeader.LinkHref" id="@(Model.PostsHeader.HeadingId)-link">
                    <span>@Model.PostsHeader.LinkText</span>
                    <svg class="link-arrow__icon" width="28" height="12" viewBox="0 0 28 12" fill="none" aria-hidden="true"
                         focusable="false">
                        <path d="M0 6h26M21 1l5 5-5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"
                              stroke-linejoin="round" />
                    </svg>
                </a>
            }
        </div>

        @if (Model.Posts.Any())
        {
            <ul class="card-grid card-grid--posts" role="list">
                @foreach (var post in Model.Posts)
                {
                    <li class="card-grid__item" data-reveal>
                        <partial name="Partials/Home/_PostCard" model="post" />
                    </li>
                }
            </ul>
        }
        else
        {
            <div class="empty-state" data-reveal>
                <p class="empty-state__title">Aún no hay publicaciones en el portal.</p>
                <p class="empty-state__text">Ingresa al panel administrativo para publicar las primeras noticias.</p>
            </div>
        }
    </section>

    <!-- ─── 4. Destacados ────────────────────────────────────────────────────── -->
    @if (Model.Featured.Any())
    {
        <section class="section container" id="destacados" aria-labelledby="destacados-title">
            <div class="section-header" data-reveal>
                <div class="section-header__text">
                    <h2 id="@Model.FeaturedHeader.HeadingId" class="section-header__title">@Model.FeaturedHeader.Title</h2>
                    @if (!string.IsNullOrWhiteSpace(Model.FeaturedHeader.Subtitle))
                    {
                        <p class="section-header__subtitle">@Model.FeaturedHeader.Subtitle</p>
                    }
                </div>
            </div>

            <ul class="card-grid card-grid--featured" role="list">
                @foreach (var block in Model.Featured)
                {
                    <li class="card-grid__item" data-reveal>
                        <partial name="Partials/Home/_FeaturedBlock" model="block" />
                    </li>
                }
            </ul>
        </section>
    }
</div>

@section Scripts {
    <script src="~/js/reveal.js" asp-append-version="true" defer></script>
}
