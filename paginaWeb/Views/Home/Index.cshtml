@model HomePageViewModel
@{
    ViewData["Title"] = "Noticias Principales y Análisis";
    ViewData["MetaDescription"] = "Últimas noticias, reportajes y análisis en profundidad sobre tecnología, economía y cultura.";
}

@section Styles {
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
}

<div class="home">
    <!-- ─── 1. Hero: Título + Barra de búsqueda + Curva ───────────────────────── -->
    <section class="hero" id="inicio" aria-labelledby="hero-title">
        <div class="hero__glow" aria-hidden="true"></div>

        <div class="container hero__inner">
            <div class="hero__intro" data-reveal>
                <p class="hero__kicker">TITULO DE LA PAGINA WEB</p>
                <h1 id="hero-title" class="hero__title">@Model.Hero.Title</h1>
                <p class="hero__subtitle">@Model.Hero.Subtitle</p>

                <!-- Componente Parcial de Búsqueda Modular -->
                <partial name="Partials/_SearchBar"
                         model="new paginaWeb.Models.Publicaciones.SearchBarViewModel(IsHeroSearch: true)" />
            </div>

            <!-- Hero Dinámico y Moderno (Carrusel Showcase de Noticias en Portada) -->
            <partial name="Partials/Home/_HeroDynamic" model="Model.Hero.Cards" />
        </div>

        <svg class="hero__curve" viewBox="0 0 1440 200" preserveAspectRatio="none" aria-hidden="true" focusable="false">
            <path d="M0 200V150C240 45 480 22 720 22s480 23 720 128v50H0z" />
        </svg>
    </section>

    <!-- ─── 2. Últimas entradas (Dos columnas: Destacadas y Recientes) ───────── -->
    <section class="section container" id="ultimas-entradas" aria-labelledby="ultimas-entradas-title">
        <div class="section-header" data-reveal>
            <div class="section-header__text">
                <h2 id="@Model.EntriesHeader.HeadingId" class="section-header__title">@Model.EntriesHeader.Title</h2>
                @if (!string.IsNullOrWhiteSpace(Model.EntriesHeader.Subtitle))
                {
                    <p class="section-header__subtitle">@Model.EntriesHeader.Subtitle</p>
                }
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.EntriesHeader.LinkText) &&
                 !string.IsNullOrWhiteSpace(Model.EntriesHeader.LinkHref))
            {
                <a class="link-arrow" href="@Model.EntriesHeader.LinkHref" id="@(Model.EntriesHeader.HeadingId)-link">
                    <span>@Model.EntriesHeader.LinkText</span>
                    <svg class="link-arrow__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"
                         focusable="false">
                        <path d="M7 17L17 7M9 7h8v8" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                              stroke-linejoin="round" />
                    </svg>
                </a>
            }
        </div>

        <div class="entries-grid" data-reveal>
            <!-- ── Columna Izquierda: Principales / Destacadas (Azul Marino Base) ── -->
            <div class="entries-panel entries-panel--featured">
                <div class="entries-panel__header">
                    <span class="entries-panel__tag">
                        <span class="entries-panel__dot" aria-hidden="true"></span>
                        <span>Noticias Principales</span>
                    </span>
                </div>

                <div class="entries-list">
                    @foreach (var entry in Model.FeaturedEntries)
                    {
                        <a class="card-h" href="@entry.Href" aria-label="Leer @entry.Title">
                            <div class="card-h__media">
                                @if (entry.Image.HasUrl)
                                {
                                    <img class="card-h__img" src="@entry.Image.Url" alt="@entry.Image.Alt"
                                         width="@entry.Image.Width" height="@entry.Image.Height" loading="lazy"
                                         decoding="async" />
                                }
                                else
                                {
                                    <div class="card-h__fallback">
                                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                             stroke-width="1.5">
                                            <path stroke-linecap="round" stroke-linejoin="round"
                                                  d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
                                        </svg>
                                    </div>
                                }
                            </div>
                            <div class="card-h__body">
                                <span class="card-h__cat">@entry.Category</span>
                                <h3 class="card-h__title">@entry.Title</h3>
                                <div class="card-h__meta">
                                    @if (entry.PublishedAt is DateTime date)
                                    {
                                        <time datetime="@date.ToString("yyyy-MM-dd")">@date.ToString("dd MMM yyyy")</time>
                                    }
                                    else
                                    {
                                        <span>Cobertura</span>
                                    }
                                </div>
                            </div>
                            <span class="card-h__arrow" aria-hidden="true">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <line x1="7" y1="17" x2="17" y2="7"></line>
                                    <polyline points="7 7 17 7 17 17"></polyline>
                                </svg>
                            </span>
                        </a>
                    }
                </div>
            </div>

            <!-- ── Columna Derecha: Top Más Leídos (Azul Corporativo Base) ── -->
            <div class="entries-panel entries-panel--popular entries-panel--recent">
                <div class="entries-panel__header">
                    <span class="entries-panel__tag">
                        <span class="entries-panel__dot" aria-hidden="true"></span>
                        <span>Top Más Leídos</span>
                    </span>
                </div>

                <div class="entries-list">
                    @foreach (var entry in Model.MostReadEntries)
                    {
                        <a class="card-h card-h--top" href="@entry.Href" aria-label="Leer @entry.Title">
                            @if (entry.Rank.HasValue)
                            {
                                <span class="card-h__rank" aria-hidden="true">@entry.Rank.Value.ToString("D2")</span>
                            }
                            <div class="card-h__body">
                                <span class="card-h__cat">@entry.Category</span>
                                <h3 class="card-h__title">@entry.Title</h3>
                                <div class="card-h__meta">
                                    @if (entry.PublishedAt is DateTime date)
                                    {
                                        <time datetime="@date.ToString("yyyy-MM-dd")">@date.ToString("dd MMM yyyy")</time>
                                    }
                                    else
                                    {
                                        <span>Actualidad</span>
                                    }
                                    @if (entry.ViewCount > 0)
                                    {
                                        <span class="card-h__meta-sep" aria-hidden="true">•</span>
                                        <span class="card-h__views" title="@entry.ViewCount lecturas acumuladas">
                                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                                <circle cx="12" cy="12" r="3"></circle>
                                            </svg>
                                            <span>@entry.ViewCount lecturas</span>
                                        </span>
                                    }
                                </div>
                            </div>
                            <span class="card-h__arrow" aria-hidden="true">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <line x1="7" y1="17" x2="17" y2="7"></line>
                                    <polyline points="7 7 17 7 17 17"></polyline>
                                </svg>
                            </span>
                        </a>
                    }
                </div>
            </div>
        </div>
    </section>

    <!-- ─── 3. Sección: Encuentra el tema de tu interés (Colores Base del Tema) ─ -->
    <section class="bento-section" id="temas-interes" aria-labelledby="temas-interes-title">
        <div class="container">
            <div class="section-header" data-reveal>
                <div class="section-header__text">
                    <h2 id="temas-interes-title" class="section-header__title">@Model.CategorySection.Title</h2>
                    <p class="section-header__subtitle">@Model.CategorySection.Subtitle</p>
                </div>
            </div>

            <!-- Bento Grid 2 Columnas -->
            <div class="bento-grid" data-reveal>
                <!-- ── Columna Izquierda: Card Grande (Salud y Bienestar) + Card Compacto (Subcategoría) ── -->
                <div class="bento-col">
                    <!-- Tarjeta Grande Superior: Salud y Bienestar (Acento Dorado Base) -->
                    <div
                        class="bento-card bento-card--large bento-card--primary @(!string.IsNullOrEmpty(Model.CategorySection.MainCard.ImageUrl) ? "bento-card--has-bg" : "")">
                        @if (!string.IsNullOrEmpty(Model.CategorySection.MainCard.ImageUrl))
                        {
                            <div class="bento-card__bg" aria-hidden="true">
                                <img class="bento-card__bg-img" src="@Model.CategorySection.MainCard.ImageUrl" alt=""
                                     loading="lazy" />
                                <div class="bento-card__scrim"></div>
                            </div>
                        }
                        <div class="bento-card__content">
                            <div>
                                <div class="bento-card__header">
                                    <div>
                                        <span class="bento-card__parent-badge">Categoría Principal</span>
                                        <h3 class="bento-card__title">@Model.CategorySection.MainCard.Name</h3>
                                    </div>
                                    <a class="bento-card__link-more" asp-controller="Category" asp-action="Categoria"
                                       asp-route-slug="@Model.CategorySection.MainCard.Slug">
                                        <span>Ver más</span>
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                                             stroke="currentColor" stroke-width="2.5" stroke-linecap="round"
                                             stroke-linejoin="round">
                                            <path d="M5 12h14M12 5l7 7-7 7" />
                                        </svg>
                                    </a>
                                </div>

                                @if (!string.IsNullOrEmpty(Model.CategorySection.MainCard.Description))
                                {
                                    <p class="bento-card__desc">@Model.CategorySection.MainCard.Description</p>
                                }
                            </div>

                            @if (Model.CategorySection.MainCard.Subcategories.Any())
                            {
                                <div class="bento-card__tags">
                                    <span class="bento-card__tags-label">Subcategorías:</span>
                                    @foreach (var sub in Model.CategorySection.MainCard.Subcategories)
                                    {
                                        <a class="bento-card__tag" asp-controller="Category" asp-action="Categoria"
                                           asp-route-slug="@sub.Slug">
                                            <span>@sub.Name</span>
                                            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                 stroke-width="2.5">
                                                <path d="M9 5l7 7-7 7" />
                                            </svg>
                                        </a>
                                    }
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Tarjeta Compacta Inferior: Subcategoría (ej: Neurociencia) -->
                    <div
                        class="bento-card bento-card--compact @(!string.IsNullOrEmpty(Model.CategorySection.SubCardLeft.ImageUrl) ? "bento-card--has-bg" : "")">
                        @if (!string.IsNullOrEmpty(Model.CategorySection.SubCardLeft.ImageUrl))
                        {
                            <div class="bento-card__bg" aria-hidden="true">
                                <img class="bento-card__bg-img" src="@Model.CategorySection.SubCardLeft.ImageUrl" alt=""
                                     loading="lazy" />
                                <div class="bento-card__scrim"></div>
                            </div>
                        }
                        <div class="bento-card__content">
                            <div>
                                <div class="bento-card__header">
                                    <div>
                                        <span class="bento-card__parent-badge">Subcategoría</span>
                                        <h3 class="bento-card__title">@Model.CategorySection.SubCardLeft.Name</h3>
                                    </div>
                                    <a class="bento-card__link-more bento-card__link-more--outline"
                                       asp-controller="Category" asp-action="Categoria"
                                       asp-route-slug="@Model.CategorySection.SubCardLeft.Slug">
                                        <span>Explorar</span>
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                                             stroke="currentColor" stroke-width="2.5" stroke-linecap="round"
                                             stroke-linejoin="round">
                                            <path d="M5 12h14M12 5l7 7-7 7" />
                                        </svg>
                                    </a>
                                </div>

                                @if (!string.IsNullOrEmpty(Model.CategorySection.SubCardLeft.Description))
                                {
                                    <p class="bento-card__desc">@Model.CategorySection.SubCardLeft.Description</p>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ── Columna Derecha: Card Compacto (Subcategoría) + Card Grande ── -->
                <div class="bento-col">
                    <!-- Tarjeta Compacta Superior: Subcategoría (ej: Nutrición y Longevidad) -->
                    <div
                        class="bento-card bento-card--compact @(!string.IsNullOrEmpty(Model.CategorySection.SubCardRightTop.ImageUrl) ? "bento-card--has-bg" : "")">
                        @if (!string.IsNullOrEmpty(Model.CategorySection.SubCardRightTop.ImageUrl))
                        {
                            <div class="bento-card__bg" aria-hidden="true">
                                <img class="bento-card__bg-img" src="@Model.CategorySection.SubCardRightTop.ImageUrl" alt=""
                                     loading="lazy" />
                                <div class="bento-card__scrim"></div>
                            </div>
                        }
                        <div class="bento-card__content">
                            <div>
                                <div class="bento-card__header">
                                    <div>
                                        <span class="bento-card__parent-badge">Subcategoría</span>
                                        <h3 class="bento-card__title">@Model.CategorySection.SubCardRightTop.Name</h3>
                                    </div>
                                    <a class="bento-card__link-more bento-card__link-more--outline"
                                       asp-controller="Category" asp-action="Categoria"
                                       asp-route-slug="@Model.CategorySection.SubCardRightTop.Slug">
                                        <span>Explorar</span>
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                                             stroke="currentColor" stroke-width="2.5" stroke-linecap="round"
                                             stroke-linejoin="round">
                                            <path d="M5 12h14M12 5l7 7-7 7" />
                                        </svg>
                                    </a>
                                </div>

                                @if (!string.IsNullOrEmpty(Model.CategorySection.SubCardRightTop.Description))
                                {
                                    <p class="bento-card__desc">@Model.CategorySection.SubCardRightTop.Description</p>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Tarjeta Grande Inferior: Otra Categoría / Subcategoría destacada -->
                    <div
                        class="bento-card bento-card--large @(!string.IsNullOrEmpty(Model.CategorySection.SubCardRightBottom.ImageUrl) ? "bento-card--has-bg" : "")">
                        @if (!string.IsNullOrEmpty(Model.CategorySection.SubCardRightBottom.ImageUrl))
                        {
                            <div class="bento-card__bg" aria-hidden="true">
                                <img class="bento-card__bg-img" src="@Model.CategorySection.SubCardRightBottom.ImageUrl"
                                     alt="" loading="lazy" />
                                <div class="bento-card__scrim"></div>
                            </div>
                        }
                        <div class="bento-card__content">
                            <div>
                                <div class="bento-card__header">
                                    <div>
                                        <span class="bento-card__parent-badge">
                                            @(Model.CategorySection.SubCardRightBottom.IsMainCategory ? "Categoría Destacada" : "Subcategoría")
                                        </span>
                                        <h3 class="bento-card__title">@Model.CategorySection.SubCardRightBottom.Name
                                        </h3>
                                    </div>
                                    <a class="bento-card__link-more" asp-controller="Category" asp-action="Categoria"
                                       asp-route-slug="@Model.CategorySection.SubCardRightBottom.Slug">
                                        <span>Ver más</span>
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                                             stroke="currentColor" stroke-width="2.5" stroke-linecap="round"
                                             stroke-linejoin="round">
                                            <path d="M5 12h14M12 5l7 7-7 7" />
                                        </svg>
                                    </a>
                                </div>

                                @if (!string.IsNullOrEmpty(Model.CategorySection.SubCardRightBottom.Description))
                                {
                                    <p class="bento-card__desc">@Model.CategorySection.SubCardRightBottom.Description</p>
                                }
                            </div>

                            @if (Model.CategorySection.SubCardRightBottom.Subcategories.Any())
                            {
                                <div class="bento-card__tags">
                                    <span class="bento-card__tags-label">Especialidades:</span>
                                    @foreach (var sub in Model.CategorySection.SubCardRightBottom.Subcategories)
                                    {
                                        <a class="bento-card__tag" asp-controller="Category" asp-action="Categoria"
                                           asp-route-slug="@sub.Slug">
                                            <span>@sub.Name</span>
                                            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                 stroke-width="2.5">
                                                <path d="M9 5l7 7-7 7" />
                                            </svg>
                                        </a>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

@section Scripts {
    <script src="~/js/reveal.js" asp-append-version="true" defer></script>
    <script src="~/js/hero-dynamic.js" asp-append-version="true" defer></script>
}
