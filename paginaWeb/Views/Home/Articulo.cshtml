@model ArticleResponseDto
@{
    ViewData["Title"] = Model.Title;
    ViewData["MetaDescription"] = Model.Summary;
    var comments = (List<CommentResponseDto>?)ViewBag.Comments ?? new();
    var category = (CategoryResponseDto?)ViewBag.Category;
    var coverImage = (ImageMetadataResponseDto?)ViewBag.CoverImage;
    var coverUrl = !string.IsNullOrWhiteSpace(Model.CoverImageUrl) ? Model.CoverImageUrl : ImageMapper.GetBestUrl(coverImage);
    var recommended = (List<ArticleResponseDto>?)ViewBag.RecommendedArticles ?? new();
    var recommendedImages = (Dictionary<string, ImageMetadataResponseDto>?)ViewBag.RecommendedImages ?? new();
    var pageUrl = $"{Context.Request.Scheme}://{Context.Request.Host}/articulos/{Model.Slug}";
    var encodedUrl = Uri.EscapeDataString(pageUrl);
    var encodedTitle = Uri.EscapeDataString(Model.Title);
}

<!-- ─── Barra de Progreso de Lectura ──────────────────────────────────────── -->
<div id="readingProgress" class="fixed top-0 left-0 h-1.5 bg-[#FDC500] z-50 w-0 transition-all duration-75"></div>

<!-- ─── Toast de copia de enlace ─────────────────────────────────────────── -->
<div id="copyToast" class="fixed bottom-6 left-1/2 -translate-x-1/2 z-50 opacity-0 pointer-events-none transition-all duration-300">
    <div class="flex items-center gap-2 bg-[#00296B] text-white text-sm font-semibold px-5 py-3 rounded-full shadow-xl">
        <svg class="w-4 h-4 text-[#FDC500]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
        <span>Enlace copiado al portapapeles</span>
    </div>
</div>

<article class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-12">
    <!-- ─── Cabecera Editorial ──────────────────────────────────────────────── -->
    <header class="max-w-4xl mx-auto space-y-6 text-center">
        <!-- Breadcrumbs y Categoría -->
        <div class="flex items-center justify-center gap-2 text-xs font-semibold uppercase tracking-wider text-slate-500">
            <a href="/" class="hover:underline">Inicio</a>
            <span>/</span>
            @if (category != null)
            {
                <a href="/categoria/@category.Slug" class="text-[#00509D] hover:underline">@category.Name</a>
                <span>/</span>
            }
            <span class="text-slate-400">Lectura</span>
        </div>

        <!-- H1 Principal -->
        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-serif font-black text-[#00296B] leading-[1.15]">
            @Model.Title
        </h1>

        <!-- Bajada Destacada -->
        <p class="text-lg sm:text-xl text-slate-600 font-sans leading-relaxed max-w-3xl mx-auto">
            @Model.Summary
        </p>

        <!-- Ficha de Autor, Fecha y Tiempo de Lectura -->
        <div class="pt-4 flex items-center justify-center gap-6 text-xs text-slate-500 border-t border-b border-slate-200 py-4 max-w-xl mx-auto">
            <div class="flex items-center gap-2.5">
                @if (!string.IsNullOrWhiteSpace(Model.AuthorAvatarUrl))
                {
                    <img src="@Model.AuthorAvatarUrl" alt="@Model.Author" class="w-8 h-8 rounded-full object-cover" />
                }
                else
                {
                    <div class="w-8 h-8 rounded-full bg-[#00296B] text-[#FDC500] flex items-center justify-center font-bold text-xs">
                        @(Model.Author.Length > 0 ? Model.Author.Substring(0, 1).ToUpper() : "A")
                    </div>
                }
                <div class="text-left">
                    <span class="block font-bold text-slate-800">@Model.Author</span>
                    <span class="block text-[10px] text-slate-400">@(Model.AuthorRole ?? "Redacción Especial")</span>
                </div>
            </div>

            <div class="h-6 w-px bg-slate-200"></div>

            <div class="text-left">
                <span class="block font-medium text-slate-700">@Model.PublishedAt?.ToString("dd MMMM yyyy")</span>
                <span class="block text-[10px] text-slate-400">@Model.ViewCount lecturas</span>
            </div>

            <div class="h-6 w-px bg-slate-200"></div>

            <div class="flex items-center gap-1.5 text-[#003F88] font-bold">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                <span>@Model.ReadingTimeMinutes min de lectura</span>
            </div>
        </div>
    </header>

    <!-- ─── Portada Principal Destacada ─────────────────────────────────────── -->
    @if (!string.IsNullOrEmpty(coverUrl))
    {
        <div class="max-w-5xl mx-auto rounded-3xl overflow-hidden shadow-2xl border border-slate-200">
            <img src="@coverUrl" alt="@(!string.IsNullOrWhiteSpace(coverImage?.Alt) ? coverImage.Alt : Model.Title)"
                 class="w-full h-[400px] sm:h-[520px] object-cover" />
        </div>
    }

    <!-- ─── Barra Interactiva para Compartir ──────────────────────────────── -->
    <div class="max-w-5xl mx-auto">
        <div class="bg-white rounded-2xl border border-slate-200/80 shadow-xs px-6 py-4 flex flex-wrap items-center gap-3">
            <span class="text-xs font-bold uppercase tracking-widest text-slate-400 mr-1">Compartir:</span>

            <!-- Twitter/X -->
            <a id="share-twitter" href="https://twitter.com/intent/tweet?url=@encodedUrl&text=@encodedTitle"
               target="_blank" rel="noopener noreferrer"
               class="flex items-center gap-2 px-4 py-2 rounded-full bg-black hover:bg-slate-800 text-white text-xs font-semibold transition-all duration-200 hover:scale-105 shadow-sm">
                <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.73-8.835L1.254 2.25H8.08l4.259 5.63L18.243 2.25zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                </svg>
                <span>X / Twitter</span>
            </a>

            <!-- Facebook -->
            <a id="share-facebook" href="https://www.facebook.com/sharer/sharer.php?u=@encodedUrl"
               target="_blank" rel="noopener noreferrer"
               class="flex items-center gap-2 px-4 py-2 rounded-full bg-[#1877F2] hover:bg-[#166FE5] text-white text-xs font-semibold transition-all duration-200 hover:scale-105 shadow-sm">
                <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                </svg>
                <span>Facebook</span>
            </a>

            <!-- LinkedIn -->
            <a id="share-linkedin" href="https://www.linkedin.com/sharing/share-offsite/?url=@encodedUrl"
               target="_blank" rel="noopener noreferrer"
               class="flex items-center gap-2 px-4 py-2 rounded-full bg-[#0A66C2] hover:bg-[#0959AA] text-white text-xs font-semibold transition-all duration-200 hover:scale-105 shadow-sm">
                <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                </svg>
                <span>LinkedIn</span>
            </a>

            <!-- WhatsApp -->
            <a id="share-whatsapp" href="https://api.whatsapp.com/send?text=@encodedTitle%20@encodedUrl"
               target="_blank" rel="noopener noreferrer"
               class="flex items-center gap-2 px-4 py-2 rounded-full bg-[#25D366] hover:bg-[#20BD5C] text-white text-xs font-semibold transition-all duration-200 hover:scale-105 shadow-sm">
                <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
                </svg>
                <span>WhatsApp</span>
            </a>

            <!-- Copiar enlace -->
            <button id="copyLinkBtn" type="button"
                    class="flex items-center gap-2 px-4 py-2 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold transition-all duration-200 hover:scale-105 shadow-sm ml-auto">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"/></svg>
                <span>Copiar enlace</span>
            </button>
        </div>
    </div>

    <!-- ─── Layout a Dos Columnas (Índice Adhesivo + Contenido) ─────────────── -->
    <div class="max-w-5xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 items-start pt-6">
        <!-- Columna Izquierda Adhesiva (Índice "En esta página") -->
        <aside class="hidden lg:block lg:col-span-4 sticky top-28 bg-white p-6 rounded-3xl border border-slate-200/80 shadow-xs space-y-4">
            <h4 class="font-bold text-slate-800 text-xs uppercase tracking-wider flex items-center gap-2">
                <svg class="w-4 h-4 text-[#FDC500]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7"/></svg>
                En esta página
            </h4>
            <nav id="tableOfContents" class="space-y-2 text-xs text-slate-600">
                <!-- Se poblará vía JavaScript con los H2 y H3 -->
                <span class="text-slate-400 italic">Cargando secciones...</span>
            </nav>
        </aside>

        <!-- Columna Derecha (Cuerpo del Artículo) -->
        <main class="lg:col-span-8 bg-white p-8 sm:p-12 rounded-3xl border border-slate-200/80 shadow-xs">
            <div id="articleBody" class="article-prose max-w-none font-sans leading-relaxed text-slate-800 space-y-6">
                @Html.Raw(Model.Content)
            </div>

            <!-- Tags del Artículo -->
            @if (Model.Tags.Any())
            {
                <div class="mt-12 pt-8 border-t border-slate-200 flex flex-wrap items-center gap-2">
                    <span class="text-xs font-bold uppercase tracking-wider text-slate-400 mr-2">Temas:</span>
                    @foreach (var tag in Model.Tags)
                    {
                        <span class="px-3 py-1 rounded-full text-xs font-semibold bg-slate-100 text-slate-700 hover:bg-slate-200 transition">
                            #@tag
                        </span>
                    }
                </div>
            }

            <!-- ─── Ficha Extendida del Autor ──────────────────────────────── -->
            <div class="mt-12 pt-8 border-t border-slate-200">
                <div class="flex items-start gap-5 bg-gradient-to-br from-slate-50 to-blue-50/40 rounded-2xl p-6 border border-slate-200/80">
                    <!-- Avatar del Autor -->
                    <div class="flex-shrink-0">
                        @if (!string.IsNullOrWhiteSpace(Model.AuthorAvatarUrl))
                        {
                            <img src="@Model.AuthorAvatarUrl" alt="Foto de @Model.Author"
                                 class="w-16 h-16 rounded-2xl object-cover shadow-md" />
                        }
                        else
                        {
                            <div class="w-16 h-16 rounded-2xl bg-[#00296B] text-[#FDC500] flex items-center justify-center font-black text-2xl shadow-md">
                                @(Model.Author.Length > 0 ? Model.Author.Substring(0, 1).ToUpper() : "A")
                            </div>
                        }
                    </div>
                    <!-- Datos del Autor -->
                    <div class="flex-1 min-w-0 space-y-2">
                        <div class="flex items-center gap-3 flex-wrap">
                            <div>
                                <p class="font-black text-slate-900 text-base leading-tight">@Model.Author</p>
                                <p class="text-xs font-semibold text-[#00509D] uppercase tracking-wider mt-0.5">
                                    @(Model.AuthorRole ?? "Redacción Especial")
                                </p>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(Model.AuthorSocialUrl))
                            {
                                <a href="@Model.AuthorSocialUrl" target="_blank" rel="noopener noreferrer"
                                   class="ml-auto flex items-center gap-1.5 text-xs font-semibold text-slate-500 hover:text-[#00296B] transition border border-slate-200 rounded-full px-3 py-1.5 hover:border-[#00296B]">
                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
                                    Ver perfil
                                </a>
                            }
                        </div>
                        @if (!string.IsNullOrWhiteSpace(Model.AuthorBio))
                        {
                            <p class="text-sm text-slate-600 leading-relaxed">@Model.AuthorBio</p>
                        }
                        else
                        {
                            <p class="text-sm text-slate-500 italic leading-relaxed">Periodismo de investigación, análisis editorial y contenido de impacto para nuestra comunidad de lectores.</p>
                        }
                    </div>
                </div>
            </div>
        </main>
    </div>

    <!-- ─── Sección de Artículos Recomendados ────────────────────────────────── -->
    @if (recommended.Any())
    {
        <section class="max-w-5xl mx-auto space-y-6">
            <div class="flex items-center gap-3">
                <div class="h-px flex-1 bg-slate-200"></div>
                <h3 class="font-serif font-black text-xl text-[#00296B] whitespace-nowrap flex items-center gap-2">
                    <svg class="w-5 h-5 text-[#FDC500]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                    También te puede interesar
                </h3>
                <div class="h-px flex-1 bg-slate-200"></div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                @foreach (var rec in recommended)
                {
                    var recImage = rec.CoverImageId != null && recommendedImages.TryGetValue(rec.CoverImageId, out var ri) ? ri : null;
                    var recUrl = !string.IsNullOrWhiteSpace(rec.CoverImageUrl) ? rec.CoverImageUrl : ImageMapper.GetBestUrl(recImage);
                    <a href="/articulos/@rec.Slug"
                       class="group block bg-white rounded-2xl border border-slate-200/80 shadow-xs hover:shadow-lg overflow-hidden transition-all duration-300 hover:-translate-y-1">
                        <!-- Imagen -->
                        <div class="h-44 bg-slate-100 overflow-hidden">
                            @if (!string.IsNullOrEmpty(recUrl))
                            {
                                <img src="@recUrl" alt="@rec.Title"
                                     class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                            }
                            else
                            {
                                <div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-[#00296B]/10 to-[#FDC500]/10">
                                    <svg class="w-12 h-12 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                                </div>
                            }
                        </div>
                        <!-- Contenido -->
                        <div class="p-5 space-y-2">
                            <p class="text-[10px] font-bold uppercase tracking-widest text-[#00509D]">@(category?.Name ?? "Artículo")</p>
                            <h4 class="font-serif font-bold text-slate-900 text-sm leading-snug line-clamp-2 group-hover:text-[#00296B] transition-colors">
                                @rec.Title
                            </h4>
                            <div class="flex items-center gap-3 text-[10px] text-slate-400 pt-1">
                                <span class="flex items-center gap-1">
                                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                                    @rec.ReadingTimeMinutes min
                                </span>
                                <span>@rec.PublishedAt?.ToString("dd MMM yyyy")</span>
                            </div>
                        </div>
                    </a>
                }
            </div>
        </section>
    }

    <!-- ─── Sección de Comentarios y Discusión ──────────────────────────────── -->
    <section class="max-w-3xl mx-auto pt-12 space-y-10 border-t border-slate-200">
        <div class="flex items-center justify-between">
            <h3 class="font-serif font-black text-2xl text-[#00296B]">Comentarios (@comments.Count)</h3>
            <span class="text-xs text-slate-500">Moderación previa requerida</span>
        </div>

        @if (TempData["CommentSuccess"] != null)
        {
            <div class="p-4 rounded-2xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-sm flex items-center gap-3">
                <svg class="w-5 h-5 text-emerald-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                <span>@TempData["CommentSuccess"]</span>
            </div>
        }
        @if (TempData["CommentError"] != null)
        {
            <div class="p-4 rounded-2xl bg-rose-50 border border-rose-200 text-rose-800 text-sm flex items-center gap-3">
                <svg class="w-5 h-5 text-rose-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                <span>@TempData["CommentError"]</span>
            </div>
        }

        <!-- Formulario de Envío con Honeypot -->
        <div class="bg-white rounded-3xl p-8 border border-slate-200/80 shadow-xs space-y-6">
            <h4 class="font-bold text-slate-800 text-base">Deja tu comentario</h4>

            <form method="post" action="/articulos/comentar" class="space-y-4">
                @Html.AntiForgeryToken()
                <input type="hidden" name="ArticleId" value="@Model.Id" />
                <input type="hidden" name="articleSlug" value="@Model.Slug" />

                <!-- Campo trampa Honeypot (Oculto para humanos, bots lo llenan) -->
                <div style="display:none !important;" aria-hidden="true">
                    <label for="trapField">Leave this field empty</label>
                    <input type="text" id="trapField" name="Trap" tabindex="-1" autocomplete="off" />
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 mb-1">Nombre</label>
                        <input type="text" name="Name" required placeholder="Tu nombre..."
                               class="w-full text-sm rounded-xl border border-slate-300 px-4 py-2.5 focus:ring-2 focus:ring-[#00509D] outline-none" />
                    </div>

                    <div>
                        <label class="block text-xs font-semibold text-slate-600 mb-1">Correo Electrónico (No se publicará)</label>
                        <input type="email" name="Email" required placeholder="tu@correo.com"
                               class="w-full text-sm rounded-xl border border-slate-300 px-4 py-2.5 focus:ring-2 focus:ring-[#00509D] outline-none" />
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-600 mb-1">Comentario</label>
                    <textarea name="Content" rows="4" required placeholder="Escribe tu reflexión con respeto y apego al debate público..."
                              class="w-full text-sm rounded-xl border border-slate-300 p-4 focus:ring-2 focus:ring-[#00509D] outline-none leading-relaxed"></textarea>
                </div>

                <button type="submit" class="px-6 py-3 rounded-full bg-[#00296B] hover:bg-[#003F88] text-white font-bold text-xs uppercase tracking-wider shadow-sm transition">
                    Enviar Comentario
                </button>
            </form>
        </div>

        <!-- Lista de Comentarios Aprobados -->
        @if (!comments.Any())
        {
            <div class="text-center py-8 text-slate-400 text-sm italic">
                Sé el primero en comentar esta publicación.
            </div>
        }
        else
        {
            <div class="space-y-4">
                @foreach (var c in comments)
                {
                    <div class="bg-white rounded-2xl p-6 border border-slate-200/80 shadow-xs space-y-2">
                        <div class="flex items-center justify-between">
                            <span class="font-bold text-slate-900 text-sm">@c.Name</span>
                            <span class="text-xs text-slate-400">@c.CreatedAt.ToString("dd MMM yyyy, HH:mm")</span>
                        </div>
                        <p class="text-sm text-slate-700 leading-relaxed font-sans">
                            @c.Content
                        </p>
                    </div>
                }
            </div>
        }
    </section>
</article>

@section Scripts {
    <script>
        // ─── 1. Barra de progreso de lectura ───────────────────────────────────
        window.addEventListener('scroll', () => {
            const docHeight = document.documentElement.scrollHeight - document.documentElement.clientHeight;
            const scrolled = (window.scrollY / docHeight) * 100;
            const bar = document.getElementById('readingProgress');
            if (bar) bar.style.width = scrolled + '%';
        });

        // ─── 2. Índice Interactivo ("En esta página") dinámico ──────────────────
        document.addEventListener('DOMContentLoaded', () => {
            const body = document.getElementById('articleBody');
            const toc = document.getElementById('tableOfContents');
            if (!body || !toc) return;

            const headings = body.querySelectorAll('h2, h3');
            if (headings.length === 0) {
                toc.innerHTML = '<span class="text-slate-400 italic">Lectura corrida continua</span>';
                return;
            }

            toc.innerHTML = '';
            headings.forEach((h, idx) => {
                const id = 'section-' + idx;
                h.id = id;

                const link = document.createElement('a');
                link.href = '#' + id;
                link.innerText = h.innerText;
                link.className = 'block py-1 hover:text-[#00296B] transition ' +
                    (h.tagName === 'H3' ? 'pl-3 text-slate-500' : 'font-semibold text-slate-700');

                toc.appendChild(link);
            });

            // Resaltar la sección activa al hacer scroll
            const allLinks = toc.querySelectorAll('a');
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        allLinks.forEach(l => l.classList.remove('text-[#00296B]', '!font-black'));
                        const activeLink = toc.querySelector(`a[href="#${entry.target.id}"]`);
                        if (activeLink) activeLink.classList.add('text-[#00296B]', '!font-black');
                    }
                });
            }, { rootMargin: '-20% 0px -70% 0px' });

            headings.forEach(h => observer.observe(h));
        });

        // ─── 3. Copiar enlace al portapapeles con Toast ────────────────────────
        document.addEventListener('DOMContentLoaded', () => {
            const btn = document.getElementById('copyLinkBtn');
            const toast = document.getElementById('copyToast');
            if (!btn || !toast) return;

            btn.addEventListener('click', async () => {
                const url = window.location.href;
                try {
                    await navigator.clipboard.writeText(url);
                } catch {
                    // Fallback para navegadores sin clipboard API
                    const ta = document.createElement('textarea');
                    ta.value = url;
                    ta.style.position = 'fixed';
                    ta.style.opacity = '0';
                    document.body.appendChild(ta);
                    ta.focus();
                    ta.select();
                    document.execCommand('copy');
                    document.body.removeChild(ta);
                }
                // Mostrar toast
                toast.classList.remove('opacity-0', 'pointer-events-none');
                toast.classList.add('opacity-100');
                setTimeout(() => {
                    toast.classList.remove('opacity-100');
                    toast.classList.add('opacity-0', 'pointer-events-none');
                }, 2800);
            });
        });
    </script>
}
