@model SearchViewModel
@using paginaWeb.Models.Home
@{
    var isSearch = !string.IsNullOrEmpty(Model.Query);
    ViewData["Title"] = isSearch ? $"Resultados para: '{Model.Query}'" : "Publicaciones";
    ViewData["MetaDescription"] = isSearch
        ? $"Resultados de búsqueda para {Model.Query} en el portal."
        : "Explora todas las publicaciones, noticias, reportajes y coberturas del portal.";
}

@section Styles {
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-12">
    <!-- ─── Cabecera y Caja de Búsqueda ──────────────────────────────────────── -->
    <div class="bg-white rounded-3xl p-8 sm:p-12 border border-slate-200/80 shadow-xs max-w-4xl mx-auto space-y-4">
        <!-- Breadcrumb -->
        <div class="flex items-center justify-center gap-2 text-xs font-semibold text-slate-400 uppercase tracking-wider">
            <a asp-controller="Home" asp-action="Index" class="hover:underline hover:text-slate-600 transition">Inicio</a>
            <span>/</span>
            <span class="text-[#00296B] font-bold">Publicaciones</span>
            @if (isSearch)
            {
                <span>/</span>
                <span class="text-slate-600">Búsqueda</span>
            }
            @if (Model.CurrentPage > 1)
            {
                <span>/</span>
                <span>Página @Model.CurrentPage</span>
            }
        </div>

        <h1 class="text-3xl sm:text-4xl font-serif font-black text-[#00296B] text-center">
            @(isSearch ? "Resultados de Búsqueda" : "Buscador de Publicaciones")
        </h1>
        <p class="text-xs sm:text-sm text-slate-500 text-center max-w-md mx-auto">
            Encuentra crónicas, análisis, columnas de opinión y coberturas informativas.
        </p>

        <form method="get" asp-controller="Home" asp-action="Buscar" class="flex gap-2 max-w-2xl mx-auto pt-2">
            <input type="text" name="q" value="@Model.Query" placeholder="Escribe tu búsqueda..."
                   class="flex-1 px-5 py-3 rounded-full border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-[#00509D]" />
            <button type="submit" class="px-6 py-3 rounded-full bg-[#00296B] hover:bg-[#003F88] text-white text-xs font-bold uppercase tracking-wider shadow-sm transition">
                Buscar
            </button>
            @if (isSearch)
            {
                <a asp-controller="Home" asp-action="Buscar"
                   class="px-5 py-3 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold uppercase tracking-wider transition flex items-center">
                    Limpiar
                </a>
            }
        </form>

        <div class="text-center text-xs font-semibold text-slate-500 pt-2">
            @if (isSearch)
            {
                <span>Se encontraron <strong class="text-[#00296B]">@Model.TotalCount</strong> resultados para "<strong class="text-slate-800">@Model.Query</strong>"</span>
            }
            else
            {
                <span>Mostrando las publicaciones más recientes (<strong class="text-[#00296B]">@Model.TotalCount</strong> en total)</span>
            }
        </div>
    </div>

    <!-- ─── Cuadrícula de Publicaciones (Estilo _PostCard) ───────────────────── -->
    @if (!Model.Items.Any())
    {
        <div class="bg-white rounded-3xl p-16 text-center text-slate-400 border border-slate-200/80 max-w-3xl mx-auto">
            <svg class="w-12 h-12 mx-auto text-slate-300 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            <p class="text-lg font-semibold text-slate-700">No encontramos publicaciones que coincidan con tu criterio.</p>
            <p class="text-xs text-slate-400 mt-2">Prueba con palabras clave diferentes o restablece la búsqueda.</p>
            <a asp-controller="Home" asp-action="Buscar" class="mt-6 inline-block px-5 py-2.5 rounded-full bg-[#00296B] text-white text-xs font-bold shadow-xs">
                Ver todas las publicaciones
            </a>
        </div>
    }
    else
    {
        <ul class="card-grid card-grid--posts" role="list">
            @foreach (var art in Model.Items)
            {
                var postCard = new PostCardViewModel(
                    Title: art.Article.Title,
                    Excerpt: art.Article.Summary,
                    Category: art.CategoryName,
                    PublishedAt: art.Article.PublishedAt,
                    Href: Url.Action("Articulo", "Home", new { slug = art.Article.Slug }) ?? "#",
                    Image: new CardImage(
                        Url: art.ImageUrl ?? art.Article.CoverImageUrl,
                        Alt: art.Article.Title,
                        Width: 800,
                        Height: 500)
                );
                <li class="card-grid__item" data-reveal>
                    <partial name="Partials/Home/_PostCard" model="postCard" />
                </li>
            }
        </ul>

        <!-- ─── Paginación ──────────────────────────────────────────────────── -->
        @if (Model.TotalPages > 1)
        {
            <div class="flex items-center justify-center gap-2 pt-8">
                @if (Model.CurrentPage > 1)
                {
                    <a asp-controller="Home" asp-action="Buscar"
                       asp-route-q="@Model.Query"
                       asp-route-page="@(Model.CurrentPage - 1)"
                       class="px-4 py-2 rounded-xl bg-white border border-slate-200 text-xs font-semibold text-slate-700 hover:bg-slate-50 transition">
                        ← Anterior
                    </a>
                }
                @for (int p = 1; p <= Model.TotalPages; p++)
                {
                    var isCurrent = p == Model.CurrentPage;
                    <a asp-controller="Home" asp-action="Buscar"
                       asp-route-q="@Model.Query"
                       asp-route-page="@p"
                       class="w-9 h-9 rounded-xl flex items-center justify-center text-xs font-bold transition @(isCurrent ? "bg-[#00296B] text-white shadow-xs" : "bg-white border border-slate-200 text-slate-700 hover:bg-slate-50")">
                        @p
                    </a>
                }
                @if (Model.CurrentPage < Model.TotalPages)
                {
                    <a asp-controller="Home" asp-action="Buscar"
                       asp-route-q="@Model.Query"
                       asp-route-page="@(Model.CurrentPage + 1)"
                       class="px-4 py-2 rounded-xl bg-white border border-slate-200 text-xs font-semibold text-slate-700 hover:bg-slate-50 transition">
                        Siguiente →
                    </a>
                }
            </div>
        }
    }
</div>

@section Scripts {
    <script src="~/js/reveal.js" asp-append-version="true" defer></script>
}
