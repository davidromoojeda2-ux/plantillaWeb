@model List<Domine.Entities.Article>
@{
    string query = (string)ViewBag.Query;
    ViewData["Title"] = string.IsNullOrEmpty(query) ? "Buscar Noticias" : $"Resultados para: '{query}'";
    var categories = (Dictionary<string, string>?)ViewBag.Categories ?? new();
    var images = (Dictionary<string, Domine.Entities.ImageMetadata>?)ViewBag.Images ?? new();
    int currentPage = (int)ViewBag.Page;
    int totalPages = (int)ViewBag.TotalPages;
    long totalCount = (long)ViewBag.TotalCount;
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-12">
    <!-- ─── Caja de Búsqueda ────────────────────────────────────────────────── -->
    <div class="bg-white rounded-3xl p-8 sm:p-12 border border-slate-200/80 shadow-xs max-w-4xl mx-auto space-y-4">
        <h1 class="text-2xl sm:text-4xl font-serif font-black text-[#00296B] text-center">Buscador de Publicaciones</h1>
        <p class="text-xs sm:text-sm text-slate-500 text-center max-w-md mx-auto">
            Encuentra crónicas, análisis, columnas de opinión y coberturas informativas.
        </p>

        <form method="get" action="/buscar" class="flex gap-2 max-w-2xl mx-auto pt-2">
            <input type="text" name="q" value="@query" placeholder="Escribe tu búsqueda..." required
                   class="flex-1 px-5 py-3 rounded-full border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-[#00509D]" />
            <button type="submit" class="px-6 py-3 rounded-full bg-[#00296B] hover:bg-[#003F88] text-white text-xs font-bold uppercase tracking-wider shadow-sm transition">
                Buscar
            </button>
        </form>

        @if (!string.IsNullOrEmpty(query))
        {
            <div class="text-center text-xs font-semibold text-slate-500 pt-2">
                Se encontraron <span class="text-[#00296B] font-bold">@totalCount</span> resultados para "@query"
            </div>
        }
    </div>

    <!-- ─── Resultados ──────────────────────────────────────────────────────── -->
    @if (!string.IsNullOrEmpty(query) && !Model.Any())
    {
        <div class="bg-white rounded-3xl p-16 text-center text-slate-400 border border-slate-200/80 max-w-3xl mx-auto">
            <svg class="w-12 h-12 mx-auto text-slate-300 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
            <p class="text-lg font-semibold text-slate-700">No encontramos coincidencias para tu búsqueda.</p>
            <p class="text-xs text-slate-400 mt-2">Prueba con palabras clave más generales o navega por las categorías.</p>
            <a href="/" class="mt-6 inline-block px-5 py-2.5 rounded-full bg-[#FDC500] text-[#00296B] text-xs font-bold shadow-xs">
                Ver portada principal
            </a>
        </div>
    }
    else if (Model.Any())
    {
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            @foreach (var art in Model)
            {
                var artCover = art.CoverImageId != null && images.ContainsKey(art.CoverImageId) ? images[art.CoverImageId] : null;
                var artImgUrl = artCover?.Variants.FirstOrDefault()?.PublicUrl ?? "https://images.unsplash.com/photo-1495020689067-958852a7765e?w=800&auto=format&fit=crop&q=80";
                var artCat = art.CategoryId != null && categories.ContainsKey(art.CategoryId) ? categories[art.CategoryId] : "General";

                <article class="bg-white rounded-3xl border border-slate-200/80 shadow-xs overflow-hidden flex flex-col justify-between hover:-translate-y-1 hover:shadow-lg transition-all duration-300 group">
                    <div>
                        <div class="aspect-[16/10] overflow-hidden bg-slate-100 relative">
                            <img src="@artImgUrl" alt="@art.Title" loading="lazy"
                                 class="w-full h-full object-cover group-hover:scale-105 transition duration-500" />
                            <span class="absolute top-3 left-3 px-3 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider bg-white/95 text-[#00296B] shadow-xs">
                                @artCat
                            </span>
                        </div>

                        <div class="p-6 space-y-3">
                            <div class="flex items-center gap-2 text-[11px] text-slate-400">
                                <span>@art.PublishedAt?.ToString("dd MMMM yyyy")</span>
                                <span>•</span>
                                <span>@art.ViewCount lecturas</span>
                            </div>

                            <h3 class="font-serif font-bold text-lg text-slate-900 group-hover:text-[#00509D] transition leading-snug line-clamp-2">
                                <a href="/articulos/@art.Slug">@art.Title</a>
                            </h3>

                            <p class="text-xs text-slate-600 line-clamp-3 leading-relaxed">
                                @art.Summary
                            </p>
                        </div>
                    </div>

                    <div class="px-6 pb-6 pt-3 border-t border-slate-100 flex items-center justify-between text-xs">
                        <span class="font-semibold text-slate-700">@art.Author</span>
                        <a href="/articulos/@art.Slug" class="font-bold text-[#00509D] hover:underline">
                            Leer nota →
                        </a>
                    </div>
                </article>
            }
        </div>

        @if (totalPages > 1)
        {
            <div class="flex items-center justify-center gap-2 pt-8">
                @for (int p = 1; p <= totalPages; p++)
                {
                    <a href="/buscar?q=@query&page=@p"
                       class="w-9 h-9 rounded-xl flex items-center justify-center text-xs font-bold transition @(p == currentPage ? "bg-[#00296B] text-white" : "bg-white border border-slate-200 text-slate-700 hover:bg-slate-50")">
                        @p
                    </a>
                }
            </div>
        }
    }
</div>
