@model paginaWeb.Models.Publicaciones.PublicacionesPageViewModel
@using paginaWeb.Models.Home
@{
    var isSearch = Model.IsSearch;
    ViewData["Title"] = isSearch ? $"Resultados para: '{Model.Query}'" : "Publicaciones";
    ViewData["MetaDescription"] = isSearch
        ? $"Resultados de búsqueda para {Model.Query} en el portal."
        : "Explora todas las publicaciones, noticias, reportajes y coberturas del portal.";
}

@section Styles {
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
}

<div class="public-page">
    <!-- ─── 1. Cabecera Hero de Extremo a Extremo (Full Width) ───────────────── -->
    <header class="page-hero">
        <div class="page-hero__glow" aria-hidden="true"></div>

        <div class="container page-hero__inner">
            <!-- Breadcrumb -->
            <nav class="page-hero__breadcrumb" aria-label="Migas de pan">
                <a asp-controller="Home" asp-action="Index">Inicio</a>
                <span>/</span>
                <span class="page-hero__breadcrumb-current">Publicaciones</span>
                @if (isSearch)
                {
                    <span>/</span>
                    <span class="text-white/80">Búsqueda</span>
                }
                @if (Model.CurrentPage > 1)
                {
                    <span>/</span>
                    <span>Página @Model.CurrentPage</span>
                }
            </nav>

            <h1 class="page-hero__title">
                @(isSearch ? "Resultados de Búsqueda" : "Publicaciones del Portal")
            </h1>

            <p class="page-hero__subtitle">
                @(isSearch
                    ? $"Explorando contenidos relacionados con '{Model.Query}' en nuestras áreas temáticas y coberturas."
                    : "Encuentra crónicas, análisis, investigaciones y las coberturas informativas más recientes de nuestra redacción.")
            </p>
        </div>
    </header>

    <!-- ─── 2. Contenido de Extremo a Extremo (Mismo contenedor de la Home) ─── -->
    <main class="page-content-section container">
        @if (!Model.Items.Any())
        {
            <div
                class="bg-white rounded-2xl p-12 sm:p-16 text-center text-slate-500 border border-slate-200/90 shadow-xs max-w-2xl mx-auto my-8">
                <svg class="w-14 h-14 mx-auto text-slate-300 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                          d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                </svg>
                <h3 class="text-xl font-bold text-[#00296B]">No encontramos publicaciones que coincidan</h3>
                <p class="text-sm text-slate-500 mt-2">Prueba con palabras clave diferentes o restablece los filtros de
                    búsqueda.</p>
                    <a asp-controller="Publicaciones" asp-action="Index"
                       class="mt-6 inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-[#00296B] hover:bg-[#003F88] text-white text-xs font-bold uppercase tracking-wider transition shadow-sm">
                        Ver todas las publicaciones
                    </a>
                </div>
            }
        else
            {
                <ul class="card-grid card-grid--posts" role="list">
                    @foreach (var art in Model.Items)
                    {
                        <partial name="Partials/_PostCard" model="art" />
                    }
                </ul>

                <!-- ─── Paginación Modular Reutilizable ───────────────────────────── -->
                <partial name="Partials/_Pagination"
                         model="PaginationViewModel.ForPublicaciones(Model.CurrentPage, Model.TotalPages, Model.Query)" />
            }
        </main>
    </div>

    @section Scripts {
        <script src="~/js/reveal.js" asp-append-version="true" defer></script>
    }
