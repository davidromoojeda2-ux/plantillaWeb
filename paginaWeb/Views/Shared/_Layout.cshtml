@inject Aplication.Services.IPageService PageService
@inject Aplication.Services.ISiteSettingsService SiteSettingsService
@{
    var footerPages = await PageService.GetFooterPagesAsync();
    var siteSettings = await SiteSettingsService.GetAsync();
    var socialProfiles = siteSettings.SocialProfiles
        .Where(p => p.Active && !string.IsNullOrWhiteSpace(p.Url))
        .OrderBy(p => p.Order)
        .ToList();
}
<!DOCTYPE html>
<html lang="es" class="h-full scroll-smooth">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] != null ? $"{ViewData["Title"]} - Portal Noticias" : "Portal Noticias - Periodismo Independiente y Análisis Profundo")</title>
    <meta name="description" content="@(ViewData["MetaDescription"] ?? "Portal informativo con las últimas noticias, cobertura en profundidad, reportajes y análisis sobre tecnología, economía y cultura.")" />

    <meta property="og:title" content="@(ViewData["Title"] ?? "Portal Noticias")" />
    <meta property="og:description" content="@(ViewData["MetaDescription"] ?? "Noticias rigurosas y actualizadas.")" />
    <meta property="og:type" content="website" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Merriweather:ital,wght@0,300;0,400;0,700;0,900;1,300;1,400;1,700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/tailwind.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="min-h-full flex flex-col font-sans text-slate-800 bg-[#F5F6F8] antialiased selection:bg-[#FDC500] selection:text-[#00296B]">

    <!-- ─── Barra Superior de Navegación Unificada ───────────────────────────── -->
    @await Component.InvokeAsync("Navbar")

    <!-- ─── Contenido Principal ──────────────────────────────────────────────── -->
    <main class="flex-1">
        @RenderBody()
    </main>

    <!-- ─── Pie de Página Dinámico de 5 Columnas Unificado ───────────────────── -->
    <partial name="Partials/_Footer" model="(Pages: footerPages, SocialProfiles: socialProfiles)" />

    <!-- ─── Botón flotante de WhatsApp (solo pantallas chicas) ────────────────── -->
    <button type="button"
            data-open-whatsapp-groups
            aria-haspopup="dialog"
            aria-controls="whatsAppGroupsPublicModal"
            aria-label="Únete a nuestros grupos de WhatsApp"
            class="min-[900px]:hidden fixed bottom-24 right-5 z-40 inline-flex items-center justify-center w-14 h-14 rounded-full bg-[#25D366] hover:bg-[#20BD5C] text-white shadow-[0_8px_24px_rgba(37,211,102,0.45)] ring-4 ring-white/30 transition-all duration-200 hover:scale-105 active:scale-95">
        <svg class="w-7 h-7" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z" />
        </svg>
    </button>

    <!-- ─── Banner de Cookies ────────────────────────────────────────────────── -->
    <div id="cookieBanner" class="hidden fixed bottom-4 right-4 max-w-md bg-slate-900 text-white rounded-2xl p-5 shadow-2xl border border-white/10 z-50 transition-all duration-300">
        <div class="flex items-start gap-4">
            <span class="text-2xl flex-shrink-0">🍪</span>
            <div class="space-y-2">
                <h5 class="font-bold text-sm">Respetamos tu privacidad</h5>
                <p class="text-xs text-slate-300 leading-relaxed">
                    Utilizamos cookies analíticas para mejorar tu experiencia en nuestro portal. No compartimos información personal con terceros.
                </p>
                <div class="pt-2 flex items-center gap-3">
                    <button type="button" id="acceptCookiesBtn" class="px-4 py-1.5 rounded-xl bg-[#FDC500] hover:bg-[#FFD500] text-[#00296B] font-bold text-xs shadow-xs transition">
                        Aceptar
                    </button>
                    <a asp-controller="Home" asp-action="Info" asp-route-slug="politica-de-privacidad" class="text-xs text-slate-400 hover:text-white underline">
                        Más información
                    </a>
                </div>
            </div>
        </div>
    </div>

    <script src="~/js/site.js" asp-append-version="true" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
