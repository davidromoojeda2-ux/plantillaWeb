@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<section class="mx-auto max-w-3xl px-4 py-20 text-center">
    <p class="text-sm font-semibold uppercase tracking-widest text-red-600">Error 500</p>
    <h1 class="mt-3 text-3xl font-bold text-slate-900">No se ha podido procesar tu solicitud</h1>
    <p class="mt-4 text-base text-slate-600">
        Ha ocurrido un problema inesperado en el servidor. Vuelve a intentarlo en unos instantes.
    </p>

    @if (Model.ShowRequestId)
    {
        <p class="mt-6 text-sm text-slate-500">
            Identificador de la solicitud: <code class="rounded bg-slate-100 px-2 py-1">@Model.RequestId</code>
        </p>
    }

    <a href="/" class="mt-8 inline-flex items-center rounded-lg bg-slate-900 px-5 py-3 text-sm font-semibold text-white hover:bg-slate-700">
        Volver al inicio
    </a>
</section>
