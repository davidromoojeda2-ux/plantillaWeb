@model AuthorDto

@if (Model != null && !string.IsNullOrWhiteSpace(Model.Name))
{
    <div
        class="flex items-start gap-5 bg-gradient-to-br from-slate-50 to-blue-50/40 rounded-xl p-6 border border-slate-200/90 shadow-xs">
        <!-- Avatar del Autor -->
        <div class="flex-shrink-0">
            @if (!string.IsNullOrWhiteSpace(Model.AvatarUrl))
            {
                <img src="@Model.AvatarUrl" alt="Foto de @Model.Name" class="w-16 h-16 rounded-2xl object-cover shadow-md" />
            }
            else
            {
                <div
                    class="w-16 h-16 rounded-2xl bg-[#00296B] text-[#FDC500] flex items-center justify-center font-black text-2xl shadow-md">
                    @(Model.Name.Length > 0 ? Model.Name.Substring(0, 1).ToUpper() : "A")
                </div>
            }
        </div>
        <!-- Datos del Autor -->
        <div class="flex-1 min-w-0 space-y-2">
            <div class="flex items-center gap-3 flex-wrap">
                <div>
                    <p class="font-black text-slate-900 text-base leading-tight">@Model.Name</p>
                    <p class="text-xs font-semibold text-[#00509D] uppercase tracking-wider mt-0.5">
                        @(Model.Role ?? "Redacción Especial")
                    </p>
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.SocialUrl))
                {
                    <a href="@Model.SocialUrl" target="_blank" rel="noopener noreferrer"
                       class="ml-auto flex items-center gap-1.5 text-xs font-semibold text-slate-500 hover:text-[#00296B] transition border border-slate-200 rounded-xl px-3 py-1.5 hover:border-[#00296B]">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                        </svg>
                        Ver perfil
                    </a>
                }
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.Bio))
            {
                <p class="text-sm text-slate-600 leading-relaxed">@Model.Bio</p>
            }
            else
            {
                <p class="text-sm text-slate-500 italic leading-relaxed">Periodismo de investigación, análisis editorial y
                    contenido de impacto para nuestra comunidad de lectores.</p>
                }
            </div>
        </div>
    }
