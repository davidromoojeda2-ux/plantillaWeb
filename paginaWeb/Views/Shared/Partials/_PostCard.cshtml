@model object
@{
    PostCardViewModel? card = null;

    if (Model is PostCardViewModel p)
    {
        card = p;
    }
    else if (Model is paginaWeb.Models.Category.ArticleCardViewModel art)
    {
        var slug = art.Article?.Slug ?? string.Empty;
        var href = Url.Action("Articulo", "Home", new { slug }) ?? $"/articulos/{slug}";
        card = PostCardViewModel.FromArticle(art, href: href);
    }
    else if (Model is Aplication.DTOs.ArticleResponseDto dto)
    {
        var slug = dto?.Slug ?? string.Empty;
        var href = Url.Action("Articulo", "Home", new { slug }) ?? $"/articulos/{slug}";
        card = PostCardViewModel.FromDto(dto, href: href);
    }

    if (card == null)
    {
        return;
    }
}

@if (card.AsGridItem)
{
    <li class="card-grid__item" data-reveal>
        <article class="card card--post card--mosaic @card.CustomClass">
            <!-- Capa visual de fondo: Imagen de portada o fallback elegante -->
            <div class="card-mosaic__media">
                @if (card.Image.HasUrl)
                {
                    <img class="card-mosaic__img"
                         src="@card.Image.Url"
                         alt="@card.Image.Alt"
                         width="@card.Image.Width"
                         height="@card.Image.Height"
                         loading="lazy"
                         decoding="async" />
                }
                else
                {
                    <div class="card-mosaic__fallback" role="img" aria-label="@card.Image.Alt">
                        <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true" focusable="false">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
                        </svg>
                    </div>
                }
                <div class="card-mosaic__scrim" aria-hidden="true"></div>
            </div>

            <!-- Contenido interno: categoría superior, flecha ↗, y título DENTRO del card -->
            <div class="card-mosaic__inner">
                <header class="card-mosaic__header">
                    <span class="card-mosaic__category">@card.Category</span>
                    <span class="card-mosaic__arrow" aria-hidden="true">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="7" y1="17" x2="17" y2="7"></line>
                            <polyline points="7 7 17 7 17 17"></polyline>
                        </svg>
                    </span>
                </header>

                <div class="card-mosaic__body">
                    <h3 class="card-mosaic__title">
                        <a class="card__link" href="@card.Href">@card.Title</a>
                    </h3>

                    @if (!string.IsNullOrWhiteSpace(card.Excerpt))
                    {
                        <p class="card-mosaic__excerpt">@card.Excerpt</p>
                    }

                    <footer class="card-mosaic__footer">
                        @if (card.PublishedAt is DateTime date)
                        {
                            <time class="card-mosaic__date" datetime="@date.ToString("yyyy-MM-dd")">
                                @date.ToString("dd MMM yyyy")
                            </time>
                        }
                        else
                        {
                            <span class="card-mosaic__date">Publicación</span>
                        }
                        <span class="card-mosaic__cta" aria-hidden="true">
                            <span>Leer</span>
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="5" y1="12" x2="19" y2="12"></line>
                                <polyline points="12 5 19 12 12 19"></polyline>
                            </svg>
                        </span>
                    </footer>
                </div>
            </div>
        </article>
    </li>
}
