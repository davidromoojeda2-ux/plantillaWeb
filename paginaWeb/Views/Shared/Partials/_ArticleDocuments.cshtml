@model IReadOnlyList<DocumentResponseDto>

@if (Model.Count > 0)
{
    <section class="article-documents" aria-labelledby="articleDocumentsTitle">
        <div class="article-documents-header">
            <span class="article-documents-kicker">Recursos</span>
            <h2 id="articleDocumentsTitle">Documentos adjuntos</h2>
            <p>Descarga los archivos relacionados con esta publicación.</p>
        </div>

        <div class="article-documents-list">
            @foreach (var document in Model)
            {
                var extensionLabel = document.Extension.TrimStart('.').ToUpperInvariant();
                var iconClass = document.Extension.ToLowerInvariant() switch
                {
                    ".pdf" => "article-document-icon--pdf",
                    ".doc" or ".docx" or ".odt" or ".rtf" => "article-document-icon--doc",
                    ".xls" or ".xlsx" or ".ods" or ".csv" => "article-document-icon--sheet",
                    ".ppt" or ".pptx" or ".odp" => "article-document-icon--slides",
                    _ => "article-document-icon--default"
                };

                <a class="article-document"
                   asp-controller="Descargas"
                   asp-action="Download"
                   asp-route-id="@document.Id"
                   aria-label="Descargar @document.DisplayName (@extensionLabel)">
                    <span class="article-document-icon @iconClass" aria-hidden="true">@extensionLabel</span>
                    <span class="article-document-copy">
                        <span class="article-document-name">@document.DisplayName</span>
                        @if (!string.IsNullOrWhiteSpace(document.Description))
                        {
                            <span class="article-document-description">@document.Description</span>
                        }
                        <span class="article-document-meta">@extensionLabel · @DocumentMapper.FormatSize(document.SizeBytes)</span>
                    </span>
                    <span class="article-document-action" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                        </svg>
                        <span>Descargar</span>
                    </span>
                </a>
            }
        </div>
    </section>
}
