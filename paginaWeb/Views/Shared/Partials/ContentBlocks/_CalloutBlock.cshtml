@model ContentCalloutBlockDto
@inject Aplication.Interfaces.IHtmlSanitizer HtmlSanitizer
@{
    // Icono por variante (trazos estilo Heroicons, 24x24).
    var iconPath = Model.Variant?.ToLowerInvariant() switch
    {
        "tip" => "M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z",
        "warning" => "M12 9v4m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z",
        "success" => "M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z",
        _ => "M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
    };
}

<div class="@ContentBlockViewHelpers.CalloutClass(Model.Variant)" data-callout="@Model.Variant">
    <span class="callout-icon" aria-hidden="true">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="@iconPath" />
        </svg>
    </span>
    <div class="callout-body">
        @if (!string.IsNullOrWhiteSpace(Model.Title))
        {
            <strong class="callout-title">@Model.Title</strong>
        }
        @Html.Raw(HtmlSanitizer.Sanitize(Model.Text))
    </div>
</div>
