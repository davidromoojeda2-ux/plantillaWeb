@using paginaWeb.Models
@model ArticleCardViewModel
@{
    var art = Model.Article;
    var imgUrl = !string.IsNullOrWhiteSpace(Model.ImageUrl) ? Model.ImageUrl : art.CoverImageUrl;
    var cat = !string.IsNullOrWhiteSpace(Model.CategoryName) ? Model.CategoryName : "Actualidad";
}

<article
    class="bg-white rounded-3xl border border-slate-200/80 shadow-xs overflow-hidden flex flex-col justify-between hover:-translate-y-1 hover:shadow-lg transition-all duration-300 group">
    <div>
        <!-- Imagen de Tarjeta -->
        <div class="aspect-[16/10] overflow-hidden bg-slate-100 relative">
            @if (!string.IsNullOrEmpty(imgUrl))
            {
                <img src="@imgUrl" alt="@art.Title" loading="lazy"
                     class="w-full h-full object-cover group-hover:scale-105 transition duration-500" />
            }
            else
            {
                <div
                    class="w-full h-full flex items-center justify-center bg-gradient-to-br from-slate-100 to-slate-200 text-slate-400">
                    <svg class="w-12 h-12 opacity-40" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                              d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
                    </svg>
                </div>
            }
            <span
                class="absolute top-4 left-4 bg-white/95 backndrop-blur-md text-[#003F88] font-bold text-[10px] uppercase tracking-wider px-3 py-1 rounded-full shadow-xs">
                @cat
            </span>
        </div>

        <div class="p-6 space-y-3">
            <h4
                class="font-serif font-black text-xl text-slate-900 group-hover:text-[#00509D] transition line-clamp-2 leading-snug">
                <a asp-controller="Home" asp-action="Articulo" asp-route-slug="@art.Slug">@art.Title</a>
            </h4>
            <p class="text-xs text-slate-600 line-clamp-3 leading-relaxed">@art.Summary</p>
        </div>
    </div>

    <div class="px-6 pb-6 pt-3 border-t border-slate-100 flex items-center justify-between text-xs text-slate-400">
        <span class="font-medium text-slate-600">@art.Author</span>
        <div class="flex items-center gap-2">
            <span>@art.ReadingTimeMinutes min</span>
            <span>•</span>
            <span>@art.PublishedAt?.ToString("dd MMM")</span>
        </div>
    </div>
</article>
