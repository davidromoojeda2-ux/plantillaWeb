@model IReadOnlyList<FeatureCardViewModel>

@if (Model != null && Model.Count > 0)
{
    var totalSlides = Model.Count;
    <div class="hero-dynamic" id="hero-showcase" data-hero-slider aria-roledescription="carrusel" aria-label="Noticias y reportajes destacados">
        <!-- Barra de estado y controles superiores del Hero -->
        <div class="hero-dynamic__header">
            <div class="hero-dynamic__badge">
                <span class="hero-dynamic__badge-dot" aria-hidden="true"></span>
                <span class="hero-dynamic__badge-text">EN PORTADA</span>
                <span class="hero-dynamic__badge-sep" aria-hidden="true">·</span>
                <span class="hero-dynamic__badge-sub">COBERTURA ESPECIAL</span>
            </div>

            @if (totalSlides > 1)
            {
                <div class="hero-dynamic__controls" aria-label="Controles del carrusel">
                    <!-- Contador de diapositivas -->
                    <div class="hero-dynamic__counter" aria-live="polite" aria-atomic="true">
                        <span class="hero-dynamic__counter-curr" data-slide-current>01</span>
                        <span class="hero-dynamic__counter-slash">/</span>
                        <span class="hero-dynamic__counter-total">@totalSlides.ToString("D2")</span>
                    </div>

                    <!-- Botón Reproducir / Pausar -->
                    <button type="button" class="hero-dynamic__btn hero-dynamic__btn--playpause" data-action="toggle-play"
                            aria-label="Pausar rotación automática" title="Pausar rotación automática">
                        <svg class="icon-pause" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                            <path d="M6 4h4v16H6V4zm8 0h4v16h-4V4z"/>
                        </svg>
                        <svg class="icon-play" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" style="display:none;">
                            <path d="M8 5v14l11-7z"/>
                        </svg>
                    </button>

                    <!-- Botón Anterior -->
                    <button type="button" class="hero-dynamic__btn" data-action="prev"
                            aria-label="Historia anterior" title="Historia anterior">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <polyline points="15 18 9 12 15 6"></polyline>
                        </svg>
                    </button>

                    <!-- Botón Siguiente -->
                    <button type="button" class="hero-dynamic__btn" data-action="next"
                            aria-label="Historia siguiente" title="Historia siguiente">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <polyline points="9 18 15 12 9 6"></polyline>
                        </svg>
                    </button>
                </div>
            }
        </div>

        <!-- Visor / Contenedor principal de diapositivas -->
        <div class="hero-dynamic__stage">
            <div class="hero-dynamic__track" data-slider-track>
                @for (var i = 0; i < totalSlides; i++)
                {
                    var item = Model[i];
                    var isActive = i == 0;
                    <article class="hero-dynamic__slide @(isActive ? "is-active" : "")"
                             data-slide-index="@i"
                             id="hero-slide-@i"
                             role="group"
                             aria-roledescription="diapositiva"
                             aria-label="@(i + 1) de @totalSlides: @item.Title"
                             aria-hidden="@(isActive ? "false" : "true")">

                        <!-- Fondo con Imagen y Efecto Gradiente Cinemático -->
                        <div class="hero-dynamic__media">
                            @if (item.Image.HasUrl)
                            {
                                <img class="hero-dynamic__img"
                                     src="@item.Image.Url"
                                     alt="@item.Image.Alt"
                                     loading="@(i == 0 ? "eager" : "lazy")"
                                     decoding="async" />
                            }
                            else
                            {
                                <div class="hero-dynamic__media-fallback" aria-hidden="true">
                                    <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
                                    </svg>
                                </div>
                            }
                            <div class="hero-dynamic__scrim" aria-hidden="true"></div>
                        </div>

                        <!-- Contenido Editorial de la Noticia -->
                        <div class="hero-dynamic__content">
                            <div class="hero-dynamic__meta-top">
                                <span class="hero-dynamic__category">@item.Category</span>
                                @if (item.PublishedAt.HasValue)
                                {
                                    <span class="hero-dynamic__date">
                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                                            <line x1="16" y1="2" x2="16" y2="6"></line>
                                            <line x1="8" y1="2" x2="8" y2="6"></line>
                                            <line x1="3" y1="10" x2="21" y2="10"></line>
                                        </svg>
                                        <time datetime="@item.PublishedAt.Value.ToString("yyyy-MM-dd")">
                                            @item.PublishedAt.Value.ToString("dd MMM yyyy")
                                        </time>
                                    </span>
                                }
                                <span class="hero-dynamic__reading">
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <circle cx="12" cy="12" r="10"></circle>
                                        <polyline points="12 6 12 12 16 14"></polyline>
                                    </svg>
                                    @item.ReadingMinutes min de lectura
                                </span>
                            </div>

                            <h2 class="hero-dynamic__title">
                                <a href="@item.Href" class="hero-dynamic__title-link">@item.Title</a>
                            </h2>

                            @if (!string.IsNullOrWhiteSpace(item.Text))
                            {
                                <p class="hero-dynamic__summary">@item.Text</p>
                            }

                            <div class="hero-dynamic__actions">
                                <a href="@item.Href" class="hero-dynamic__cta">
                                    <span>Leer artículo completo</span>
                                    <svg class="hero-dynamic__cta-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <line x1="5" y1="12" x2="19" y2="12"></line>
                                        <polyline points="12 5 19 12 12 19"></polyline>
                                    </svg>
                                </a>
                                @if (!string.IsNullOrWhiteSpace(item.Author))
                                {
                                    <span class="hero-dynamic__author">
                                        Por <strong>@item.Author</strong>
                                    </span>
                                }
                            </div>
                        </div>
                    </article>
                }
            </div>

            <!-- Barra de progreso de temporizador (Autoplay) -->
            @if (totalSlides > 1)
            {
                <div class="hero-dynamic__timer-track" aria-hidden="true">
                    <div class="hero-dynamic__timer-bar" data-timer-bar></div>
                </div>
            }
        </div>

        <!-- Selector interactivo de pestañas / historias (Tabs Bento en escritorio y tablet) -->
        @if (totalSlides > 1)
        {
            <div class="hero-dynamic__tabs" role="tablist" aria-label="Historias en portada">
                @for (var j = 0; j < totalSlides; j++)
                {
                    var tabItem = Model[j];
                    var isTabActive = j == 0;
                    <button type="button"
                            class="hero-dynamic__tab @(isTabActive ? "is-active" : "")"
                            role="tab"
                            data-tab-index="@j"
                            id="hero-tab-@j"
                            aria-selected="@(isTabActive ? "true" : "false")"
                            aria-controls="hero-slide-@j"
                            tabindex="@(isTabActive ? "0" : "-1")">
                        <span class="hero-dynamic__tab-index">0@(j + 1)</span>
                        <div class="hero-dynamic__tab-text">
                            <span class="hero-dynamic__tab-cat">@tabItem.Category</span>
                            <span class="hero-dynamic__tab-title">@tabItem.Title</span>
                        </div>
                        <span class="hero-dynamic__tab-line" aria-hidden="true"></span>
                    </button>
                }
            </div>
        }
    </div>
}
