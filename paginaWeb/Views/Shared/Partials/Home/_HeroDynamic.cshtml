@model IReadOnlyList<FeatureCardViewModel>

@if (Model != null && Model.Count > 0)
{
    var totalSlides = Model.Count;
    <div class="hero-dynamic" id="hero-showcase" data-hero-slider aria-roledescription="carrusel"
         aria-label="Noticias y reportajes destacados">
        <!-- Visor / Contenedor principal de diapositivas -->
        <div class="hero-dynamic__stage">
            <div class="hero-dynamic__track" data-slider-track>
                @for (var i = 0; i < totalSlides; i++)
                {
                    var item = Model[i];
                    var isActive = i == 0;
                    <article class="hero-dynamic__slide @(isActive ? "is-active" : "")" data-slide-index="@i" id="hero-slide-@i"
                             role="group" aria-roledescription="diapositiva" aria-label="@(i + 1) de @totalSlides: @item.Title"
                             aria-hidden="@(isActive ? "false" : "true")">

                        <!-- Fondo con Imagen y Efecto Gradiente Cinemático -->
                        <div class="hero-dynamic__media">
                            @if (item.Image.HasUrl)
                            {
                                <img class="hero-dynamic__img" src="@item.Image.Url" alt="@item.Image.Alt"
                                     loading="@(i == 0 ? "eager" : "lazy")" decoding="async" />
                            }
                            else
                            {
                                <!-- Fallback (fondo por defecto) con Icono -->
                                <div class="hero-dynamic__media-fallback" aria-hidden="true">
                                    <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                         stroke-width="1.2">
                                        <path stroke-linecap="round" stroke-linejoin="round"
                                              d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
                                    </svg>
                                </div>
                            }
                            <div class="hero-dynamic__scrim" aria-hidden="true"></div>
                        </div>

                        <!-- Contenido Editorial de la Noticia -->
                        <div class="hero-dynamic__content">
                            <div class="hero-dynamic__meta-top">
                                <span class="hero-dynamic__category">@item.Category</span>
                                @if (item.PublishedAt.HasValue)
                                {
                                    <span class="hero-dynamic__date">
                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                             stroke-width="2">
                                            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                                            <line x1="16" y1="2" x2="16" y2="6"></line>
                                            <line x1="8" y1="2" x2="8" y2="6"></line>
                                            <line x1="3" y1="10" x2="21" y2="10"></line>
                                        </svg>
                                        <time datetime="@item.PublishedAt.Value.ToString("yyyy-MM-dd")">
                                            @item.PublishedAt.Value.ToString("dd MMM yyyy")
                                        </time>
                                    </span>
                                }
                                <span class="hero-dynamic__reading">
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                         stroke-width="2">
                                        <circle cx="12" cy="12" r="10"></circle>
                                        <polyline points="12 6 12 12 16 14"></polyline>
                                    </svg>
                                    @item.ReadingMinutes min de lectura
                                </span>
                            </div>

                            <h2 class="hero-dynamic__title">
                                <a href="@item.Href" class="hero-dynamic__title-link">@item.Title</a>
                            </h2>

                            @if (!string.IsNullOrWhiteSpace(item.Text))
                            {
                                <p class="hero-dynamic__summary">@item.Text</p>
                            }

                            <div class="hero-dynamic__actions">
                                <a href="@item.Href" class="hero-dynamic__cta">
                                    <span>Leer artículo completo</span>
                                    <svg class="hero-dynamic__cta-icon" width="16" height="16" viewBox="0 0 24 24" fill="none"
                                         stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"
                                         aria-hidden="true">
                                        <line x1="5" y1="12" x2="19" y2="12"></line>
                                        <polyline points="12 5 19 12 12 19"></polyline>
                                    </svg>
                                </a>
                                @if (!string.IsNullOrWhiteSpace(item.Author))
                                {
                                    <span class="hero-dynamic__author">
                                        Por <strong>@item.Author</strong>
                                    </span>
                                }
                            </div>
                        </div>
                    </article>
                }
            </div>

            <!-- Barra de progreso de temporizador (Autoplay) -->
            @if (totalSlides > 1)
            {
                <div class="hero-dynamic__timer-track" aria-hidden="true">
                    <div class="hero-dynamic__timer-bar" data-timer-bar></div>
                </div>
            }
        </div>

    </div>
}
