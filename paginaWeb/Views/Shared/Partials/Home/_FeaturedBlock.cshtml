@model FeaturedBlockViewModel

<article class="card card--featured">
    <div class="card-media">
        @if (Model.Image.HasUrl)
        {
            <img class="card-media__img"
                 src="@Model.Image.Url"
                 alt="@Model.Image.Alt"
                 width="@Model.Image.Width"
                 height="@Model.Image.Height"
                 loading="lazy"
                 decoding="async" />
        }
        else
        {
            <div class="card-media__fallback" role="img" aria-label="@Model.Image.Alt">
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
                </svg>
            </div>
        }
    </div>
    <div class="card__body">
        <span class="card__eyebrow">@Model.Category</span>
        <h3 class="card__title">
            <a class="card__link" href="@Model.Href">@Model.Title</a>
        </h3>
        <p class="card__text">@Model.Excerpt</p>
        <div class="card__footer">
            <span class="card__byline">
                @Model.Author
                @if (Model.ReadingMinutes > 0)
                {
                    <span aria-hidden="true"> · </span>
                    <span>@Model.ReadingMinutes min de lectura</span>
                }
            </span>
            <a class="btn btn--primary card__cta" href="@Model.Href" tabindex="-1" aria-hidden="true">Leer</a>
        </div>
    </div>
</article>
