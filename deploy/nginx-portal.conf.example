# ==============================================================================
# Configuración Nginx como Reverse Proxy para ASP.NET Core en Ubuntu VPS
# Guardar en: /etc/nginx/sites-available/portal-noticias
# Habilitar con: sudo ln -s /etc/nginx/sites-available/portal-noticias /etc/nginx/sites-enabled/
# ==============================================================================

server {
    listen 80;
    server_name tudominio.com www.tudominio.com; # Reemplazar con tu dominio o IP

    # Límite máximo para subida de imágenes
    client_max_body_size 50M;

    location / {
        proxy_pass         http://127.0.0.1:5000;
        proxy_http_version 1.1;
        proxy_set_header   Upgrade $http_upgrade;
        proxy_set_header   Connection keep-alive;
        proxy_set_header   Host $host;
        proxy_cache_bypass $http_upgrade;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_buffering    off;
        proxy_read_timeout 100s;
    }
}
